translate schinese ep2_math_label_dd43d4b0:

    # mc "...but I think it's the first time I've seen you in a t-shirt."
    mc "……不过我想这是我第一次看你穿 T 恤。"

# game/update2.rpy:6174
translate schinese ep2_math_label_3b12370c:

    # de "It's for gender class...Jade asked me to wear clothes last time."
    de "这是为了性别研究课……Jade 上次让我穿衣服。"

# game/update2.rpy:6176
translate schinese ep2_math_label_b897b358:

    # mc "Ah yeah! Let's chat later, I have some stuff to tell you."
    mc "啊，对！晚点再聊，我有些事要告诉你。"

# game/update2.rpy:6179
translate schinese ep2_math_label_7e9eed1b:

    # stu "Hey..."
    stu "嘿……"

# game/update2.rpy:6180
translate schinese ep2_math_label_7c927b78:

    # mc "Yes?"
    mc "什么事？"

