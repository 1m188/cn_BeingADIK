translate schinese ep2_math_label_53d6b215:

    # mc "Bro...are you ok?"
    mc "兄弟……你还好吗？"

# game/update2.rpy:6164
translate schinese ep2_math_label_722c02d1:

    # de "Never been better!"
    de "从没这么好过！"

# game/update2.rpy:6166
