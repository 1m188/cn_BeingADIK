    # mc "I'm here for you, if you need to talk."
    mc "如果你需要聊聊，我会在这里。"

# game/update2.rpy:4942
translate schinese ep2_after_gym_label_177d3eb2:

    # mc "What are you doing?"
    mc "你在干什么？"
# game/update2.rpy:4945
translate schinese ep2_after_gym_label_c3f30ddd:

    # sa "Continuing from where we left off at the party."
    sa "接着派对上我们没做完的事。"

# game/update2.rpy:4946
translate schinese ep2_after_gym_label_8f56076b:

    # sa "And you know..."
    sa "你知道的……"

# game/update2.rpy:4947
translate schinese ep2_after_gym_label_06af439b:

    # sa "Scratching your back... Like I promised I would."
    sa "帮你挠背……就像我答应过的。"

# game/update2.rpy:4948
translate schinese ep2_after_gym_label_841f3b36:

    # sa "You don't like it?"
    sa "你不喜欢吗？"

# game/update2.rpy:4956
translate schinese ep2_after_gym_label_5c0563af:

    # mc "Please, stop it."
    mc "请停下。"

# game/update2.rpy:4957
translate schinese ep2_after_gym_label_85460218:

    # mc "I just wanted to help, because you returned my guitar."
    mc "我只是想帮忙，因为你把我的吉他还给我了。"

# game/update2.rpy:4958
translate schinese ep2_after_gym_label_6d8c4f39:

    # mc "I didn't want this."
    mc "我不想要这个。"

# game/update2.rpy:4959
translate schinese ep2_after_gym_label_32f495c2:

    # mc "At least not like this..."
    mc "至少不想以这种方式……"

# game/update2.rpy:4961
translate schinese ep2_after_gym_label_07cd6b38:

    # sa "..."
    sa "……"

# game/update2.rpy:4967
translate schinese ep2_after_gym_label_69180e47:

    # mc "I do like it..."
    mc "我确实喜欢……"

# game/update2.rpy:4970
translate schinese ep2_after_gym_label_80fd16c0:

    # mc "(She has the softest lips...)"
    mc "（她的嘴唇真柔软……）"

# game/update2.rpy:4974
translate schinese ep2_after_gym_label_b52780c4:

    # mc "(That way she runs her fingers through my hair...)"
    mc "（她手指穿过我头发的感觉……）"

# game/update2.rpy:4975
translate schinese ep2_after_gym_label_e6496ed7:

    # mc "(It's both hot and comforting at the same time.)"
    mc "（既性感又让人安心。）"

# game/update2.rpy:4979
translate schinese ep2_after_gym_label_1548024a:

    # mc "This whole thing is over now, right?"
    mc "这一切现在结束了，对吧？"

# game/update2.rpy:4981
translate schinese ep2_after_gym_label_3a99e9a3:

    # sa "No... Not yet."
    sa "不……还没有。"

# game/update2.rpy:4983
translate schinese ep2_after_gym_label_01adb396:

    # mc "Don't tell me..."
    mc "别告诉我……"

# game/update2.rpy:4985
translate schinese ep2_after_gym_label_dd9a9d84:

    # sa "I want to know who the bitch is."
    sa "我想知道那个婊子是谁。"

# game/update2.rpy:4989
translate schinese ep2_after_gym_label_305cea1b:

    # mc "Why don't you just ask him? You have proof of it now."
    mc "你为什么不直接问他？现在你有证据了。"

# game/update2.rpy:4991
translate schinese ep2_after_gym_label_4423fc58:

    # sa "He would never tell me..."
    sa "他绝不会告诉我……"

# game/update2.rpy:4992
translate schinese ep2_after_gym_label_adb9bc38:

    # sa "He would probably just lie and be more careful."
    sa "他大概只会撒谎，然后更加小心。"

# game/update2.rpy:4994
translate schinese ep2_after_gym_label_65fb56c2:

    # mc "I understand how you must be feeling."
    mc "我明白你一定很难受。"

# game/update2.rpy:4995
translate schinese ep2_after_gym_label_07836c9c:

    # mc "But please, just let it go. This isn't healthy."
    mc "但求你了，放下吧。这对你没好处。"

# game/update2.rpy:4998
translate schinese ep2_after_gym_label_b4779028:

    # sa "This isn't over until I find out who that cunt is."
    sa "在我查出那个婊子是谁之前，这事没完。"

# game/update2.rpy:5000
translate schinese ep2_after_gym_label_d165c631:

    # sa "But as for you and me..."
    sa "至于你和我……"

# game/update2.rpy:5001
translate schinese ep2_after_gym_label_9e363ae5:

    # sa "...we're even."
    sa "……我们扯平了。"

# game/update2.rpy:5003
translate schinese ep2_after_gym_label_267ae5e9:

    # mc "Well, that's something..."
    mc "嗯，至少这样……"

# game/update2.rpy:5005
translate schinese ep2_after_gym_label_bfba3614:

    # sa "But I'm begging you..."
    sa "但我求你……"

# game/update2.rpy:5006
translate schinese ep2_after_gym_label_0a751a86:

    # sa "Will you help me find out who it is?"
    sa "你能帮我查出她是谁吗？"

# game/update2.rpy:5011
translate schinese ep2_after_gym_label_dba233e5:

    # mc "I can't believe this..."
    mc "我真不敢相信……"

# game/update2.rpy:5012
translate schinese ep2_after_gym_label_5ca82069:

    # mc "Ok... I'll help you."
    mc "好吧……我帮你。"

# game/update2.rpy:5014
translate schinese ep2_after_gym_label_986f33b9:

    # sa "Thank you."
    sa "谢谢你。"

# game/update2.rpy:5016
translate schinese ep2_after_gym_label_73a54aa7:

    # mc "...but I'm only doing it so you can move on, ok?"
    mc "……但我这么做只是为了让你能放下，好吗？"

# game/update2.rpy:5022
translate schinese ep2_after_gym_label_6cbb3e21:

    # mc "Not gonna happen."
    mc "不会的。"

# game/update2.rpy:5023
translate schinese ep2_after_gym_label_a0c8b655:

    # mc "I did my part. I'm out."
    mc "我已经尽力了。我退出。"

# game/update2.rpy:5024
translate schinese ep2_after_gym_label_4df48b12:

    # mc "I hope you can manage to move on, Sage."
    mc "希望你能想办法继续生活，Sage。"

# game/update2.rpy:5029
translate schinese ep2_after_gym_label_2918ca99:

    # sa "Move on!?"
    sa "继续生活！？"

# game/update2.rpy:5030
translate schinese ep2_after_gym_label_e1462353:

    # sa "Pff!"
    sa "啧！"

# game/update2.rpy:5032
translate schinese ep2_after_gym_label_ff0f1aa3:

    # mc "Look..."
    mc "听着……"

# game/update2.rpy:5033
translate schinese ep2_after_gym_label_8d0d3aba:

    # mc "He made his choice already."
    mc "他已经做出选择了。"

# game/update2.rpy:5034
translate schinese ep2_after_gym_label_6985a317:

    # mc "Just accept that."
    mc "接受这个事实吧。"

# game/update2.rpy:5035
translate schinese ep2_after_gym_label_07cd6b38_1:

    # sa "..."
    sa "……"

# game/update2.rpy:5036
translate schinese ep2_after_gym_label_8f205919:

    # mc "I can see that you're still angry..."
    mc "我看得出来你还在生气……"

# game/update2.rpy:5039
translate schinese ep2_after_gym_label_a15d334c:

    # mc "Hey..."
    mc "嘿……"
# game/update2.rpy:5040
translate schinese ep2_after_gym_label_cff1af77:

    # mc "I have a surefire way to help with that."
    mc "我有个肯定能帮你消气的办法。"

# game/update2.rpy:5045
translate schinese ep2_sage_fight_label_60cf3d7a:

    # sa "Aargh!!!"
    sa "啊啊啊！！！"

# game/update2.rpy:5048
translate schinese ep2_sage_fight_label_fa181ebc:

    # sa "Hngh!!!"
    sa "嗯啊！！！"

# game/update2.rpy:5051
translate schinese ep2_sage_fight_label_0688c279:

    # sa "GAH!!!"
    sa "啊！！！"

# game/update2.rpy:5053
translate schinese ep2_sage_fight_label_871b714b:

    # sa "Hahaha!"
    sa "哈哈哈！"
# game/update2.rpy:5054
translate schinese ep2_sage_fight_label_7b10a389:

    # mc "Feels good, huh?"
    mc "感觉不错，对吧？"

# game/update2.rpy:5056
translate schinese ep2_sage_fight_label_77175094:

    # sa "It feels fantastic!"
    sa "感觉棒极了！"

# game/update2.rpy:5057
translate schinese ep2_sage_fight_label_4604de54:

    # sa "I never knew training like this was so effective!"
    sa "我从没想到这样的训练会这么有效！"

# game/update2.rpy:5058
translate schinese ep2_sage_fight_label_b03e23a6:

    # sa "You're really good at this!"
    sa "你真擅长这个！"

# game/update2.rpy:5060
translate schinese ep2_sage_fight_label_a06fdd69:

    # mc "Thank you. I practiced a lot with my dad, growing up."
    mc "谢谢。我从小就和爸爸练了很多。"

# game/update2.rpy:5062
translate schinese ep2_sage_fight_label_ee0e0d0f:

    # sa "Not enough to beat the jocks, though."
    sa "不过还不足以打败那些体育生。"

# game/update2.rpy:5064
translate schinese ep2_sage_fight_label_fca6d38e:

    # mc "It's not like I'm superhuman. There were too many of them."
    mc "我又不是超人。他们人太多了。"

# game/update2.rpy:5065
translate schinese ep2_sage_fight_label_77cbc7ba:

    # mc "Besides, I don't practice fighting to use it against people."
    mc "再说，我练格斗也不是为了拿来对付别人。"

# game/update2.rpy:5066
translate schinese ep2_sage_fight_label_316389d5:

    # mc "It's just for being able to defend myself or others."
    mc "只是为了能保护自己或其他人。"

# game/update2.rpy:5068
translate schinese ep2_sage_fight_label_4e161e13:

    # sa "You mean like it's a code?"
    sa "你的意思是，这就像一种准则？"

# game/update2.rpy:5070
translate schinese ep2_sage_fight_label_e4be473b:

    # mc "Yeah, exactly. Like a code."
    mc "对，完全正确。就像一种准则。"

# game/update2.rpy:5072
translate schinese ep2_sage_fight_label_3e23da21:

    # mc "(But I kinda broke it today...)"
    mc "（但我今天算是违反它了……）"

# game/update2.rpy:5074
translate schinese ep2_sage_fight_label_d86aee9d:

    # sa "I can understand that. Frats and sororities have codes, too."
    sa "我能理解。兄弟会和姐妹会也都有自己的准则。"

# game/update2.rpy:5076
translate schinese ep2_sage_fight_label_d2e3c3d7:

    # mc "So, what's the HOTs' code?"
    mc "那么 HOT 的准则是什么？"

# game/update2.rpy:5078
translate schinese ep2_sage_fight_label_f7f8b622:

    # sa "All HOTs are sisters. We don't turn against each other."
    sa "所有 HOT 都是姐妹。我们不会互相背叛。"

# game/update2.rpy:5080
translate schinese ep2_sage_fight_label_1f03d046:

    # mc "The way Quinn treats your pledgers doesn't seem like sisterhood to me."
    mc "但 Quinn 对待你们预备会员的方式，在我看来可不像姐妹。"

# game/update2.rpy:5082
translate schinese ep2_sage_fight_label_81e34c69:

    # sa "Oh, come on! It's just a bit of hazing."
    sa "拜托！只是稍微进行一下入会整蛊。"

# game/update2.rpy:5083
translate schinese ep2_sage_fight_label_f2a886a1:

    # sa "It's no different from what the DIKs put you through."
    sa "和 DIK 对你做的事没什么不同。"

# game/update2.rpy:5085
translate schinese ep2_sage_fight_label_393e29da:

    # sa "I mean, you don't have to like it..."
    sa "我是说，你不必喜欢它……"

# game/update2.rpy:5086
translate schinese ep2_sage_fight_label_3b64c1e7:

    # sa "... but it's a one-time thing you endure before you're one of the gang."
    sa "……但在成为团体一员之前，这是必须经历一次的事。"

# game/update2.rpy:5087
translate schinese ep2_sage_fight_label_544afb9a:

    # sa "If you don't get that, you will never become a DIK."
    sa "如果你连这个都不明白，就永远成不了 DIK。"

# game/update2.rpy:5089
translate schinese ep2_sage_fight_label_a7bcf340:

    # mc "I see..."
    mc "我明白了……"
# game/update2.rpy:5091
translate schinese ep2_sage_fight_label_b24dc417:

    # sa "Either way, that's the HOTs' public code. \"Don't turn on each other.\""
    sa "不管怎样，这就是 HOT 的公开准则。 \\\"不要互相背叛。\\\""

# game/update2.rpy:5093
translate schinese ep2_sage_fight_label_bce35a52:

    # mc "Public code? Do you mean you have a secret code, too?"
    mc "公开准则？你的意思是你们还有秘密准则？"

# game/update2.rpy:5095
translate schinese ep2_sage_fight_label_f51e0bb6:

    # sa "Maybe."
    sa "也许吧。"

# game/update2.rpy:5097
translate schinese ep2_sage_fight_label_def0ad19:

    # mc "What is it?"
    mc "什么事？"
# game/update2.rpy:5099
translate schinese ep2_sage_fight_label_152dfdeb:

    # sa "Would it be a secret code if I told you?"
    sa "要是我告诉你了，还算秘密准则吗？"

# game/update2.rpy:5101
translate schinese ep2_sage_fight_label_d52e55f7:

    # sa "The DIKs have codes, too. But you probably knew that already."
    sa "DIK 也有准则。不过你大概早就知道了。"

# game/update2.rpy:5103
translate schinese ep2_sage_fight_label_1fc018bc:

    # mc "Yeah. \"Family comes first\"."
    mc "对。 \\\"家庭第一\\\"。"

# game/update2.rpy:5105
translate schinese ep2_sage_fight_label_746398ef:

    # sa "Exactly."
    sa "没错。"

# game/update2.rpy:5106
translate schinese ep2_sage_fight_label_82d62e54:

    # sa "If you are a DIK, you're a brother. And, much like the HOTs, brothers never let their siblings down."
    sa "如果你是 DIK，你就是兄弟。和 HOT 很像，兄弟绝不会让自己的手足失望。"

# game/update2.rpy:5108
translate schinese ep2_sage_fight_label_84924bae:

    # mc "It's a nice code. I never had any siblings to care for."
    mc "这是个不错的准则。我从没兄弟姐妹需要照顾。"

# game/update2.rpy:5109
translate schinese ep2_sage_fight_label_1b351a54:

    # mc "Although...from what I've seen so far, that's not the impression I've gotten from the DIKs."
    mc "不过……从我目前看到的情况来看，DIK 给我的印象可不是这样。"

# game/update2.rpy:5110
translate schinese ep2_sage_fight_label_4a4b4803:

    # mc "Everything is pretty mean-spirited."
    mc "一切都充满恶意。"

# game/update2.rpy:5112
translate schinese ep2_sage_fight_label_ea68df10:

    # sa "There's a lot of things that you don't see until you start looking for them."
    sa "很多事只有在你开始寻找时，才会注意到。"

# game/update2.rpy:5113
translate schinese ep2_sage_fight_label_8a340642:

    # mc "What does that mean?"
    mc "这话什么意思？"

# game/update2.rpy:5114
translate schinese ep2_sage_fight_label_9bdf592a:

    # sa "Nothing..."
    sa "什么都没……"

# game/update2.rpy:5116
translate schinese ep2_sage_fight_label_742cba19:

    # mc "Hey...before I forget..."
    mc "嘿……在我忘记之前……"

# game/update2.rpy:5117
translate schinese ep2_sage_fight_label_80964dd2:

    # mc "Thank you for returning my guitar. You did the right thing."
    mc "谢谢你把吉他还给我。你做对了。"

# game/update2.rpy:5119
translate schinese ep2_sage_fight_label_90ed6bb7:

    # sa "Do you play a lot?"
    sa "你经常弹吗？"

# game/update2.rpy:5121
translate schinese ep2_sage_fight_label_36a08078:

    # mc "Yes, almost daily."
    mc "对，几乎每天。"

# game/update2.rpy:5123
translate schinese ep2_sage_fight_label_dc19e0bf:

    # sa "I always wanted to learn how to play the guitar."
    sa "我一直想学弹吉他。"

# game/update2.rpy:5124
translate schinese ep2_sage_fight_label_87a7653f:

    # sa "I never took the initiative..."
    sa "我从没真正开始……"

# game/update2.rpy:5126
translate schinese ep2_sage_fight_label_56a6a3b3:

    # sa "Chad knew that... That's why he gave it to me."
    sa "Chad 知道这一点……所以才把它给我。"

# game/update2.rpy:5132
translate schinese ep2_sage_fight_label_8c3b0f90:

    # mc "It may sound nice of him to give you a gift like that, but it was my guitar that he had stolen."
    mc "他送你这样的礼物听起来是挺好心，但那是他偷走的我的吉他。"

# game/update2.rpy:5134
translate schinese ep2_sage_fight_label_6379fb93:

    # mc "I think you meant to say that he stole it and unloaded it on you."
    mc "我想你应该说，他偷了吉他，然后把它甩给了你。"

# game/update2.rpy:5135
translate schinese ep2_sage_fight_label_07cd6b38:

    # sa "..."
    sa "……"

# game/update2.rpy:5138
translate schinese ep2_sage_fight_label_05fb9591:

    # mc "What stopped you from starting to learn?"
    mc "是什么让你一直没开始学？"

# game/update2.rpy:5140
translate schinese ep2_sage_fight_label_38ba8df3:

    # sa "You know...excuses. Procrastination."
    sa "你知道的……借口，拖延。"

# game/update2.rpy:5141
translate schinese ep2_sage_fight_label_ed12e71a:

    # sa "Certain family members that thought I should be playing something fancier than a guitar."
    sa "有些家人觉得我应该学比吉他更高级的乐器。"

# game/update2.rpy:5143
translate schinese ep2_sage_fight_label_d2b2d7c3:

    # mc "Fancier?"
    mc "更高级？"

# game/update2.rpy:5145
translate schinese ep2_sage_fight_label_d53c9804:

    # sa "Meh...fuck it."
    sa "算了……去他的。"

# game/update2.rpy:5146
translate schinese ep2_sage_fight_label_e3b51eaa:

    # sa "Would you teach me how to play it?"
    sa "你愿意教我弹吗？"

# game/update2.rpy:5151
translate schinese ep2_sage_fight_label_dfe81e78:

    # mc "So, you want me to be your {i}teacher{/i}?"
    mc "所以，你想让我当你的{i}老师{/i}？"

# game/update2.rpy:5153
translate schinese ep2_sage_fight_label_de2746a7:

    # sa "Haha, not in a naughty way."
    sa "哈哈，不是那种调皮的方式。"

# game/update2.rpy:5155
translate schinese ep2_sage_fight_label_e91a80b7:

    # mc "So, you want me to be your teacher?"
    mc "所以，你想让我当你的老师？"

# game/update2.rpy:5157
translate schinese ep2_sage_fight_label_f8222122:

    # sa "Yeah, if you want to."
    sa "对，如果你愿意。"

# game/update2.rpy:5163
translate schinese ep2_sage_fight_label_606e2d02:

    # mc "Sure."
    mc "当然。"

# game/update2.rpy:5165
translate schinese ep2_sage_fight_label_fa37970c:

    # sa "Really? For real?"
    sa "真的？你认真的？"

# game/update2.rpy:5167
translate schinese ep2_sage_fight_label_657b3ad1:

    # mc "It sounds like fun."
    mc "听起来挺有趣。"

# game/update2.rpy:5169
translate schinese ep2_sage_fight_label_83c1acdb:

    # sa "Great...then let's set something up."
    sa "太好了……那我们安排一下。"

# game/update2.rpy:5175
translate schinese ep2_sage_fight_label_5bc96f43:

    # mc "Sorry, but I have to say no."
    mc "抱歉，但我得拒绝。"

# game/update2.rpy:5177
translate schinese ep2_sage_fight_label_91f38963:

    # sa "Ok, that's cool."
    sa "好吧，没问题。"

# game/update2.rpy:5183
translate schinese ep2_sage_fight_label_ade593db:

    # sa "Thank you for the training session. It was fun and I needed it."
    sa "谢谢你的训练课。很有趣，而且我正需要它。"

# game/update2.rpy:5185
translate schinese ep2_sage_fight_label_ece17cc2:

    # mc "Anytime, Sage."
    mc "随时奉陪，Sage。"

# game/update2.rpy:5186
translate schinese ep2_sage_fight_label_15cbeade:

    # mc "I hope that you've cooled down."
    mc "希望你已经冷静下来了。"

# game/update2.rpy:5189
translate schinese ep2_sage_fight_label_3fe73025:

    # sa "Time to hit the showers. See you later!"
