translate schinese ep2_math_label_6585912f:

    # de "Oh, I don't get those."
    de "哦，我不会宿醉。"

# game/update2.rpy:6169
translate schinese ep2_math_label_81917bd3:

    # de "I've never had one."
    de "我从没宿醉过。"

# game/update2.rpy:6171
translate schinese ep2_math_label_3c57c37e:

    # mc "All right, good to see that you're ok."
    mc "好吧，很高兴看到你没事。"

