    mc "哦，对。我好像忘了……"

# game/update2.rpy:6137
translate schinese ep2_bella_morning_label_e389101a_1:

    # isa "Take care now."
    isa "保重。"

# game/update2.rpy:6142
translate schinese ep2_math_label_ce5df5d8:

