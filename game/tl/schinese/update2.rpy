    mc "（我记得是什么甜言蜜语或调情的话……）"

# game/update2.rpy:6155
translate schinese ep2_math_label_f49fff8f:

    # mc "Yeah?"
    mc "嗯？"

# game/update2.rpy:6157
translate schinese ep2_math_label_c7a5c207:

    # my "What does this mean?"
    my "这是什么意思？"

# game/update2.rpy:6159
translate schinese ep2_math_label_2b35b6fe:

    # mc "..."
    mc "……"

# game/update2.rpy:6160
translate schinese ep2_math_label_30b33f85:

    # mc "Hey, gimme a second I need to check up on Derek..."
    mc "嘿，等我一下，我得看看 Derek 怎么样了……"

