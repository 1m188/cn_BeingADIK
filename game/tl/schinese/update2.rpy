translate schinese ep2_bella_morning_label_5a125741:

    # mc "Haha! Thanks!"
    mc "哈哈！谢了！"

# game/update2.rpy:6106
translate schinese ep2_bella_morning_label_3878ff56:

    # mc "It's just a fuck off class for easy credits."
    mc "只是门用来混轻松学分的逃课。"

# game/update2.rpy:6108
translate schinese ep2_bella_morning_label_56634c4d:

