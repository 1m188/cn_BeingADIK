    mc "顺便问一下，我们现在在哪里？"

# game/update2.rpy:6038
translate schinese ep2_bella_morning_label_04eddbe8:

    # isa "In my house."
    isa "在我家。"

# game/update2.rpy:6040
translate schinese ep2_bella_morning_label_99a8247a:

    # mc "Yeah, well, duh. I meant, where do you live?"
    mc "对，这还用说。我是问你住在哪里？"

# game/update2.rpy:6042
translate schinese ep2_bella_morning_label_c9038dde:

    # isa "About 15 minutes by car from campus."
    isa "开车离校园大约十五分钟。"

# game/update2.rpy:6046
translate schinese ep2_bella_morning_label_c3b5e0d0:

    # mc "Would you mind giving me a ride back?"
    mc "你介意送我回去吗？"

# game/update2.rpy:6048
translate schinese ep2_bella_morning_label_85d421e5:

    # isa "Did your legs not regain their function to walk this morning?"
    isa "你今天早上腿还没恢复走路功能吗？"

# game/update2.rpy:6052
translate schinese ep2_bella_morning_label_7426f9d8:

    # mc "Jeez...are we in a mood today?"
    mc "天啊……我们今天心情很差吗？"

# game/update2.rpy:6053
translate schinese ep2_bella_morning_label_fb623a7e:

    # isa "..."
    isa "……"

# game/update2.rpy:6055
translate schinese ep2_bella_morning_label_bc3b1e05:

