    mc "谢谢你的早餐……还有其他一切。"

# game/update2.rpy:6064
translate schinese ep2_bella_morning_label_b61bb371:

    # mc "If you don't mind...I'll grab a shower before I start walking back."
    mc "如果你不介意……我先洗个澡再走回去。"

# game/update2.rpy:6069
translate schinese ep2_bella_morning_label_05500ff6:

    # mc "Huh?"
    mc "啊？"

# game/update2.rpy:6071
translate schinese ep2_bella_morning_label_20eabd84:

    # isa "Get in."
    isa "上车。"

# game/update2.rpy:6074
translate schinese ep2_bella_morning_label_0936c8bc:

    # mc "Thank you, for doing this for me."
    mc "谢谢你送我回去。"

# game/update2.rpy:6076
translate schinese ep2_bella_morning_label_300f0ce6:

    # isa "Don't flatter yourself. I'm going to work."
    isa "别自作多情。我是要去上班。"

# game/update2.rpy:6078
translate schinese ep2_bella_morning_label_ec1dc54c:

    # mc "Another day with the books, huh?"
    mc "又是和书本相伴的一天，对吧？"

# game/update2.rpy:6079
translate schinese ep2_bella_morning_label_fb623a7e_1:

    # isa "..."
    isa "……"

# game/update2.rpy:6080
translate schinese ep2_bella_morning_label_1ab5c011:

