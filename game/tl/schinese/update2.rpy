    isa "嗯嗯……"

# game/update2.rpy:5999
translate schinese ep2_bella_morning_label_98a08615_1:

    # isa "I have another question."
    isa "我还有个问题。"

# game/update2.rpy:6000
translate schinese ep2_bella_morning_label_e27c46f7:

