    # stu "Cathy is still busy helping that student over there..."
    stu "Cathy 还在忙着帮那边那个学生……"

# game/update2.rpy:6183
translate schinese ep2_math_label_e5e9e3a5:

    # stu "I need some help with this math problem. Would you help me?"
    stu "这道数学题我需要帮助。你能帮我吗？"

# game/update2.rpy:6189
translate schinese ep2_math_label_768ae6d7:

    # mc "Sure. Let me see."
    mc "当然。让我看看。"

# game/update2.rpy:6191
translate schinese ep2_math_label_83284064:

    # mc "Ah, there's your problem."
    mc "啊，问题在这里。"

# game/update2.rpy:6192
translate schinese ep2_math_label_77334207:

    # stu "Oh! Is it like that?"
    stu "哦！原来要这样？"

# game/update2.rpy:6193
translate schinese ep2_math_label_25e25ff8:

    # stu "Thank you!"
    stu "谢谢！"

# game/update2.rpy:6194
translate schinese ep2_math_label_6d5f8951:

    # mc "Don't mention it."
    mc "别客气。"

# game/update2.rpy:6199
translate schinese ep2_math_label_7efef2a4:

    # mc "Nope, that's not my problem."
    mc "不，那不是我的问题。"

# game/update2.rpy:6201
translate schinese ep2_math_label_e680b39c:

    # mc "Sorry, but no. I'm not good at explaining math problems."
    mc "抱歉，不行。我不擅长讲解数学题。"

# game/update2.rpy:6204
translate schinese ep2_math_label_09dc5a71:

    # ca "Ok, now I'm free to help you. What do you need?"
    ca "好，现在我有空帮你了。你需要什么？"

# game/update2.rpy:6206
translate schinese ep2_math_label_b44a573b:

    # stu "Oh, I needed help with this problem, but that guy helped me with it already."
    stu "哦，我需要这道题的帮助，但那个人已经帮我解决了。"

# game/update2.rpy:6207
translate schinese ep2_math_label_e7fad269:

    # ca "[name], helped you? That was nice of him. Let me have a look."
    ca "[name] 帮了你？他真好。让我看看。"

# game/update2.rpy:6210
translate schinese ep2_math_label_36bef154:

    # ca "This is a really good solution..."
    ca "这个解法很好……"

# game/update2.rpy:6211
translate schinese ep2_math_label_fada5144:

    # ca "...in fact, it's excellent."
    ca "……事实上，非常出色。"

# game/update2.rpy:6212
translate schinese ep2_math_label_db033eae:

    # ca "He did that, you say?"
    ca "你说是他做的？"

# game/update2.rpy:6213
translate schinese ep2_math_label_62328794:

    # stu "Yeah."
    stu "嗯。"

# game/update2.rpy:6214
translate schinese ep2_math_label_b0fb6ec6:

    # ca "Perhaps I should hire him as a teacher's assistant."
    ca "也许我应该请他当助教。"

# game/update2.rpy:6215
translate schinese ep2_math_label_9f5b7bf1:

    # stu "Haha!"
    stu "哈哈！"

# game/update2.rpy:6221
translate schinese ep2_math_label_e63cd250:

    # ca "Hm... It's nice that he tried to help you, but this isn't quite correct."
    ca "嗯……他愿意帮你很好，但这个答案不完全正确。"

# game/update2.rpy:6222
translate schinese ep2_math_label_db1f5987:

    # ca "This is how it should be."
    ca "应该这样做。"

# game/update2.rpy:6230
translate schinese ep2_math_label_42558599:

    # mc "Let's do today's exercises..."
    mc "我们做今天的练习吧……"

# game/update2.rpy:6245
translate schinese ep2_after_math_test_419ac31d:

    # my "Gah... I can't wait until this class is over and done with..."
    my "唉……我等不及这门课彻底结束了……"

# game/update2.rpy:6249
