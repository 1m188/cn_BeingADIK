translate schinese ep4_gender_label_0ee826a3:

    # my "[name]? Can we talk, please?"
    my "[name]？我们可以谈谈吗？"

# game/update4.rpy:2241
translate schinese ep4_gender_label_f349301c:

    # mc "Go away, Maya."
    mc "走开，Maya。"

# game/update4.rpy:2243
translate schinese ep4_gender_label_caad95fb:

    # mc "Please... Leave me alone, Maya."
    mc "求求你……别打扰我，Maya。"

# game/update4.rpy:2245
translate schinese ep4_gender_label_6376f3f7:

    # my "Is five minutes too much to ask for?"
    my "要求五分钟是不是太多了？"

# game/update4.rpy:2248
translate schinese ep4_gender_label_8e7432fd:

    # mc "I said...go away. Please."
    mc "我说……走开。请。"

# game/update4.rpy:2250
translate schinese ep4_gender_label_3822e1cf:

    # mc "I said leave me alone."
    mc "我说让我一个人静一静吧。"

# game/update4.rpy:2251
translate schinese ep4_gender_label_80f6de0d:

    # de "Man..."
    de "男人..."

# game/update4.rpy:2253
translate schinese ep4_gender_label_a3bdd7d1:

    # ja "Ok, everyone. Let's get down and dirty and discuss feminism."
    ja "好吧，大家。让我们坐下来讨论一下女权主义吧。"

# game/update4.rpy:2254
translate schinese ep4_gender_label_ae1b2531:

    # ja "I know that many of you have waited for this subject matter so let's not waste any time."
    ja "我知道你们很多人都在等待这个主题，所以我们不要浪费任何时间。"

# game/update4.rpy:2255
translate schinese ep4_gender_label_5168c925:

    # ja "I want to hear your passionate thoughts and views on why feminism is needed in this world."
    ja "我想听听您对这个世界为何需要女权主义的热情想法和观点。"

# game/update4.rpy:2256
translate schinese ep4_gender_label_de563825:

    # ja "Everyone, find a partner."
    ja "大家快来找个伙伴吧。"

# game/update4.rpy:2258
translate schinese ep4_gender_label_7c1a7a45:

    # de "Minny! Hey!"
    de "米妮！嘿！"

# game/update4.rpy:2261
translate schinese ep4_gender_label_a57b5e11:

    # my "Wait!"
    my "等待！"

# game/update4.rpy:2263
translate schinese ep4_gender_label_24c4caed:

    # mc "Hey, you! Let's partner up!"
    mc "嘿，你！我们一起合作吧！"

# game/update4.rpy:2265
translate schinese ep4_gender_label_5c2b1c3a:

    # stu "Uh...ok..."
    stu "呃……好吧……"

# game/update4.rpy:2270
translate schinese ep4_after_gender_test4_label_aa86895d:

    # my "...wow."
    my "...哇。"

# game/update4.rpy:2271
translate schinese ep4_after_gender_test4_label_3568e21e:

    # my "You know..."
    my "你知道..."

# game/update4.rpy:2272
translate schinese ep4_after_gender_test4_label_3cc675a8:

    # my "The things I told you, I wasn't going to tell anyone."
    my "我告诉你的事情，我不会告诉任何人。"

# game/update4.rpy:2273
translate schinese ep4_after_gender_test4_label_f37915f4:

    # my "Ever!"
    my "曾经！"

# game/update4.rpy:2275
translate schinese ep4_after_gender_test4_label_cbfaeb31:

    # my "And I really was going to tell you."
    my "我真的很想告诉你。"

# game/update4.rpy:2276
translate schinese ep4_after_gender_test4_label_e69b7640:

    # my "Maybe that doesn't mean anything to you..."
    my "也许这对你来说没有任何意义......"

# game/update4.rpy:2277
translate schinese ep4_after_gender_test4_label_00851966:

    # my "...but for me...it means a lot."
    my "...但对我来说...这意味着很多。"

# game/update4.rpy:2279
translate schinese ep4_after_gender_test4_label_7883a7ae:

    # my "I'll still be here for you...if you let me."
    my "如果你允许的话，我仍然会在这里等你。"

# game/update4.rpy:2280
translate schinese ep4_after_gender_test4_label_e9e60372:

    # my "Please..."
    my "请..."

# game/update4.rpy:2281
translate schinese ep4_after_gender_test4_label_b43c42d9:

    # my "...just don't forget that."
    my "...只是不要忘记这一点。"

# game/update4.rpy:2291
translate schinese ep4_after_gender_test4_label_c00bc978:

    # mi "You are wrong on so many levels it's baffling!"
    mi "你在很多层面上都错了，这真是令人困惑！"

# game/update4.rpy:2293
translate schinese ep4_after_gender_test4_label_38b6ad2c:

    # de "I have full right to my opinions!"
    de "我有完全的权利表达我的意见！"

# game/update4.rpy:2295
translate schinese ep4_after_gender_test4_label_e41c185f:

    # mi "And that's exactly what those are! Opinions!"
    mi "这正是那些！意见！"

# game/update4.rpy:2296
translate schinese ep4_after_gender_test4_label_f283f21e:

    # mi "Opinions steeped in ignorance."
    mi "观点充满无知。"

# game/update4.rpy:2297
translate schinese ep4_after_gender_test4_label_2ad184e3:

    # mi "Opinions that you treat like fact."
    mi "您视为事实的观点。"

# game/update4.rpy:2298
translate schinese ep4_after_gender_test4_label_121f62c8:

    # mi "Your opinions are highly temperamental, juvenile, misogynistic and have zero relevance to the facts and ironically even to the class literature."
    mi "你的观点非常喜怒无常，幼稚，厌恶女性，与事实无关，讽刺的是，甚至与阶级文学无关。"

# game/update4.rpy:2299
translate schinese ep4_after_gender_test4_label_1d48c5f8:

    # mi "If you just had read the first paragraph you would clearly have known that feminism has always been about equality."
    mi "如果您刚刚读过第一段，您就会清楚地知道女权主义始终是关于平等的。"

# game/update4.rpy:2301
translate schinese ep4_after_gender_test4_label_64ae4314:

    # de "But-"
    de "但-"

# game/update4.rpy:2302
translate schinese ep4_after_gender_test4_label_d52f022b:

    # mi "And I'm not talking about female equality, I'm talking about mankind equality."
    mi "我不是在谈论女性平等，我是在谈论人类平等。"

# game/update4.rpy:2303
translate schinese ep4_after_gender_test4_label_3169a7ca:

    # mi "Take a note from the French Revolution and The Revolutionary war where..."
    mi "从法国大革命和革命战争中记下......"

# game/update4.rpy:2305
translate schinese ep4_after_gender_test4_label_a4c6bfec:

    # de "W-Wendy?"
    de "W-温迪？"

# game/update4.rpy:2306
translate schinese ep4_after_gender_test4_label_b1eb7353:

    # de "Can we talk?"
    de "我们可以谈谈吗？"

# game/update4.rpy:2308
translate schinese ep4_after_gender_test4_label_8d55012c:

    # mi "Hey! We're having a discussion here!"
    mi "嘿！我们在这里讨论！"

# game/update4.rpy:2312
translate schinese ep4_after_gender_test4_label_45e7ec77:

    # mc "(...)"
    mc "（...）"

# game/update4.rpy:2314
translate schinese ep4_after_gender_test4_label_e4b009cf:

    # mc "(What am I doing...?)"
    mc "（我在做什么……？）"

# game/update4.rpy:2317
translate schinese ep4_after_gender_test4_label_45e7ec77_1:

    # mc "(...)"
    mc "（...）"

# game/update4.rpy:2319
translate schinese ep4_after_gender_test4_label_a15d334c:

    # mc "Hey..."
    mc "嘿..."

# game/update4.rpy:2321
translate schinese ep4_after_gender_test4_label_c17c981e:

    # dad "{i}Son, I'm a bit busy at the moment.{/i}"
    dad "{i}儿子，我现在有点忙。{/i}"

# game/update4.rpy:2322
translate schinese ep4_after_gender_test4_label_876356d9:

    # dad "{i}Did something happen? Is it important?{/i}"
    dad "{i}发生什么事了吗？重要吗？{/i}"

# game/update4.rpy:2324
translate schinese ep4_after_gender_test4_label_87e2239d:

    # mc "Dad, I-"
    mc "爸爸，我——"

# game/update4.rpy:2326
translate schinese ep4_after_gender_test4_label_e66258c7:

    # mc "No... It's not important."
    mc "不……这不重要。"

# game/update4.rpy:2327
translate schinese ep4_after_gender_test4_label_ddf7f17f:

    # mc "I had a bit of a dilemma..."
    mc "我有点进退两难......"

# game/update4.rpy:2328
translate schinese ep4_after_gender_test4_label_4229a486:

    # mc "My mind is going back and forth when I think about it and I don't know which way to go."
    mc "我的思绪来来回回，不知道该走哪条路。"

# game/update4.rpy:2330
translate schinese ep4_after_gender_test4_label_111d6e05:

    # dad "{i}You know exactly what to do, son.{/i}"
    dad "{i}你知道该怎么做，儿子。{/i}"

# game/update4.rpy:2331
translate schinese ep4_after_gender_test4_label_b48c7fa5:

    # dad "{i}Do what I always taught you to do.{/i}"
    dad "{i}做我一直教你做的事。{/i}"

# game/update4.rpy:2332
translate schinese ep4_after_gender_test4_label_e8d32d5f:

    # dad "{i}Follow your heart.{/i}"
    dad "{i}跟随你的心。{/i}"

# game/update4.rpy:2334
translate schinese ep4_after_gender_test4_label_bb94af99:

    # mc "Follow my heart... Right..."
    mc "跟随我的心...对..."

# game/update4.rpy:2335
translate schinese ep4_after_gender_test4_label_ccf6e401:

    # mc "Thanks, dad."
    mc "谢谢，爸爸。"

# game/update4.rpy:2336
translate schinese ep4_after_gender_test4_label_56975eb6:

    # mc "I'll call you another time when you're not busy."
    mc "等你不忙的时候我再给你打电话。"

# game/update4.rpy:2338
translate schinese ep4_after_gender_test4_label_9ae0f65c:

    # dad "{i}Looking forward to it! I'd love to catch up with all of your crazy adventures."
    dad "{i}期待！我很想追上你所有疯狂的冒险经历。{/i}"

# game/update4.rpy:2339
translate schinese ep4_after_gender_test4_label_e289caa4:

    # dad "{i}Love you, son!"
    dad "{i}爱你，儿子！{/i}"

# game/update4.rpy:2342
translate schinese ep4_after_gender_test4_label_71cada13:

    # mc "Love you, dad."
    mc "爱你，爸爸。"

# game/update4.rpy:2355
translate schinese ep4_gender_jade_label_992ebb0d:

    # ja "..."
    ja "……"

# game/update4.rpy:2357
translate schinese ep4_gender_jade_label_b90ef3e8:

    # ja "Three years ago, Stephen came home drunk on a Saturday night."
    ja "三年前的一个周六晚上，斯蒂芬喝醉了回家。"

# game/update4.rpy:2358
translate schinese ep4_gender_jade_label_21ad1d09:

    # ja "He had been out celebrating after yet again selling stocks from a very successful trade. As if we need more money..."
    ja "在再次出售一笔非常成功的交易中的股票后，他正在外面庆祝。好像我们需要更多的钱..."

# game/update4.rpy:2359
translate schinese ep4_gender_jade_label_c412eb23:

    # ja "He fumbled with the keys in the lock and when he finally managed to open the door, I was almost by it to unlock it for him."
    ja "他摸索着钥匙插在锁里，当他终于成功打开门时，我几乎就在旁边为他开门。"

# game/update4.rpy:2361
translate schinese ep4_gender_jade_label_729e4660:

    # ja "He smiled a big goofy smile and gave me a slobbery kiss."
    ja "他傻乎乎地笑了笑，给了我一个流口水的吻。"

# game/update4.rpy:2362
translate schinese ep4_gender_jade_label_b1bfa97f:

    # ja "I could taste that he had been indulging himself with his favorite scotch..."
    ja "我能感觉到他一直在沉迷于他最喜欢的苏格兰威士忌......"

# game/update4.rpy:2363
translate schinese ep4_gender_jade_label_9a2a89e6:

    # ja "...that smoky flavor can't be mistaken for anything else."
    ja "...那种烟熏味不能被误认为是其他味道。"

# game/update4.rpy:2365
translate schinese ep4_gender_jade_label_1ab6398c:

    # ja "He grabbed my ass and walked with me towards the bedroom."
    ja "他抓住我的屁股，带着我朝卧室走去。"

# game/update4.rpy:2366
translate schinese ep4_gender_jade_label_b8419b75:

    # ja "A drunk man isn't a turn on for a woman..."
    ja "男人喝醉酒对女人来说是没有吸引力的"

# game/update4.rpy:2367
translate schinese ep4_gender_jade_label_4726d1df:

    # ja "...especially when you're sober..."
    ja "……尤其是当你清醒的时候……"

# game/update4.rpy:2368
translate schinese ep4_gender_jade_label_a78c4dc7:

    # ja "...but I didn't want his victorious day to end in disappointment, so I didn't resist him."
    ja "……但我不想让他胜利的一天以失望告终，所以我没有抗拒他。"

# game/update4.rpy:2370
translate schinese ep4_gender_jade_label_bf3d4b61:

    # ja "He fumbled with the buttons on my blouse, they got unbuttoned, but only due to force."
    ja "他摸索着我衬衫上的纽扣，纽扣被解开了，但只是因为用力。"

# game/update4.rpy:2371
translate schinese ep4_gender_jade_label_a164ad7f:

    # ja "That blouse was ruined in the process..."
    ja "那件衬衫在这个过程中被毁了......"

# game/update4.rpy:2373
translate schinese ep4_gender_jade_label_fb87644c:

    # ja "He got on top of me and started to kiss my neck."
    ja "他骑到我身上，开始亲吻我的脖子。"

# game/update4.rpy:2374
translate schinese ep4_gender_jade_label_33f934ce:

    # ja "And then he whispered into my ear..."
    ja "然后他在我耳边低语……"

# game/update4.rpy:2376
translate schinese ep4_gender_jade_label_78dcbfd7:

    # ja "Cathy. Oh, Cathy."
    ja "Cathy。哦，Cathy。"

# game/update4.rpy:2377
translate schinese ep4_gender_jade_label_e0638ce3:

    # ja "That was the first time I saw the signs."
    ja "那是我第一次看到这些标志。"

# game/update4.rpy:2379
translate schinese ep4_gender_jade_label_57232e74:

    # ja "Now, Cathy is a dear friend of mine. We've been teaching here at B&R for nearly ten years together."
    ja "现在，Cathy是我的好朋友。我们在贝加莱一起教学已近十年。"

# game/update4.rpy:2380
translate schinese ep4_gender_jade_label_6770447f:

    # ja "We spend a lot of time in each other's company during our free time, as well."
    ja "在空闲时间，我们也花了很多时间陪伴彼此。"

# game/update4.rpy:2381
translate schinese ep4_gender_jade_label_075d579c:

    # ja "We're going to the gym, eating dinner, shopping and venting to each other."
    ja "我们去健身房、吃晚饭、购物、互相发泄。"

# game/update4.rpy:2383
translate schinese ep4_gender_jade_label_9ed103ea:

    # ja "It was like a dagger straight into my back, so deep that it plunged all the way in and pierced my heart."
    ja "就像一把匕首，直插在我的后背，深深地刺入我的心脏。"

# game/update4.rpy:2385
translate schinese ep4_gender_jade_label_12084029:

    # ja "As he continued to kiss my neck, I couldn't keep the tears from falling."
    ja "当他继续亲吻我的脖子时，我的眼泪止不住地掉下来。"

# game/update4.rpy:2386
translate schinese ep4_gender_jade_label_0617c010:

    # ja "I never dared to confront him about it. Nor Cathy..."
    ja "我从来不敢和他对质。Cathy也不..."

# game/update4.rpy:2388
translate schinese ep4_gender_jade_label_e4a18cd1:

    # ja "I don't want or need to know if there was some truth behind those drunken words."
    ja "我不想也不需要知道那些醉酒话语背后是否有真相。"

# game/update4.rpy:2389
translate schinese ep4_gender_jade_label_42e913ab:

    # ja "Because it didn't matter..."
    ja "因为这并不重要..."

# game/update4.rpy:2391
translate schinese ep4_gender_jade_label_23063352:

    # ja "The love for my husband had already started fading for me that night..."
    ja "那天晚上，我对丈夫的爱已经开始消退……"

# game/update4.rpy:2392
translate schinese ep4_gender_jade_label_f7167397:

    # ja "I didn't want that to happen for Cathy, too."
    ja "我也不希望Cathy也遭遇这样的事。"

# game/update4.rpy:2394
translate schinese ep4_gender_jade_label_04d26c87:

    # mc "Why are you telling me this?"
    mc "你为什么告诉我这个？"

# game/update4.rpy:2396
translate schinese ep4_gender_jade_label_aeaaba88:

    # ja "Because looking at you sitting here like this..."
    ja "因为看着你这样坐在这里......"

# game/update4.rpy:2397
translate schinese ep4_gender_jade_label_a93bfc89:

    # ja "It's the same way I sat the night he whispered Cathy's name into my ear."
    ja "这和他在我耳边轻声念出Cathy的名字那天晚上我坐着的方式是一样的。"

# game/update4.rpy:2398
translate schinese ep4_gender_jade_label_1250988d:

    # ja "All night. While he snored and slept like a drunken teenager. I just sat like that."
    ja "整个晚上。他打呼噜，睡得像个醉酒的少年。我就这样坐着。"

# game/update4.rpy:2401
translate schinese ep4_gender_jade_label_f4768d8e:

    # ja "I can recognize that feeling of betrayal from anywhere."
    ja "我在任何地方都能感受到那种被背叛的感觉。"

# game/update4.rpy:2402
translate schinese ep4_gender_jade_label_bd68a3cf:

    # ja "What did she do? Maya, correct?"
    ja "她做了什么？Maya，对吗？"

# game/update4.rpy:2407
translate schinese ep4_gender_jade_label_bfab9630:

    # mc "She kept things from me..."
    mc "她对我隐瞒了一些事情..."

# game/update4.rpy:2408
translate schinese ep4_gender_jade_label_b0cbea3a:

    # mc "Secrets that would have changed a lot if she told me sooner."
    mc "如果她早点告诉我，这些秘密就会改变很多。"

# game/update4.rpy:2410
translate schinese ep4_gender_jade_label_78868298:

    # ja "I see."
    ja "我懂了。"

# game/update4.rpy:2411
translate schinese ep4_gender_jade_label_041315ed:

    # ja "Clear your head before you make your decision."
    ja "在做出决定之前先清醒一下头脑。"

# game/update4.rpy:2413
translate schinese ep4_gender_jade_label_a736d2ed:

    # mc "You're right that it's a feeling of betrayal...but I don't want to talk to anyone about it."
    mc "你说得对，这是一种背叛的感觉……但我不想和任何人谈论它。"

# game/update4.rpy:2415
translate schinese ep4_gender_jade_label_6279bdf3:

    # ja "Give it time. Clear your head before you make your decision."
    ja "给它时间。在做出决定之前先清醒一下头脑。"

# game/update4.rpy:2417
translate schinese ep4_gender_jade_label_c7242520:

    # mc "What was your decision?"
    mc "你的决定是什么？"

# game/update4.rpy:2419
translate schinese ep4_gender_jade_label_413e7874:

    # ja "My decision was to ignore it...for the sake of our family."
    ja "为了我们的家庭，我的决定是忽略它。"

# game/update4.rpy:2420
translate schinese ep4_gender_jade_label_1a1ddf78:

    # ja "The first time he cheated, I just had a hunch. But that hunch hurt like hell."
    ja "第一次他出轨的时候，我就有预感。但这种预感让我很痛苦。"

# game/update4.rpy:2421
translate schinese ep4_gender_jade_label_ea97ce72:

    # ja "The second time, I found proof, but I remained silent."
    ja "第二次，我找到了证据，但我保持沉默。"

# game/update4.rpy:2422
translate schinese ep4_gender_jade_label_57da87d0:

    # ja "And after the third time..."
    ja "而第三次之后..."

# game/update4.rpy:2424
translate schinese ep4_gender_jade_label_992ebb0d_1:

    # ja "..."
    ja "……"

# game/update4.rpy:2426
translate schinese ep4_gender_jade_label_536803ff:

    # ja "Even if you choose apathy...rage doesn't escape you. It just builds up."
    ja "即使你选择冷漠……愤怒也不会逃避你。它只是建立起来。"

# game/update4.rpy:2428
translate schinese ep4_gender_jade_label_6c983e14:

    # ja "Haha... Look at me confiding in you, right now."
    ja "哈哈...看看我现在对你倾诉的样子。"

# game/update4.rpy:2429
translate schinese ep4_gender_jade_label_43a37aea:

    # ja "It feels nice."
    ja "感觉很好。"

# game/update4.rpy:2430
translate schinese ep4_gender_jade_label_e544d28a:

    # ja "You and I already have one secret to keep."
    ja "你和我已经有一个秘密需要保守。"

# game/update4.rpy:2435
translate schinese ep4_gender_jade_label_992ebb0d_2:

    # ja "..."
    ja "……"

# game/update4.rpy:2437
translate schinese ep4_gender_jade_label_c2851522:

    # ja "Um..."
    ja "嗯..."

