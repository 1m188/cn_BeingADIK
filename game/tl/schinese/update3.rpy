    mc "他们没有……我必须爬墙。"

# game/update3.rpy:6830
translate schinese ep3_after_ano_freeroam_label_5e53b027:

    # ji "[name]... You can't do that."
    ji "[name]……你不能这么做。"

# game/update3.rpy:6832
translate schinese ep3_after_ano_freeroam_label_6643215b:

    # mc "I'm sorry, but what choice did I have?"
    mc "对不起，但我有什么选择呢？"

# game/update3.rpy:6833
translate schinese ep3_after_ano_freeroam_label_77dbc9df:

    # mc "To scream until you heard me?"
    mc "尖叫直到听到我的声音？"

# game/update3.rpy:6835
translate schinese ep3_after_ano_freeroam_label_4ef571f3:

    # ji "You could have asked the security guard to call me?"
    ji "你本来可以让保安给我打电话的？"

# game/update3.rpy:6837
translate schinese ep3_after_ano_freeroam_label_3e6e7401:

    # mc "Tybalt told him to not let me in."
    mc "提伯尔特告诉他不要让我进去。"

# game/update3.rpy:6840
translate schinese ep3_after_ano_freeroam_label_d1db30ba:

    # mc "What can I say? I'm adorable."
    mc "我能说什么？我很可爱。"

# game/update3.rpy:6842
translate schinese ep3_after_ano_freeroam_label_2a8e03b2:

    # ji "Well, we've recently had a break-in, so security is on high alert."
    ji "嗯，我们最近发生了一起入室盗窃事件，所以保安处于高度戒备状态。"

# game/update3.rpy:6843
translate schinese ep3_after_ano_freeroam_label_26676465:

    # ji "Come on in."
    ji "进来吧。"

# game/update3.rpy:6845
translate schinese ep3_after_ano_freeroam_label_11d8dcfe:

    # ji "You brought your guitar?"
    ji "你带了吉他？"

# game/update3.rpy:6846
translate schinese ep3_after_ano_freeroam_label_5833751b:

    # mc "Yes, sit down and just listen."
    mc "是的，坐下来听听。"

# game/update3.rpy:6848
translate schinese ep3_after_ano_freeroam_label_f46d4740:

    # ji "But...why?"
    ji "但为什么？"

# game/update3.rpy:6850
translate schinese ep3_after_ano_freeroam_label_1a87591e:

    # mc "I'm making things up to you."
    mc "我正在为你安排事情。"

# game/update3.rpy:6851
translate schinese ep3_after_ano_freeroam_label_c180d234:

    # mc "For being a jerk yesterday and also for walking in on you playing the piano."
    mc "昨天是个混蛋，还撞见你弹钢琴。"

# game/update3.rpy:6852
translate schinese ep3_after_ano_freeroam_label_2d5f193c:

    # mc "I noticed how weird it felt when you realized that I heard you play..."
    mc "我注意到当你意识到我听到你演奏时感觉有多么奇怪......"

# game/update3.rpy:6853
translate schinese ep3_after_ano_freeroam_label_d619f312:

    # mc "So, I thought I could even things out for us."
    mc "所以，我想我可以为我们解决问题。"

# game/update3.rpy:6855
translate schinese ep3_after_ano_freeroam_label_10228b67:

    # ji "Ok...?"
    ji "好的……？"

# game/update3.rpy:6866
translate schinese ep3_after_ano_freeroam_label_49efb3da:

    # mc "Now we're even."
    mc "现在我们扯平了。"

# game/update3.rpy:6867
translate schinese ep3_after_ano_freeroam_label_8170afc5:

    # mc "That was a very personal song I just played for you."
    mc "那是我刚刚为你演奏的一首非常私人的歌曲。"

# game/update3.rpy:6869
translate schinese ep3_after_ano_freeroam_label_48bd612b:

    # ji "You're really talented. I loved it."
    ji "你真的很有才华。我喜欢它。"

# game/update3.rpy:6870
translate schinese ep3_after_ano_freeroam_label_aba430bc:

    # ji "You know...that's Bella's favorite song."
    ji "你知道……那是Bella最喜欢的歌。"

# game/update3.rpy:6872
translate schinese ep3_after_ano_freeroam_label_ce9ec2ca:

    # mc "Oh, yeah! I forgot, she told me that."
    mc "哦，是啊！我忘了，是她告诉我的。"

# game/update3.rpy:6874
translate schinese ep3_after_ano_freeroam_label_b1efa638:

    # ji "Do you play any classical music?"
    ji "你演奏古典音乐吗？"

# game/update3.rpy:6876
translate schinese ep3_after_ano_freeroam_label_f982a92c:

    # mc "No, the fingering in those songs is very tricky for me."
    mc "不，那些歌曲中的指法对我来说非常棘手。"

# game/update3.rpy:6878
translate schinese ep3_after_ano_freeroam_label_313ca983:

    # ji "Didn't they teach you that in class?"
    ji "他们在课堂上没教过你吗？"

# game/update3.rpy:6880
translate schinese ep3_after_ano_freeroam_label_99afab35:

    # mc "I never took any music classes, I learned everything I know on my own."
    mc "我从未上过任何音乐课，我所知道的一切都是自学的。"

# game/update3.rpy:6882
translate schinese ep3_after_ano_freeroam_label_4c4ec69f:

    # ji "Then it's even more impressive."
    ji "然后就更让人印象深刻了。"

# game/update3.rpy:6883
translate schinese ep3_after_ano_freeroam_label_6ad62b67:

    # ji "And yes...we're even."
    ji "是的……我们扯平了。"

# game/update3.rpy:6885
translate schinese ep3_after_ano_freeroam_label_69402d03:

    # mc "Great! Because I would love to hear you play again!"
    mc "太好了！因为我特别想再听你弹一次！"

# game/update3.rpy:6887
translate schinese ep3_after_ano_freeroam_label_a2f0c59e:

    # ji "You what?"
    ji "你什么？"

# game/update3.rpy:6889
translate schinese ep3_after_ano_freeroam_label_efc8b342:

    # mc "I haven't been able to get that melody you played off my mind."
    mc "我一直无法忘记你演奏的那首旋律。"

# game/update3.rpy:6891
translate schinese ep3_after_ano_freeroam_label_df20add8:

    # ji "All right... Let's go to the west wing."
    ji "好吧……我们去西翼吧。"

# game/update3.rpy:6892
translate schinese ep3_after_ano_freeroam_label_05361e24:

    # ji "My piano is there."
    ji "我的钢琴在那里。"

# game/update3.rpy:6894
translate schinese ep3_after_ano_freeroam_label_23b7d55e:

    # mc "This is your piano?"
    mc "这是你的钢琴吗？"

# game/update3.rpy:6896
translate schinese ep3_after_ano_freeroam_label_196088a1:

    # ji "Yes, my dad bought it for my tenth birthday."
    ji "是的，我爸爸在我十岁生日时买的。"

# game/update3.rpy:6898
translate schinese ep3_after_ano_freeroam_label_850272dd:

    # mc "It's a beautiful instrument."
    mc "这是一个美丽的乐器。"

# game/update3.rpy:6908
translate schinese ep3_after_ano_freeroam_label_50fb8b70:

    # mc "Oh, wow. What a song!"
    mc "哦，哇。多好的一首歌啊！"

# game/update3.rpy:6909
translate schinese ep3_after_ano_freeroam_label_8dbaabdc:

    # ji "Did you ever learn to read sheet music?"
    ji "你学过读乐谱吗？"

# game/update3.rpy:6910
translate schinese ep3_after_ano_freeroam_label_a5e1ee96:

    # mc "I know the basics, but I can't figure it out while playing."
    mc "基础知识我都懂，但是玩的时候却搞不懂。"

# game/update3.rpy:6911
translate schinese ep3_after_ano_freeroam_label_26a1ce63:

    # mc "So, I'm not...um...fluent or what you'd call it."
    mc "所以，我不……嗯……流利或者你所说的。"

# game/update3.rpy:6912
translate schinese ep3_after_ano_freeroam_label_0aa1cba2:

    # ji "Take a look and see if you understand something while I play, then."
    ji "那就看看我玩的时候你是否明白了什么。"

# game/update3.rpy:6913
translate schinese ep3_after_ano_freeroam_label_39df5954:

    # ji "I should be fine without it, for this song."
    ji "对于这首歌来说，没有它我应该也能过得很好。"

# game/update3.rpy:6916
translate schinese ep3_after_ano_freeroam_label_1d20637a:

    # mc "(Hm...no, this is going way too fast for me.)"
    mc "（嗯……不，这对我来说太快了。）"

# game/update3.rpy:6917
translate schinese ep3_after_ano_freeroam_label_f687522c:

    # mc "(And I can't really focus standing this close to her...)"
    mc "（站得离她这么近我真的无法集中注意力......）"

# game/update3.rpy:6922
translate schinese ep3_after_ano_freeroam_label_45d6e470:

    # mc "*{i}Gulp{/i}*"
    mc "*{i}吞咽{/i}*"

# game/update3.rpy:6923
translate schinese ep3_after_ano_freeroam_label_40cecb4d:

    # ji "Can you see them?"
    ji "你能看到他们吗？"

# game/update3.rpy:6926
translate schinese ep3_after_ano_freeroam_label_40cecb4d_1:

    # ji "Can you see them?"
    ji "你能看到他们吗？"

# game/update3.rpy:6927
translate schinese ep3_after_ano_freeroam_label_c0bdf8b6:

    # mc "Um...what?"
    mc "嗯……什么？"

# game/update3.rpy:6928
translate schinese ep3_after_ano_freeroam_label_93850587:

    # ji "The notes I'm playing."
    ji "我正在演奏的音符。"

# game/update3.rpy:6930
translate schinese ep3_after_ano_freeroam_label_ec214774:

    # mc "Yeah, but I don't quite understand where you are in the song."
    mc "是的，但我不太明白你在歌曲中的位置。"

# game/update3.rpy:6931
translate schinese ep3_after_ano_freeroam_label_5a8213f6:

    # mc "Would you mind if I snapped a photo of the sheet? Just so I can study it later."
    mc "你介意我拍张床单的照片吗？这样我就可以稍后再研究它了。"

# game/update3.rpy:6932
translate schinese ep3_after_ano_freeroam_label_8e2354bc:

    # ji "Please, go ahead."
    ji "请继续。"

# game/update3.rpy:6934
translate schinese ep3_after_ano_freeroam_label_a64e8bc0:

    # mc "Thanks."
    mc "谢谢。"

# game/update3.rpy:6936
translate schinese ep3_after_ano_freeroam_label_9eef5a4c:

    # mc "It's a beautiful song. The melody really sticks with you."
    mc "这是一首美丽的歌曲。旋律真的很适合你。"

# game/update3.rpy:6938
translate schinese ep3_after_ano_freeroam_label_7760b9ca:

    # mc "I was thinking..."
    mc "我在想……"

# game/update3.rpy:6939
translate schinese ep3_after_ano_freeroam_label_6bf89c5f:

    # mc "Since you practiced in the auditorium before and not in here..."
    mc "因为你之前是在礼堂练习的，而不是在这里……"

# game/update3.rpy:6940
translate schinese ep3_after_ano_freeroam_label_2c2cea61:

    # mc "...are you reciting for a performance or something?"
    mc "……你是为了表演而朗诵还是什么？"

# game/update3.rpy:6942
translate schinese ep3_after_ano_freeroam_label_342199a8:

    # ji "You're sharp."
    ji "你很敏锐。"

# game/update3.rpy:6944
translate schinese ep3_after_ano_freeroam_label_0a127154:

    # ji "Which is weird considering what you're wearing right now."
    ji "考虑到你现在穿的衣服，这很奇怪。"

# game/update3.rpy:6945
translate schinese ep3_after_ano_freeroam_label_787d3d8b:

    # ji "Yes, once in a while the campus has concerts in the auditorium."
    ji "是的，校园偶尔会在礼堂举办音乐会。"

# game/update3.rpy:6946
translate schinese ep3_after_ano_freeroam_label_85d7506d:

    # ji "I've been invited to perform in one of them."
    ji "我受邀在其中一场演出。"

# game/update3.rpy:6948
translate schinese ep3_after_ano_freeroam_label_bc0b10a7:

    # ji "And I'm a bit nervous and really like to be prepared...so..."
    ji "我有点紧张，真的很想做好准备……所以……"

# game/update3.rpy:6950
translate schinese ep3_after_ano_freeroam_label_57b688bb:

    # mc "You're already practicing like crazy, huh?"
    mc "你已经疯狂地练习了，是吧？"

# game/update3.rpy:6952
translate schinese ep3_after_ano_freeroam_label_1bbba13f:

    # ji "Yes. I don't do big audiences."
    ji "是的，我不做大型观众。"

# game/update3.rpy:6953
translate schinese ep3_after_ano_freeroam_label_d9dfe3ed:

    # ji "It's been a dream of mine to do it...but my nerves..."
    ji "这是我的梦想……但我的神经……"

# game/update3.rpy:6954
translate schinese ep3_after_ano_freeroam_label_aa9cb8da:

    # ji "I'm not a performer."
    ji "我不是表演者。"

# game/update3.rpy:6964
translate schinese ep3_after_ano_freeroam_label_3aa710b0:

    # mc "That's why you acted strange when I saw you play?"
    mc "所以我看你打球的时候你表现得很奇怪？"

# game/update3.rpy:6965
translate schinese ep3_after_ano_freeroam_label_bd797ba0:

    # ji "..."
    ji "……"

# game/update3.rpy:6966
translate schinese ep3_after_ano_freeroam_label_2a8f6c49:

    # mc "It really was a wonderful song."
    mc "这确实是一首美妙的歌曲。"

# game/update3.rpy:6967
translate schinese ep3_after_ano_freeroam_label_d218188f:

    # ji "Thank you."
    ji "谢谢。"

# game/update3.rpy:6968
translate schinese ep3_after_ano_freeroam_label_67a86d31:

    # ji "I think so, too."
    ji "我也这么认为。"

# game/update3.rpy:6969
translate schinese ep3_after_ano_freeroam_label_620cf1ea:

    # mc "I think you can do it. Just keep practicing until you're confident."
    mc "我认为你能做到。继续练习直到你有信心为止。"

# game/update3.rpy:6971
translate schinese ep3_after_ano_freeroam_label_4b5fa051:

    # ji "You think?"
    ji "是吗？"

# game/update3.rpy:6973
translate schinese ep3_after_ano_freeroam_label_19825f0b:

    # mc "Hey, I can be your audience. I'd love to hear you play more."
    mc "嘿，我可以成为你的观众。我很想听你演奏更多。"

# game/update3.rpy:6974
translate schinese ep3_after_ano_freeroam_label_cfa223bc:

    # mc "It's the first time I've had the luxury to hear great piano music up close."
    mc "这是我第一次有幸近距离聆听美妙的钢琴音乐。"

# game/update3.rpy:6979
translate schinese ep3_after_ano_freeroam_label_ce300cdf:

    # ji "What did you do to make Bella come around?"
    ji "你做了什么让Bella回心转意？"

# game/update3.rpy:6981
translate schinese ep3_after_ano_freeroam_label_e8553f8e:

    # mc "Um...nothing."
    mc "嗯……没什么。"

# game/update3.rpy:6982
translate schinese ep3_after_ano_freeroam_label_eb786d3c:

    # mc "Wait...she came around?"
    mc "等等……她来了？"

# game/update3.rpy:6984
translate schinese ep3_after_ano_freeroam_label_e6626984:

    # ji "She did."
    ji "她做到了。"

# game/update3.rpy:6985
translate schinese ep3_after_ano_freeroam_label_32428645:

    # ji "What did you tell her?"
    ji "你告诉她什么了？"

# game/update3.rpy:6987
translate schinese ep3_after_ano_freeroam_label_39235315:

    # mc "I...ah...have no idea, really."
    mc "我……啊……不知道，真的。"

# game/update3.rpy:6988
translate schinese ep3_after_ano_freeroam_label_f50b7dea:

    # mc "I thought she didn't like me that much."
    mc "我以为她没那么喜欢我。"

# game/update3.rpy:6990
translate schinese ep3_after_ano_freeroam_label_5b990a7d:

    # ji "Well...you're wrong."
    ji "嗯……你错了。"

# game/update3.rpy:6991
translate schinese ep3_after_ano_freeroam_label_b37aed83:

    # ji "She told me to give you a chance."
    ji "她告诉我给你一个机会。"

# game/update3.rpy:6993
translate schinese ep3_after_ano_freeroam_label_ec7ff418:

    # ji "She does like you."
    ji "她确实喜欢你。"

# game/update3.rpy:6994
translate schinese ep3_after_ano_freeroam_label_46a23021:

    # ji "And I think you're-"
    ji "我认为你是——"

# game/update3.rpy:6997
translate schinese ep3_after_ano_freeroam_label_2e721e0b:

    # ji "Why don't you get along with Bella?"
    ji "你为什么不和Bella和睦相处呢？"

# game/update3.rpy:6999
translate schinese ep3_after_ano_freeroam_label_4e3122cb:

    # mc "I can't be the only one who's not getting along with her...right?"
    mc "我不可能是唯一一个和她合不来的人……对吧？"

# game/update3.rpy:7001
translate schinese ep3_after_ano_freeroam_label_01d292c7:

    # ji "No...but what did you tell her?"
    ji "不……但是你告诉她什么了？"

# game/update3.rpy:7003
translate schinese ep3_after_ano_freeroam_label_39235315_1:

    # mc "I...ah...have no idea, really."
    mc "我……啊……不知道，真的。"

# game/update3.rpy:7004
translate schinese ep3_after_ano_freeroam_label_57ce9442:

    # mc "I just get the feeling that she doesn't like anything I say or do."
    mc "我只是感觉她不喜欢我所说或所做的一切。"

# game/update3.rpy:7006
translate schinese ep3_after_ano_freeroam_label_c13b6bdf:

    # ji "Well...you're not wrong."
    ji "嗯……你没有错。"

# game/update3.rpy:7007
translate schinese ep3_after_ano_freeroam_label_1541c13f:

    # ji "I guess I just look at you differently from her..."
    ji "我想我只是看你和她不一样......"

# game/update3.rpy:7009
translate schinese ep3_after_ano_freeroam_label_05b98953:

    # ji "Because, I think you're-"
    ji "因为，我认为你是——"

# game/update3.rpy:7011
translate schinese ep3_after_ano_freeroam_label_579b6ae1:

    # ty "You are an absolute mad man, Rich!"
    ty "你绝对是个疯子，里奇！"

# game/update3.rpy:7012
translate schinese ep3_after_ano_freeroam_label_8e65566d:

    # ty "That's another perfect challenge for our new protégés."
    ty "这对我们的新弟子来说是另一个完美的挑战。"

# game/update3.rpy:7013
translate schinese ep3_after_ano_freeroam_label_3d651b14:

    # ty "One bottle of champagne and a beer glass is coming right-"
    ty "一瓶香槟和一杯啤酒马上就到了——"

# game/update3.rpy:7015
translate schinese ep3_after_ano_freeroam_label_4e513469:

    # ty "Huh!"
    ty "哈！"

# game/update3.rpy:7020
translate schinese ep3_after_ano_freeroam_label_2d805566:

    # ty "Jill?"
    ty "Jill？"

# game/update3.rpy:7022
translate schinese ep3_after_ano_freeroam_label_7e00f434:

    # ty "How did this boy get past the gates?"
    ty "这小子是怎么跨过城门的？"

# game/update3.rpy:7023
translate schinese ep3_after_ano_freeroam_label_481beaf9:

    # ty "Rich, call for security!"
    ty "富贵，呼叫安全！"

# game/update3.rpy:7025
translate schinese ep3_after_ano_freeroam_label_4add628c:

    # ji "Tybalt, wait!"
    ji "提伯尔特，等等！"

# game/update3.rpy:7026
translate schinese ep3_after_ano_freeroam_label_3f8ab2c4:

    # ji "He's my guest and he's free to come here whenever he wants to."
    ji "他是我的客人，他想什么时候来都可以。"

# game/update3.rpy:7027
translate schinese ep3_after_ano_freeroam_label_1a325aa5:

    # ty "I beg your pardon."
    ty "请再说一遍。"

# game/update3.rpy:7028
translate schinese ep3_after_ano_freeroam_label_e1950ed0:

    # ty "Jill, please! This student has no business in the mansion."
    ty "Jill，拜托！这个学生在宅邸里没有什么事。"

# game/update3.rpy:7030
translate schinese ep3_after_ano_freeroam_label_5bb73e07:

    # ty "Look at his rags."
    ty "看看他的破烂衣服。"

# game/update3.rpy:7031
translate schinese ep3_after_ano_freeroam_label_6409c9ce:

    # ty "You call those clothes?"
    ty "你叫那些衣服？"

# game/update3.rpy:7033
translate schinese ep3_after_ano_freeroam_label_cf4e2b39:

    # ty "And that absolutely atrocious piece of attire he wears on his head."
    ty "还有他头上戴的那件绝对残暴的衣服。"

# game/update3.rpy:7035
translate schinese ep3_after_ano_freeroam_label_24bf8510:

    # ji "He's my guest and you will treat him with respect."
    ji "他是我的客人，你要尊重他。"

# game/update3.rpy:7036
