# game/update3.rpy:3193
translate schinese ep3_lunch_bella_label_f2908e43:

    # isa "Yes, I eat here every day. It's the only restaurant that's close to work."
    isa "是的，我每天都在这里吃饭。这是唯一一家靠近上班地点的餐厅。"

# game/update3.rpy:3195
translate schinese ep3_lunch_bella_label_3e4c2038:

    # mc "Um... I said it was a joke."
    mc "嗯……我说这是一个笑话。"

# game/update3.rpy:3197
translate schinese ep3_lunch_bella_label_83bafead:

    # isa "So was mine. Are you the only one who's allowed to tell them?"
    isa "我那句也是。难道只有你才配讲笑话？"

# game/update3.rpy:3199
translate schinese ep3_lunch_bella_label_6f8795b8:

    # mc "Oh! Haha. I didn't catch that...since you know..."
    mc "哦！哈哈。我没听懂……因为你知道……"

# game/update3.rpy:3200
translate schinese ep3_lunch_bella_label_8cad3871:

    # mc "...it lacked tone."
    mc "……缺乏语气。"

# game/update3.rpy:3203
translate schinese ep3_lunch_bella_label_564d47c5:

    # isa "What's up with the hat? A new trend or something?"
    isa "帽子怎么了？新趋势还是什么？"

# game/update3.rpy:3205
translate schinese ep3_lunch_bella_label_57e4b4f8:

    # mc "I'm just showcasing my personality."
    mc "我只是展示我的个性。"

# game/update3.rpy:3207
translate schinese ep3_lunch_bella_label_7a6ce198:

    # isa "Ironic... With boys there's often the notion that the brain is found close to that thing."
    isa "讽刺的是……对于男孩来说，人们常常认为大脑与那个东西很接近。"

# game/update3.rpy:3211
translate schinese ep3_lunch_bella_label_21476502:

    # isa "That's your friend over there...with the...hat?"
    isa "那是你那边的朋友……戴着……帽子？"

# game/update3.rpy:3213
translate schinese ep3_lunch_bella_label_4c7cedbd:

    # mc "Yeah, that's Derek."
    mc "是的，那是Derek。"

# game/update3.rpy:3214
translate schinese ep3_lunch_bella_label_d3401b95:

    # mc "The helmet is part of our Hell Week. Hell Week is a kind of hazing process."
    mc "该头盔是我们地狱周的一部分。地狱周是一种欺凌过程。"

# game/update3.rpy:3216
translate schinese ep3_lunch_bella_label_1cd512cc:

    # isa "I know what Hell Week is. It was a thing when I went to college, too."
    isa "我知道什么是地狱周。我上大学的时候也有过这样的事情。"

# game/update3.rpy:3218
translate schinese ep3_lunch_bella_label_55254771:

    # mc "Oh, so they had it back then?"
    mc "哦，所以他们当时就有了？"

# game/update3.rpy:3220
translate schinese ep3_lunch_bella_label_b6c44f5e:

    # isa "Back then?"
    isa "那时？"

# game/update3.rpy:3221
translate schinese ep3_lunch_bella_label_aa686499:

    # isa "How old do you think I am?"
    isa "你认为我几岁了？"

# game/update3.rpy:3223
translate schinese ep3_lunch_bella_label_9a4be4f9:

    # mc "My dad taught me that you don't discuss a woman's age or weight."
    mc "我父亲告诉我，不要讨论女性的年龄或体重。"

# game/update3.rpy:3225
translate schinese ep3_lunch_bella_label_667e26e1:

    # isa "Apparently, I'm not only old but also fat."
    isa "看来我不仅老了，还胖了。"

# game/update3.rpy:3227
translate schinese ep3_lunch_bella_label_d3ef1498:

    # mc "No! That's not what I meant."
    mc "不！我不是这个意思。"

# game/update3.rpy:3229
translate schinese ep3_lunch_bella_label_10db7c3a:

    # isa "It was a joke."
    isa "这是一个笑话。"

# game/update3.rpy:3231
translate schinese ep3_lunch_bella_label_1015cac1:

    # mc "Hilarious... Thanks for making me sweat for nothing."
    mc "搞笑……谢谢你让我无缘无故地流汗。"

# game/update3.rpy:3234
translate schinese ep3_lunch_bella_label_68ffec15:

    # isa "So, you're going to wear that hat, all week?"
    isa "那么，你整个星期都会戴着那顶帽子吗？"

# game/update3.rpy:3236
translate schinese ep3_lunch_bella_label_bde41e01:

    # isa "So, he's going to wear that hat, all week?"
    isa "那么，他整个星期都会戴着那顶帽子？"

# game/update3.rpy:3239
translate schinese ep3_lunch_bella_label_8db18d01:

    # mc "No, I take turns with my friend Derek."
    mc "不，我和我的朋友Derek轮流。"

# game/update3.rpy:3241
translate schinese ep3_lunch_bella_label_6df21f25:

    # isa "Derek is your friend?"
    isa "Derek是你的朋友吗？"

# game/update3.rpy:3243
translate schinese ep3_lunch_bella_label_9bbd450c:

    # mc "No, we take turns. He just happens to like it, so I let him wear it more."
    mc "不，我们轮流。他刚好喜欢，所以我就让他多穿一些。"

# game/update3.rpy:3245
translate schinese ep3_lunch_bella_label_c5bc29fd:

    # isa "That sounds like Derek."
    isa "听起来像Derek。"

# game/update3.rpy:3246
translate schinese ep3_lunch_bella_label_670dde60:

    # mc "You know him?"
    mc "你认识他？"

# game/update3.rpy:3247
translate schinese ep3_lunch_bella_label_0caa4761:

    # isa "It's difficult to miss a shirtless student walking the hallways."
    isa "很难错过一个光着膀子走在走廊上的学生。"

# game/update3.rpy:3248
translate schinese ep3_lunch_bella_label_224a8dfe:

    # isa "Also, he's got quite the reputation among teachers, too."
    isa "而且，他在老师当中可是出了名的。"

# game/update3.rpy:3250
translate schinese ep3_lunch_bella_label_0f032e39:

    # mc "A reputation? Like what?"
    mc "声誉？比如什么？"

# game/update3.rpy:3252
translate schinese ep3_lunch_bella_label_ad2fcb23:

    # isa "Like I would tell you that. You'd run off to him and spill the beans immediately."
    isa "我像是会告诉你的人吗？你转头就会跑去跟他一五一十地说了。"

# game/update3.rpy:3254
translate schinese ep3_lunch_bella_label_f7125a98:

    # mc "No, come on! I promise. What do they say?"
    mc "不，来吧！我保证。他们怎么说？"

# game/update3.rpy:3256
translate schinese ep3_lunch_bella_label_e54901f3:

    # isa "I'm not telling you."
    isa "我不告诉你。"

# game/update3.rpy:3258
translate schinese ep3_lunch_bella_label_3e9b35a6:

    # mc "If you tell me a secret, I'll tell you one."
    mc "如果你告诉我一个秘密，我就告诉你一个。"

# game/update3.rpy:3260
translate schinese ep3_lunch_bella_label_ed96ce9e:

    # isa "Are we resorting to manipulation now?"
    isa "我们现在要诉诸操纵吗？"

# game/update3.rpy:3263
translate schinese ep3_lunch_bella_label_9ccbd018:

    # mc "No, I was just looking to share things with you."
    mc "不，我只是想与你分享一些东西。"

# game/update3.rpy:3264
translate schinese ep3_lunch_bella_label_7fb18797:

    # mc "Like you do during conversations."
    mc "就像你在谈话时所做的那样。"

# game/update3.rpy:3265
translate schinese ep3_lunch_bella_label_6857f779:

    # mc "For instance, why did you want to have dinner with me in the first place?"
    mc "例如，你为什么要和我一起吃晚饭？"

# game/update3.rpy:3267
translate schinese ep3_lunch_bella_label_8a465165:

    # isa "Like I told you, I wanted to give you one chance to change my mind about you."
    isa "就像我告诉过你的，我想给你一次机会来改变我对你的看法。"

# game/update3.rpy:3269
translate schinese ep3_lunch_bella_label_3114e167:

    # mc "So...have I?"
    mc "那么……我有吗？"

# game/update3.rpy:3271
translate schinese ep3_lunch_bella_label_015d2ece:

    # isa "No."
    isa "不。"

# game/update3.rpy:3273
translate schinese ep3_lunch_bella_label_a9e19449:

    # mc "Thanks...that's...blunt."
    mc "谢谢……那是……直言不讳。"

# game/update3.rpy:3275
translate schinese ep3_lunch_bella_label_bb365a2b:

    # isa "I would have asked you about your background and tried to figure out if you find trouble or if trouble finds you."
    isa "我会询问你的背景，并试图弄清楚你是否遇到了麻烦，或者麻烦是否找到了你。"

# game/update3.rpy:3277
translate schinese ep3_lunch_bella_label_68dc816f:

    # mc "Oh, it's definitely the first one. No, wait, what were the options?"
    mc "哦，这绝对是第一个。不，等等，有什么选择？"

# game/update3.rpy:3278
translate schinese ep3_lunch_bella_label_fb623a7e_2:

    # isa "..."
    isa "……"

# game/update3.rpy:3280
translate schinese ep3_lunch_bella_label_0c6f9b7f:

    # isa "Have you been drinking?"
    isa "你喝过酒吗？"

# game/update3.rpy:3282
translate schinese ep3_lunch_bella_label_bfb6a449:

    # mc "There's really no winning with you."
    mc "和你在一起真的没有胜算。"

# game/update3.rpy:3283
translate schinese ep3_lunch_bella_label_6f8ea284:

    # mc "And, hey! You already know a bit about my background."
    mc "而且，嘿！你已经对我的背景有所了解了。"

# game/update3.rpy:3285
translate schinese ep3_lunch_bella_label_2366263b:

    # isa "You mean about your mom?"
    isa "你是说你妈妈？"

# game/update3.rpy:3287
translate schinese ep3_lunch_bella_label_f36e5aec:

    # mc "Exactly."
    mc "确切地。"

# game/update3.rpy:3289
translate schinese ep3_lunch_bella_label_9259898e:

    # isa "I was looking for a little bit more than that."
    isa "我正在寻找比这更多的东西。"

# game/update3.rpy:3291
translate schinese ep3_lunch_bella_label_168861fe:

    # mc "Oh, about my dad?"
    mc "哦，关于我爸爸？"

# game/update3.rpy:3293
translate schinese ep3_lunch_bella_label_1f6acae3:

    # isa "No! About {b}you{/b}."
    isa "不！是关于{b}你{/b}。"

# game/update3.rpy:3295
translate schinese ep3_lunch_bella_label_73fb1292:

    # mc "(She likes me...)"
    mc "（她喜欢我……）"

# game/update3.rpy:3296
translate schinese ep3_lunch_bella_label_f3162609:

    # isa "(God, he's so dense...)"
    isa "（天哪，他可真迟钝……）"

# game/update3.rpy:3297
translate schinese ep3_lunch_bella_label_c9dd2665:

    # mc "Ok. I'm a straight, single guy who enjoys playing guitar and practicing martial arts."
    mc "好的。我是一个直男，单身，喜欢弹吉他和练习武术。"

# game/update3.rpy:3299
translate schinese ep3_lunch_bella_label_97371c3e:

    # isa "Great. Now try it again, without sounding like a personal ad."
    isa "好极了。再来一次，别听起来像征婚广告。"

# game/update3.rpy:3301
translate schinese ep3_lunch_bella_label_7bf6f19d:

    # mc "I don't get what you want me to say."
    mc "我不明白你想让我说什么。"

# game/update3.rpy:3303
translate schinese ep3_lunch_bella_label_fb17f655:

    # isa "Could the straight, single guy tell me about his past relationships?"
    isa "这位单身的直男能告诉我他过去的恋情吗？"

# game/update3.rpy:3305
translate schinese ep3_lunch_bella_label_4d3098ef:

    # mc "There's really just been one."
    mc "确实只有一个。"

# game/update3.rpy:3306
translate schinese ep3_lunch_bella_label_7d168e81:

    # mc "It's pretty personal..."
    mc "这挺私人的……"

# game/update3.rpy:3309
translate schinese ep3_lunch_bella_label_246fedd8:

    # isa "Share it with me and I'll share something about Derek's reputation."
    isa "与我分享，我将分享一些有关Derek声誉的信息。"

# game/update3.rpy:3314
translate schinese ep3_lunch_bella_label_dae2a33b:

    # mc "Manipulation, huh? That's my kind of girl."
    mc "操纵，是吗？这就是我喜欢的女孩。"

# game/update3.rpy:3321
translate schinese ep3_zoey_label_21ea87dc:

    # mc "{i}Um...well...{/i}"
    mc "{i}嗯……好吧……{/i}"

# game/update3.rpy:3322
translate schinese ep3_zoey_label_e139270f:

    # mc "{i}When I was young, I had some really rough years.{/i}"
    mc "{i}当我年轻的时候，我度过了一些非常艰难的岁月。{/i}"

# game/update3.rpy:3323
translate schinese ep3_zoey_label_25fc7765:

    # mc "{i}School wasn't very fun for me. I didn't have any friends and kids picked on me...a lot.{/i}"
    mc "{i}学校对我来说不是很有趣。我没有任何朋友和孩子欺负我......很多。{/i}"

# game/update3.rpy:3324
translate schinese ep3_zoey_label_43330850:

    # isa "What for?"
    isa "做什么的？"

# game/update3.rpy:3325
translate schinese ep3_zoey_label_b378d850:

    # mc "{i}You know...for being poor, not having the newest sneakers...oh...and, of course, for not having a mom.{/i}"
    mc "{i}你知道……因为贫穷，没有最新的运动鞋……哦……当然，因为没有妈妈。{/i}"

# game/update3.rpy:3327
translate schinese ep3_zoey_label_36687324:

    # mc "{i}My dad was worried about me after I came home one day from school...with bruises all over my arms.{/i}"
    mc "{i}有一天我放学回家后，我爸爸很担心我......我的手臂上全是瘀伤。{/i}"

# game/update3.rpy:3329
translate schinese ep3_zoey_label_cb4fe5f6:

    # mc "{i}The cool kids at school had this stupid challenge to see how many times they could punch me before I reacted.{/i}"
    mc "{i}学校里很酷的孩子们做了一个愚蠢的挑战，看看他们能在我反应之前打我多少次。{/i}"

# game/update3.rpy:3330
translate schinese ep3_zoey_label_062db86c:

    # mc "{i}I was known as the kid who just sat there... I learned to take their insults and just ignore them...{/i}"
    mc "{i}I 被称为只是坐在那里的孩子……我学会了接受他们的侮辱并忽略他们……{/i}"

# game/update3.rpy:3331
translate schinese ep3_zoey_label_ec1ce461:

    # mc "{i}They didn't like that.{/i}"
    mc "{i}他们不喜欢这样。{/i}"

# game/update3.rpy:3333
translate schinese ep3_zoey_label_e5262d32:

    # mc "{i}After that, dad taught me how to fight...well, he taught himself, too.{/i}"
    mc "{i}之后，爸爸教我如何战斗……嗯，他也自学了。{/i}"

# game/update3.rpy:3334
translate schinese ep3_zoey_label_d9af6f63:

    # mc "{i}He had never done it before and he could barely afford the training gear.{/i}"
    mc "{i}他以前从未做过，而且他几乎买不起训练装备。{/i}"

# game/update3.rpy:3335
translate schinese ep3_zoey_label_b6813dab:

    # mc "{i}His usual hobbies were a bit less action-filled...{/i}"
    mc "{i}H平时的爱好比较少动感……{/i}"

# game/update3.rpy:3336
translate schinese ep3_zoey_label_76059f31:

    # mc "{i}Like solving crossword puzzles, meditation, collecting stamps and coins, reading and of course...home improvement.{/i}"
    mc "{i}喜欢解决填字游戏、冥想、收集邮票和硬币、阅读，当然还有......家居装修。{/i}"

# game/update3.rpy:3337
translate schinese ep3_zoey_label_b6b57aa9:

    # mc "{i}You see, he's a carpenter, so he really enjoys that sort of thing.{/i}"
    mc "{i}你看，他是个木匠，所以他很喜欢这种事情。{/i}"

# game/update3.rpy:3339
translate schinese ep3_zoey_label_edf8bdd1:

    # mc "{i}We practiced almost daily and I could feel how I got a real confidence boost from it.{/i}"
    mc "{i}我们几乎每天都练习，我能感觉到我从中得到了真正的信心提升。{/i}"

# game/update3.rpy:3340
translate schinese ep3_zoey_label_ddf2a82b:

    # mc "{i}Dad made me promise to never use what he taught me for anything other than self-defense.{/i}"
    mc "{i}Dad让我承诺，除了自卫，他教我什么都不用。{/i}"

# game/update3.rpy:3341
translate schinese ep3_zoey_label_b514e810:

    # mc "{i}I guess by doing that he imparted good morals and to not become a bully myself.{/i}"
    mc "{i}我想他这样做是为了传授良好的道德，让自己不成为恶霸。{/i}"

# game/update3.rpy:3342
translate schinese ep3_zoey_label_9ac2ef90:

    # mc "{i}For me, training was a great way to bond with my dad. I never wanted to fight anyone.{/i}"
    mc "{i}对我来说，训练是与父亲建立联系的好方法。我从来不想和任何人打架。{/i}"

# game/update3.rpy:3344
translate schinese ep3_zoey_label_cdbb4b48:

    # mc "{i}Until one day...when I didn't have a choice.{/i}"
    mc "{i}直到有一天……当我别无选择时。{/i}"

# game/update3.rpy:3345
translate schinese ep3_zoey_label_45878e08:

    # mc "{i}I could sense how that punch was coming my way.{/i}"
    mc "{i}I能感觉到那一拳是如何向我袭来的。{/i}"

# game/update3.rpy:3348
translate schinese ep3_zoey_label_9eb0adf0:

    # mc "{i}But the boy throwing it never saw mine coming right back at him.{/i}"
    mc "{i}但扔它的男孩从来没有看见我的直接回到他身边。{/i}"

# game/update3.rpy:3349
translate schinese ep3_zoey_label_9f1f66d7:

    # mc "{i}In self-defense, I beat him.{/i}"
    mc "{i}出于自卫，我打败了他。{/i}"

# game/update3.rpy:3351
translate schinese ep3_zoey_label_21856c61:

    # mc "{i}I beat him so hard that my fists got blood all over them.{/i}"
    mc "{i}我把他打得拳头都沾满了血。{/i}"

# game/update3.rpy:3352
translate schinese ep3_zoey_label_15d5ce21:

    # mc "{i}The other kids did nothing. They just stood there on the sidelines and stared.{/i}"
    mc "{i}其他孩子什么也没做。他们只是站在一旁看着。{/i}"

# game/update3.rpy:3353
translate schinese ep3_zoey_label_be9ad3ad:

    # mc "{i}They watched me hit their friend. Repeatedly.{/i}"
    mc "{i}他们看着我打他们的朋友。反复.{/i}"

# game/update3.rpy:3355
translate schinese ep3_zoey_label_2b761563:

    # mc "{i}Until eventually a teacher came and broke it up.{/i}"
    mc "{i}直到最后老师来了才把它拆散。{/i}"

# game/update3.rpy:3356
translate schinese ep3_zoey_label_c1f5d85c:

    # mc "{i}You think that a teacher would side with the victim.{/i}"
    mc "{i}你认为老师会站在受害者一边。{/i}"

# game/update3.rpy:3357
translate schinese ep3_zoey_label_0f01dde4:

    # mc "{i}But when there are so many voices against one...{/i}"
    mc "{i}但当有这么多声音反对一个……{/i}"

# game/update3.rpy:3358
translate schinese ep3_zoey_label_85bd3f9e:

    # mc "{i}...it's hard to make yours heard.{/i}"
    mc "{i}……很难让你的声音被听到。{/i}"

# game/update3.rpy:3360
translate schinese ep3_zoey_label_06a238ee:

    # mc "{i}Apparently, I wasn't the victim.{/i}"
    mc "{i}显然，我不是受害者。{/i}"

# game/update3.rpy:3361
translate schinese ep3_zoey_label_04eac254:

    # mc "{i}The parents of the boy I beat up wanted to press charges against my dad for teaching me how to fight.{/i}"
    mc "{i}被我殴打的男孩的父母想控告我爸爸教我如何打架。{/i}"

# game/update3.rpy:3362
translate schinese ep3_zoey_label_c0619ba3:

    # mc "{i}Luckily for me and my dad, they never did.{/i}"
    mc "{i}幸运的是我和我爸爸，他们从来没有这样做过。{/i}"

# game/update3.rpy:3363
translate schinese ep3_zoey_label_baddd76c:

    # mc "{i}I was even lucky enough to not be sent to juvenile hall.{/i}"
    mc "{i}I还幸运地没有被送进少年管教所。{/i}"

# game/update3.rpy:3365
translate schinese ep3_zoey_label_4608ffa7:

    # mc "{i}But I got my punishment for standing up for myself. Detention.{/i}"
    mc "{i}但我因为为自己挺身而出而受到惩罚。Detention.{/i}"

# game/update3.rpy:3366
translate schinese ep3_zoey_label_83e01ec6:

    # mc "{i}Every day for two whole months.{/i}"
    mc "{i}整整两个月的每一天。{/i}"

# game/update3.rpy:3367
