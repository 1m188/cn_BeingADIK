translate schinese fr_ep1_call_josy_8a6ae5f0:

    # js "Would you give that up for me?"
    js "你愿意为我放弃这些吗？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:366
translate schinese fr_ep1_call_josy_910463b5:

    # mc "In a heartbeat."
    mc "毫不犹豫。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:368
translate schinese fr_ep1_call_josy_d09f3513:

    # mc "It's no problem."
    mc "这没什么。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:370
translate schinese fr_ep1_call_josy_a6a0a4c1:

    # js "Ok. See you Saturday...or Sunday?"
