translate schinese fr_ep1_mc_dorm_hall_label_nofx_8912ce23:

    # de "Hey dude! What's up!?"
    de "嘿，兄弟！怎么样！？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:429
translate schinese fr_ep1_mc_dorm_hall_label_nofx_abc56cb3:

