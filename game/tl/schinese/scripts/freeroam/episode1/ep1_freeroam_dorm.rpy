translate schinese fr_ep1_call_josy_5e7e3922:

    # js "Bye..."
    js "再见……"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:374
translate schinese fr_ep1_call_josy_c176fe74:

    # js "(What am I doing?)"
    js "（我到底在做什么？）"

