translate schinese fr_ep1_mc_dorm_hall_label_nofx_097c017b:

    # de "Cheat? ME!? HAHA! Well, I'd never-"
    de "作弊？我！？哈哈！我可从来不会——"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:505
translate schinese fr_ep1_mc_dorm_hall_label_nofx_fe300436:

    # de "Look, dude, trust me. I have some pointers for you..."
    de "听着，兄弟，相信我。我有几招可以教你……"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:506
translate schinese fr_ep1_mc_dorm_hall_label_nofx_72b12ece:

    # de "...not for free, of course; a dude gotta eat."
    de "……当然不是免费的，兄弟也得吃饭啊。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:510
translate schinese fr_ep1_mc_dorm_hall_label_nofx_2933650c:

    # mc "Thanks, but I don't need any help with that."
    mc "谢了，不过我不需要。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:512
translate schinese fr_ep1_mc_dorm_hall_label_nofx_04add7b1:

    # de "Ok, that's cool."
    de "行，没问题。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:532
translate schinese fr_ep1_mc_dorm_hall_label_nofx_cfcd38d7:

    # de "Hey! So, what will it be?"
    de "嘿！那你想好了吗？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:535
translate schinese fr_ep1_mc_dorm_hall_label_nofx_2a506dc4:

    # de "Let me know if you change your mind."
    de "改变主意了就告诉我。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:549
translate schinese d1_de_talk_09c186c4:

    # de "Hehe, say no more, so here's what you have to do...{w=3}{nw}"
    de "嘿嘿，不用多说，你要做的是……{w=3}{nw}"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:558
translate schinese d1_de_afterloop_3d2d539b:

    # de "Just hit me up if you want to buy something."
    de "想买什么随时找我。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:569
translate schinese fr_ep1_mc_dorm_hall2_label_678ad713:

    # stu "Come on! You stupid machine!"
    stu "拜托！你这破机器！"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:583
translate schinese fr_ep1_mc_dorm_hall2_label_b4177ab6:

    # mc "I hate when that happens."
    mc "我最讨厌这种事了。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:585
translate schinese fr_ep1_mc_dorm_hall2_label_2149067c:

    # stu "When what happens?"
    stu "什么事？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:587
translate schinese fr_ep1_mc_dorm_hall2_label_95fbf4b8:

    # mc "When it steals your money."
    mc "它吞了你的钱。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:589
translate schinese fr_ep1_mc_dorm_hall2_label_97366fb5:

    # stu "Yeah, that's not what this is."
    stu "嗯，这次不是那么回事。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:597
translate schinese fr_ep1_mc_dorm_hall2_label_7a56fbd2:

    # mc "I'll buy a soda for you."
    mc "我给你买瓶汽水吧。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:600
translate schinese fr_ep1_mc_dorm_hall2_label_08ad240c:

    # mc "Here you go."
    mc "给你。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:602
translate schinese fr_ep1_mc_dorm_hall2_label_d6aacadb:

    # stu "Really? Thanks man!"
    stu "真的吗？谢了兄弟！"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:603
translate schinese fr_ep1_mc_dorm_hall2_label_b05df31c:

    # stu "Now I only need some chips and I'm in business."
    stu "现在再来点薯片就成了。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:608
translate schinese fr_ep1_mc_dorm_hall2_label_86d22e93:

    # mc "Good luck with the petty theft, then."
    mc "那祝你小偷小摸顺利。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:610
translate schinese fr_ep1_mc_dorm_hall2_label_52e0d325:

    # mc "Best of luck to whatever it is you're doing, then."
    mc "那就祝你正在做的事顺利。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:612
translate schinese fr_ep1_mc_dorm_hall2_label_43ebbc56:

