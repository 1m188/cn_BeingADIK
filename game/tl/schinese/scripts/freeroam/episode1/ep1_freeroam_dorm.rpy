# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:353
translate schinese fr_ep1_call_josy_a15078e5:

    # mc "...it feels weird."
    mc "……这让我心里挺不是滋味的。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:355
translate schinese fr_ep1_call_josy_fd859c00:

    # js "I just...feel like I need to get away for a while."
    js "我只是……觉得需要离开一阵子。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:356
translate schinese fr_ep1_call_josy_daa54275:

    # js "It's been tough lately..."
    js "最近真的很难熬……"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:358
translate schinese fr_ep1_call_josy_5af28c82:

    # mc "How about I come back home this weekend?"
    mc "我这周末回家看你怎么样？"

