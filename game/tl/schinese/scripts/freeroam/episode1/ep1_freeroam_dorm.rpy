translate schinese fr_ep1_mc_dorm_hall_label_nofx_8d6c5a57:

    # de "What are you doing?"
    de "你在干嘛？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:466
translate schinese fr_ep1_mc_dorm_hall_label_nofx_65faf43d:

    # mc "I was looking for your tinfoil hat, where did you last see it?"
    mc "我在找你的锡纸帽，你最后把它放哪儿了？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:468
translate schinese fr_ep1_mc_dorm_hall_label_nofx_5b034af0:

    # de "Haha! Fuck off! I'm not bullshitting you!"
    de "哈哈！滚蛋！我可没跟你胡扯！"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:470
translate schinese fr_ep1_mc_dorm_hall_label_nofx_69b9bc44:

    # mc "Maybe because they are wearing clothes while you walk around half-naked."
    mc "也许是因为人家穿着衣服，而你半裸着到处晃。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:471
translate schinese fr_ep1_mc_dorm_hall_label_nofx_69da384b:

    # mc "Seriously, do you even have a spare T-shirt? I can give you one of mine."
    mc "说真的，你有备用的 T 恤吗？我可以给你一件我的。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:473
translate schinese fr_ep1_mc_dorm_hall_label_nofx_5b034af0_1:

    # de "Haha! Fuck off! I'm not bullshitting you!"
    de "哈哈！滚蛋！我可没跟你胡扯！"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:475
translate schinese fr_ep1_mc_dorm_hall_label_nofx_9a8647f8:

    # mc "If you say so. Good luck with that!"
    mc "既然你这么说。祝你好运！"

