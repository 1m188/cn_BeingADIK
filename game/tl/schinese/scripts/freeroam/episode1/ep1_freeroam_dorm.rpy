translate schinese fr_ep1_mc_dorm_hall_label_nofx_333ce8fc:

    # de "How did the English test go?"
    de "英语测验考得怎么样？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:482
translate schinese fr_ep1_mc_dorm_hall_label_nofx_3d2f9bae:

    # mc "I did ok."
    mc "还行。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:484
translate schinese fr_ep1_mc_dorm_hall_label_nofx_97691623:

    # mc "I'm sure I passed it...with some tricks..."
    mc "我肯定能过……用了点小手段……"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:486
translate schinese fr_ep1_mc_dorm_hall_label_nofx_609def45:

    # mc "Pretty good. I'm sure I passed it."
    mc "挺好的，我肯定过了。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:488
translate schinese fr_ep1_mc_dorm_hall_label_nofx_30adc349:

    # mc "Not so good. I'm pretty sure I failed."
    mc "不太好，我很可能没及格。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:491
translate schinese fr_ep1_mc_dorm_hall_label_nofx_1da378bb:

    # de "I could spot you cheating from where I was sitting, dude."
    de "兄弟，我坐那儿都能看见你作弊。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:492
translate schinese fr_ep1_mc_dorm_hall_label_nofx_9e8208d3:

    # de "You need to get smarter with that."
    de "你得学聪明点。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:494
translate schinese fr_ep1_mc_dorm_hall_label_nofx_ae3831a5:

    # de "Tests don't have to be that hard, you know."
    de "考试也不必那么难，你知道吗。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:495
translate schinese fr_ep1_mc_dorm_hall_label_nofx_27b9e58f:

    # de "If you want, I can give you some pointers to \"pass\" tests easier."
    de "如果你想，我可以给你几招，让你更轻松地「通过」考试。"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:497
translate schinese fr_ep1_mc_dorm_hall_label_nofx_064c5a96:

    # mc "Why are you saying it like that?"
    mc "你为什么要这么措辞？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:499
translate schinese fr_ep1_mc_dorm_hall_label_nofx_25716dad:

    # de "Like how?"
    de "怎么措辞？"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:501
translate schinese fr_ep1_mc_dorm_hall_label_nofx_071eb1bf:

    # mc "Oh, you mean you want to teach me how to cheat."
    mc "哦，你是想教我怎么作弊。"

