translate schinese fr_ep1_call_josy_30ec3da8:

    # js "This weekend? It's your first weekend in college!"
    js "这周末？这可是你大学的第一个周末！"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:361
translate schinese fr_ep1_call_josy_c9f4abf3:

    # js "You should be partying!"
    js "你该去参加派对才对！"

