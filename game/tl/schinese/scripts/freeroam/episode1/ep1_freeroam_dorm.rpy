translate schinese fr_ep1_mc_dorm_hall_label_nofx_e1661ab6:

    # de "Thanks!"
    de "谢啦！"

# game/scripts/freeroam/episode1/ep1_freeroam_dorm.rpy:478
translate schinese fr_ep1_mc_dorm_hall_label_nofx_31b5c080:

    # de "But enough about that..."
    de "不过先不说这个了……"

