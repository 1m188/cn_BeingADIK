translate schinese ep4_fr_diks_rusty_label_4754c994:

    # rs "Just don't mention I told you this."
    rs "别跟人说是我告诉你的就行。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1160
translate schinese ep4_fr_diks_rusty_label_084884dd:

    # mc "Do you really think Cathy will force you to resign as president?"
    mc "你真觉得 Cathy 会逼你辞掉社长？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1162
translate schinese ep4_fr_diks_rusty_label_247dd290:

    # rs "Cathy is a reasonable woman..."
    rs "Cathy 是个通情达理的女人……"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1163
translate schinese ep4_fr_diks_rusty_label_167db860:

    # rs "...but I've never seen this happen before to any teacher."
    rs "……但我从没见过哪位老师出过这种事。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1164
translate schinese ep4_fr_diks_rusty_label_f1ce681b:

    # rs "Being who I am has put me on her good side, but this will undoubtedly affect that."
    rs "我的身份让我一直很得她好感，但这件事无疑会影响这一点。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1166
translate schinese ep4_fr_diks_rusty_label_07ae176e:

    # mc "Being a president doesn't seem to matter with them, as far as I know."
    mc "据我所知，社长这个头衔在他们那儿好像没什么用。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1167
translate schinese ep4_fr_diks_rusty_label_b9e80341:

    # mc "To me, they made it pretty clear that they don't make any exceptions."
    mc "在我看来，他们已经说得很清楚，不会有任何例外。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1169
translate schinese ep4_fr_diks_rusty_label_64394a63:

    # rs "I wasn't talking about the presidential title..."
    rs "我说的不是社长这个头衔……"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1171
translate schinese ep4_fr_diks_rusty_label_253c63fa:

    # mc "Then what is putting you on her good side?"
    mc "那是什么让你一直得她好感？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1173
translate schinese ep4_fr_diks_rusty_label_8a4774f4:

    # rs "Well, you know me as Rusty, right?"
    rs "嗯，你认识的我叫 Rusty，对吧？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1174
translate schinese ep4_fr_diks_rusty_label_6053e7c1:

    # rs "My legal name is Russell Burgmeister."
    rs "我的法定名字是 Russell Burgmeister。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1176
translate schinese ep4_fr_diks_rusty_label_806cc87d:

    # mc "Burgmeister? As in Burgmeister & Royce?"
    mc "Burgmeister？就是 Burgmeister & Royce 的那个？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1178
translate schinese ep4_fr_diks_rusty_label_49392517:

    # rs "Yeah, that's the one."
    rs "嗯，就是那个。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1180
translate schinese ep4_fr_diks_rusty_label_18f8a524:

    # mc "I have so many questions right now."
    mc "我现在有一肚子问题。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1182
translate schinese ep4_fr_diks_rusty_label_feecca3d:

    # rs "Another time, [name]. I've gotta deal with this problem."
    rs "改天吧，[name]。我得先处理这个麻烦。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1183
translate schinese ep4_fr_diks_rusty_label_b202b008:

    # rs "Also, leave the whole Rooster drama to me."
    rs "还有，Rooster 这摊破事交给我。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1185
translate schinese ep4_fr_diks_rusty_label_5c0c7694:

    # rs "Don't let it ruin your Hell Week."
    rs "别让它毁了你的地狱周。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1187
translate schinese ep4_fr_diks_rusty_label_f16c798b:

    # mc "If you say so."
    mc "既然你这么说。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1188
translate schinese ep4_fr_diks_rusty_label_828be942:

    # mc "And hey...thanks for telling me things. I appreciate that."
    mc "还有嘿……谢谢你告诉我这些。我很感激。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1190
translate schinese ep4_fr_diks_rusty_label_2b8e10cc:

    # rs "Don't mention it."
    rs "别客气。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1200
translate schinese ep4_fr_diks_melanie_label_36e62b1f:

    # sar "Hey! [name]! Was it you?"
    sar "嘿！[name]！是你干的吗？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1202
translate schinese ep4_fr_diks_melanie_label_54696dae:

    # mc "What did I do?"
    mc "我干了什么？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1204
translate schinese ep4_fr_diks_melanie_label_7b411967:

    # sar "Cut the act! Admit that it was you."
    sar "别装了！承认是你干的。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1206
translate schinese ep4_fr_diks_melanie_label_1b9e82e9:

    # mc "I don't know what you're talking about."
    mc "我不知道你在说什么。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1208
translate schinese ep4_fr_diks_melanie_label_69407c8b:

    # ml "The Cathy cluck. You're the one who posted it, right?"
    ml "Cathy 那条动态。是你发的，对吧？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1213
translate schinese ep4_fr_diks_melanie_label_45ccf406:

    # mc "Why would you think that?"
    mc "你为什么这么想？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1215
translate schinese ep4_fr_diks_melanie_label_5fbe3396:

    # sar "When I saw that pic, I thought to myself..."
    sar "我看到那张照片时，心里就在想……"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1216
translate schinese ep4_fr_diks_melanie_label_ed49a67d:

    # sar "...man, what a pervert who took that shot."
    sar "……拍那张照片的人真是个变态。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1217
translate schinese ep4_fr_diks_melanie_label_dcd641fb:

    # sar "Can you see where my mind went from that?"
    sar "你能想到我接着想到谁了吧？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1221
translate schinese ep4_fr_diks_melanie_label_4697bcd4:

    # mc "Good one. It wasn't me, though."
    mc "说得挺妙。不过不是我。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1225
translate schinese ep4_fr_diks_melanie_label_3043d2df:

    # mc "Eat shit, Sarah."
    mc "去吃屎吧，Sarah。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1227
translate schinese ep4_fr_diks_melanie_label_360e844a:

    # sar "You're so sensitive. Jeez!"
    sar "你也太敏感了。天哪！"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1232
translate schinese ep4_fr_diks_melanie_label_09dda0b3:

    # ml "What a bore..."
    ml "真没劲……"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1233
translate schinese ep4_fr_diks_melanie_label_26570a6f:

    # ml "Who did it, then?"
    ml "那是谁干的？"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1235
translate schinese ep4_fr_diks_melanie_label_65736b6d:

    # mc "I don't know, but I wanna help find out."
    mc "我不知道，但我想帮忙查清楚。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1237
translate schinese ep4_fr_diks_melanie_label_85028c80:

    # ml "Someone here must have seen something."
    ml "这儿肯定有人看到了什么。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1238
translate schinese ep4_fr_diks_melanie_label_75dc5f47:

    # ml "Let us know if you hear any gossip."
    ml "听到什么风声就告诉我们。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1241
translate schinese ep4_fr_diks_melanie_label_1b2b6983:

    # mc "No, it wasn't and I'm not gonna talk about that with you."
    mc "不，不是我，而且我也不会跟你谈这个。"

# game/scripts/freeroam/episode4/ep4_freeroam_diks.rpy:1243
translate schinese ep4_fr_diks_melanie_label_4aa3cb94:

    # sar "You're so boring!"
    sar "你真无趣！"

