# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1001
translate schinese fr_ep4_call_sage_e36bf5d5:

    # sa "Hey! What's up?"
    sa "嘿！怎么了？"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1003
translate schinese fr_ep4_call_sage_8e4aba2f:

    # mc "Not much. I just needed a distraction."
    mc "没什么。我只是想分散一下注意力。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1005
translate schinese fr_ep4_call_sage_9a266898:

    # sa "For what? Did something happen?"
    sa "分散什么？出什么事了？"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1007
translate schinese fr_ep4_call_sage_27acdcf1:

    # mc "Kind of..."
    mc "算是吧……"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1008
translate schinese fr_ep4_call_sage_6f27c6d3:

    # mc "I used to stay with Maya in her dorm, you know..."
    mc "我以前跟 Maya 一起住在她宿舍，你知道的……"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1009
translate schinese fr_ep4_call_sage_31e5aeeb:

    # mc "...but we had a fight and now I'm staying with a friend."
    mc "……但我们吵了一架，现在我住在一个朋友那儿。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1011
translate schinese fr_ep4_call_sage_fb12aa41:

    # sa "I've been in a lot of fights lately myself, so I know how much that sucks."
    sa "我最近也吵了不少架，所以我知道那有多难受。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1012
translate schinese fr_ep4_call_sage_c2695b8c:

    # sa "Do you need a shoulder to cry on?"
    sa "需要借个肩膀哭吗？"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1014
translate schinese fr_ep4_call_sage_906dc89e:

    # mc "Haha... No, I don't feel like crying over it."
    mc "哈哈……不，我还没想为这个哭。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1016
translate schinese fr_ep4_call_sage_90793d12:

    # sa "How about a boob to cry on?"
    sa "那借个胸脯哭呢？"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1018
translate schinese fr_ep4_call_sage_eeba7f92:

    # mc "Suddenly I feel like crying."
    mc "我突然有点想哭了。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1020
translate schinese fr_ep4_call_sage_1d38a0fc:

    # sa "Haha! Great! What kind of a fuck buddy would I be if I didn't let you do that?"
    sa "哈哈！太好了！要是不让你这样，我还算什么炮友？"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1022
translate schinese fr_ep4_call_sage_8bf942eb:

    # mc "Fuck buddy? Are you on board?"
    mc "炮友？你答应了？"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1024
translate schinese fr_ep4_call_sage_70b303b6:

    # sa "Yeah, I made up my mind."
    sa "嗯，我想好了。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1025
translate schinese fr_ep4_call_sage_2dae58ad:

    # sa "Hey, I know what will cheer you up."
    sa "嘿，我知道什么能让你开心起来。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1026
translate schinese fr_ep4_call_sage_082d69c8:

    # sa "We're having a movie night tonight. You should come."
    sa "我们今晚有电影之夜。你也来吧。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1027
translate schinese fr_ep4_call_sage_c8935c6f:

    # sa "It will just be us girls. We could drink and relax."
    sa "就我们几个女生。可以喝点酒放松一下。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1029
translate schinese fr_ep4_call_sage_1b2d1ee7:

    # mc "The pledges won't be there, right?"
    mc "那几个预备会员不会在吧？"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1031
translate schinese fr_ep4_call_sage_7a87b370:

    # sa "Actually...they will, but you know what? I'll try to cancel."
    sa "其实……他们会在，不过我跟你说，我会尽量取消的。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1033
translate schinese fr_ep4_call_sage_15da19df:

    # mc "You don't need to do that for me."
    mc "你不必为我这么做。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1035
translate schinese fr_ep4_call_sage_7f05a8e9:

    # sa "It's cool. Just drop by later tonight if you're up for it."
    sa "没关系的。今晚晚点想来就来吧。"

# game/scripts/freeroam/episode4/ep4_freeroam_derek.rpy:1037
translate schinese fr_ep4_call_sage_6f15e6c2:

    # mc "All right. I'll let you know. Bye."
    mc "好。到时我告诉你。再见。"

