# game/scripts/episode4/ep4_derek_route.rpy:6
translate schinese ep4_night_talk_derek_label_1f0db9ed:

    # de "Here you go, [mc_de]."
    de "给你，[mc_de]。"

# game/scripts/episode4/ep4_derek_route.rpy:8
translate schinese ep4_night_talk_derek_label_4763baca:

    # mc "What the hell is this?"
    mc "这他妈是什么？"

# game/scripts/episode4/ep4_derek_route.rpy:10
translate schinese ep4_night_talk_derek_label_9a72914c:

    # de "When you're feeling upset, you should drink something warm."
    de "心情不好的时候，该喝点热的东西。"

# game/scripts/episode4/ep4_derek_route.rpy:12
translate schinese ep4_night_talk_derek_label_1feff548:

    # mc "But...why are there lumps in it?"
    mc "可……里面为什么有疙瘩？"

# game/scripts/episode4/ep4_derek_route.rpy:14
translate schinese ep4_night_talk_derek_label_880fd996:

    # de "It's ramen noodle water..."
    de "是泡面汤……"

# game/scripts/episode4/ep4_derek_route.rpy:15
translate schinese ep4_night_talk_derek_label_b67ac0d5:

    # de "Sorry, I don't have any tea."
    de "抱歉，我没有茶叶。"

# game/scripts/episode4/ep4_derek_route.rpy:16
translate schinese ep4_night_talk_derek_label_35475ae5:

    # de "I can warm you a beer if you want that instead?"
    de "要不我给你温一瓶啤酒？"

# game/scripts/episode4/ep4_derek_route.rpy:18
translate schinese ep4_night_talk_derek_label_2807e240:

    # mc "I'd rather have a cold one."
    mc "我宁愿喝冰的。"

# game/scripts/episode4/ep4_derek_route.rpy:20
translate schinese ep4_night_talk_derek_label_523c7c31:

    # be "Hey, keep it down! I'm trying to sleep over here."
    be "嘿，小声点！我这正睡觉呢。"

# game/scripts/episode4/ep4_derek_route.rpy:22
translate schinese ep4_night_talk_derek_label_a68b25de:

    # de "Shut up, Bert! My brother needs me!"
    de "闭嘴，Bert！我兄弟需要我！"

# game/scripts/episode4/ep4_derek_route.rpy:23
translate schinese ep4_night_talk_derek_label_27c7553d:

    # de "Go find some earplugs or sleep in the corridor!"
    de "去找副耳塞，或者睡走廊去！"

# game/scripts/episode4/ep4_derek_route.rpy:25
translate schinese ep4_night_talk_derek_label_f0037478:

    # be "It's always something with you, isn't it!?"
    be "你这人怎么老有事，是吧！？"

# game/scripts/episode4/ep4_derek_route.rpy:27
translate schinese ep4_night_talk_derek_label_f2f070fe:

    # de "Excuse me for having a life, Bert!"
    de "抱歉啊 Bert，我也有自己的生活！"

# game/scripts/episode4/ep4_derek_route.rpy:28
translate schinese ep4_night_talk_derek_label_64f2a824:

    # de "Not everyone goes to college to study!"
    de "不是人人都上大学只为读书的！"

# game/scripts/episode4/ep4_derek_route.rpy:30
translate schinese ep4_night_talk_derek_label_d94e3287:

    # de "So...what's up with you?"
    de "那么……你怎么了？"

# game/scripts/episode4/ep4_derek_route.rpy:31
translate schinese ep4_night_talk_derek_label_2b35b6fe:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_derek_route.rpy:33
translate schinese ep4_night_talk_derek_label_599f724d:

    # mc "It's Josy."
    mc "是 Josy。"

# game/scripts/episode4/ep4_derek_route.rpy:35
translate schinese ep4_night_talk_derek_label_b76e9862:

    # de "Josy?"
    de "Josy？"

# game/scripts/episode4/ep4_derek_route.rpy:37
translate schinese ep4_night_talk_derek_label_806b79de:

    # mc "Your sister...her girlfriend is Josy."
    mc "你妹妹……她女朋友是 Josy。"

# game/scripts/episode4/ep4_derek_route.rpy:39
translate schinese ep4_night_talk_derek_label_939f2bdf:

    # de "She...told you that? Wow..."
    de "她……告诉你了？哇……"

# game/scripts/episode4/ep4_derek_route.rpy:40
translate schinese ep4_night_talk_derek_label_d5fe9a59:

    # de "Yeah...that's what I've been bugged about..."
    de "嗯……我一直为这事烦着呢……"

# game/scripts/episode4/ep4_derek_route.rpy:41
translate schinese ep4_night_talk_derek_label_5b0fab05:

    # de "I couldn't tell you... I mean, you're my maggot brother and all, but we just kinda met."
    de "我不能告诉你……我是说，你虽然是我的菜鸟兄弟，但我们毕竟才认识。"

# game/scripts/episode4/ep4_derek_route.rpy:42
translate schinese ep4_night_talk_derek_label_db972ab2:

    # de "She's in a..."
    de "她在……"

# game/scripts/episode4/ep4_derek_route.rpy:44
translate schinese ep4_night_talk_derek_label_2a833781:

    # de "...this kind of a relationship."
    de "……这样一种关系里。"

# game/scripts/episode4/ep4_derek_route.rpy:46
translate schinese ep4_night_talk_derek_label_9e5cf0e1:

    # de "How did you find out?"
    de "你怎么发现的？"

# game/scripts/episode4/ep4_derek_route.rpy:48
translate schinese ep4_night_talk_derek_label_a0327e29:

    # mc "Josy showed up...she's the girl I've been dating."
    mc "Josy 出现了……她就是我一直在约会的那个女孩。"

# game/scripts/episode4/ep4_derek_route.rpy:50
translate schinese ep4_night_talk_derek_label_384d2b2f:

    # de "Wait wait wait wait! Hold the FUCK up!"
    de "等等等等等等！他妈的给我打住！"

# game/scripts/episode4/ep4_derek_route.rpy:51
translate schinese ep4_night_talk_derek_label_bd7d1d85:

    # de "What!?"
    de "什么！？"

# game/scripts/episode4/ep4_derek_route.rpy:52
translate schinese ep4_night_talk_derek_label_a0d1e34c:

    # de "You need to tell me everything because this sounds fucking nuts!"
    de "你得把一切都告诉我，这听着太他妈疯狂了！"

# game/scripts/episode4/ep4_derek_route.rpy:54
translate schinese ep4_night_talk_derek_label_f3f0ab94:

    # de "What exactly happened last night?"
    de "昨晚到底发生了什么？"

# game/scripts/episode4/ep4_derek_route.rpy:60
translate schinese ep4_night_talk2_derek_label_738358ab:

    # de "I can't believe this..."
    de "我真不敢相信……"

# game/scripts/episode4/ep4_derek_route.rpy:62
translate schinese ep4_night_talk2_derek_label_2a014807:

    # mc "It's the truth."
    mc "这是事实。"

# game/scripts/episode4/ep4_derek_route.rpy:64
translate schinese ep4_night_talk2_derek_label_b7d8914b:

    # de "How do you feel?"
    de "你感觉怎么样？"

# game/scripts/episode4/ep4_derek_route.rpy:66
translate schinese ep4_night_talk2_derek_label_e51b4f61:

    # mc "Hurt...betrayed...kind of..."
    mc "受伤……被背叛……有点吧……"

# game/scripts/episode4/ep4_derek_route.rpy:67
translate schinese ep4_night_talk2_derek_label_a098dde2:

    # mc "I don't know... Do you think I overreacted by storming out like that?"
    mc "我不知道……你觉得我那样冲出去，是不是反应过度了？"

# game/scripts/episode4/ep4_derek_route.rpy:69
translate schinese ep4_night_talk2_derek_label_ea9ba20c:

    # de "You are a bit of a drama queen; I'll give you that."
    de "你有点戏精，这一点我承认。"

# game/scripts/episode4/ep4_derek_route.rpy:71
translate schinese ep4_night_talk2_derek_label_701d2464:

    # mc "What!?"
    mc "什么！？"

# game/scripts/episode4/ep4_derek_route.rpy:73
translate schinese ep4_night_talk2_derek_label_f20a9334:

    # de "Come on! You know you are!"
    de "拜托！你自己知道的！"

# game/scripts/episode4/ep4_derek_route.rpy:74
translate schinese ep4_night_talk2_derek_label_20c5d042:

    # de "You cry when you get locked out of your dorm by Troy..."
    de "被 Troy 锁在宿舍外，你哭……"

# game/scripts/episode4/ep4_derek_route.rpy:75
translate schinese ep4_night_talk2_derek_label_008773a9:

    # de "You cry when the DIKs let you roam naked on campus..."
    de "DIK 让你光着在校园里走，你哭……"

# game/scripts/episode4/ep4_derek_route.rpy:76
translate schinese ep4_night_talk2_derek_label_d14d957a:

    # de "You wanted to leave and go back home when you just got here..."
    de "你刚到这儿就想收拾东西回家……"

# game/scripts/episode4/ep4_derek_route.rpy:77
translate schinese ep4_night_talk2_derek_label_62bb3271:

    # de "You cry when Stanley threw you out..."
    de "被 Stanley 赶出来，你哭……"

# game/scripts/episode4/ep4_derek_route.rpy:79
translate schinese ep4_night_talk2_derek_label_0abfd03f:

    # mc "Wait...what? Stanley threw me out?"
    mc "等等……什么？Stanley 把我赶出来了？"

# game/scripts/episode4/ep4_derek_route.rpy:81
translate schinese ep4_night_talk2_derek_label_7002d1c0:

    # de "Ahhh...I'm just saying that you're over-dramatic."
    de "啊……我只是说你太小题大做了。"

# game/scripts/episode4/ep4_derek_route.rpy:82
translate schinese ep4_night_talk2_derek_label_9c1237fa:

    # de "But it's fine!"
    de "不过没关系！"

# game/scripts/episode4/ep4_derek_route.rpy:84
translate schinese ep4_night_talk2_derek_label_d3338ae2:

    # de "You're a snowflake."
    de "你是一片雪花。"

# game/scripts/episode4/ep4_derek_route.rpy:85
translate schinese ep4_night_talk2_derek_label_29c1adeb:

    # de "A precious little snowflake."
    de "一片珍贵的小雪花。"

# game/scripts/episode4/ep4_derek_route.rpy:86
translate schinese ep4_night_talk2_derek_label_f954061b:

    # de "And that's ok."
    de "这没什么不好。"

# game/scripts/episode4/ep4_derek_route.rpy:90
translate schinese ep4_night_talk2_derek_label_c711e937:

    # mc "Ok... I'm a snowflake."
    mc "好吧……我是雪花。"

# game/scripts/episode4/ep4_derek_route.rpy:91
translate schinese ep4_night_talk2_derek_label_7444c020:

    # de "And I love you for it."
    de "而且我因此爱你。"

# game/scripts/episode4/ep4_derek_route.rpy:94
translate schinese ep4_night_talk2_derek_label_62ec3541:

    # mc "Fuck you."
    mc "去你的。"

# game/scripts/episode4/ep4_derek_route.rpy:95
translate schinese ep4_night_talk2_derek_label_57a1e132:

    # de "A snowflake with a potty mouth."
    de "一张脏嘴的雪花。"

# game/scripts/episode4/ep4_derek_route.rpy:100
translate schinese ep4_night_talk2_derek_label_4a3a99db:

    # de "Ouch!"
    de "哎哟！"

# game/scripts/episode4/ep4_derek_route.rpy:101
translate schinese ep4_night_talk2_derek_label_e441f87e:

    # de "That's a bad snowflake!"
    de "这是一片坏雪花！"

# game/scripts/episode4/ep4_derek_route.rpy:102
translate schinese ep4_night_talk2_derek_label_f69de428:

    # mc "Stop calling me that!"
    mc "别那么叫我！"

# game/scripts/episode4/ep4_derek_route.rpy:104
translate schinese ep4_night_talk2_derek_label_db64feb6:

    # de "All I'm saying is that you need to toughen up!"
    de "我只是说，你得坚强点！"

# game/scripts/episode4/ep4_derek_route.rpy:106
translate schinese ep4_night_talk2_derek_label_7ff73533:

    # mc "I'm tough! I know how to fight."
    mc "我很坚强！我会打架。"

# game/scripts/episode4/ep4_derek_route.rpy:108
translate schinese ep4_night_talk2_derek_label_35537294:

    # de "I didn't mean in a physical way."
    de "我不是说身体上的。"

# game/scripts/episode4/ep4_derek_route.rpy:110
translate schinese ep4_night_talk2_derek_label_16dbb827:

    # de "I was talking about the insides of the coconut that rests on your meaty neck."
    de "我说的是你那个肉脖子上那颗椰子脑袋的里面。"

# game/scripts/episode4/ep4_derek_route.rpy:112
translate schinese ep4_night_talk2_derek_label_badd6f3e:

    # de "Look at me! I'm tough as fuck."
    de "看看我！我他妈坚强得很。"

# game/scripts/episode4/ep4_derek_route.rpy:113
translate schinese ep4_night_talk2_derek_label_1727d46d:

    # de "Go ahead! Try to insult me."
    de "来啊！试着骂骂我。"

# game/scripts/episode4/ep4_derek_route.rpy:117
translate schinese ep4_night_talk2_derek_label_c6d7cec6:

    # mc "You look really stupid without a shirt."
    mc "你不穿上衣的样子蠢极了。"

# game/scripts/episode4/ep4_derek_route.rpy:119
translate schinese ep4_night_talk2_derek_label_c3b8ae4b:

    # de "*{i}Gasps{/i}* My emotions!"
    de "*{i}倒抽一口气{/i}* 我的感情受伤了！"

# game/scripts/episode4/ep4_derek_route.rpy:121
translate schinese ep4_night_talk2_derek_label_12beecea:

    # de "Come on. That was stupid."
    de "拜托。这话真没劲。"

# game/scripts/episode4/ep4_derek_route.rpy:124
translate schinese ep4_night_talk2_derek_label_bcb3a85e:

    # mc "You think you're good with women, but I see the way they look at you..."
    mc "你觉得自己很受女人欢迎，可我看到她们看你的眼神……"

# game/scripts/episode4/ep4_derek_route.rpy:125
translate schinese ep4_night_talk2_derek_label_37c4bcec:

    # mc "They are really not interested in you and you look like a moron when you're trying."
    mc "她们对你根本没兴趣，而且你努力搭讪的样子像个傻瓜。"

# game/scripts/episode4/ep4_derek_route.rpy:127
translate schinese ep4_night_talk2_derek_label_08f734e1:

    # de "You...bitch."
    de "你……混蛋。"

# game/scripts/episode4/ep4_derek_route.rpy:130
translate schinese ep4_night_talk2_derek_label_699878f6:

    # mc "Hey!"
    mc "嘿！"

# game/scripts/episode4/ep4_derek_route.rpy:141
translate schinese ep4_night_talk2_derek_label_24999a4f:

    # de "Aargh!!!"
    de "啊啊啊！！！"

# game/scripts/episode4/ep4_derek_route.rpy:142
translate schinese ep4_night_talk2_derek_label_246b4f11:

    # mc "Fuck you!!!"
    mc "去你的！！！"

# game/scripts/episode4/ep4_derek_route.rpy:143
translate schinese ep4_night_talk2_derek_label_45b73cea:

    # de "Take it back!"
    de "收回那句话！"

# game/scripts/episode4/ep4_derek_route.rpy:144
translate schinese ep4_night_talk2_derek_label_c9c26ede:

    # mc "NEVER!"
    mc "绝不！"

# game/scripts/episode4/ep4_derek_route.rpy:145
translate schinese ep4_night_talk2_derek_label_c52019d7:

    # de "Ok! Stop!"
    de "好！停！"

# game/scripts/episode4/ep4_derek_route.rpy:147
translate schinese ep4_night_talk2_derek_label_91581842:

    # mc "Who's the snowflake now?"
    mc "现在谁是雪花了？"

# game/scripts/episode4/ep4_derek_route.rpy:148
translate schinese ep4_night_talk2_derek_label_e784a8fc:

    # de "Sorry, I lost my cool."
    de "抱歉，我失态了。"

# game/scripts/episode4/ep4_derek_route.rpy:152
translate schinese ep4_night_talk2_derek_label_ba6655e8:

    # mc "I don't want to insult you."
    mc "我不想骂你的。"

# game/scripts/episode4/ep4_derek_route.rpy:154
translate schinese ep4_night_talk2_derek_label_96cf027e:

    # de "And that's why you're a snowflake."
    de "正因为如此，你才是雪花。"

# game/scripts/episode4/ep4_derek_route.rpy:156
translate schinese ep4_night_talk2_derek_label_6d24fb40:

    # de "But yeah... I think you overreacted."
    de "不过说真的……我觉得你反应过度了。"

# game/scripts/episode4/ep4_derek_route.rpy:157
translate schinese ep4_night_talk2_derek_label_a99fef07:

    # de "If it was me, in a similar situation and definitely not with my sister...hello!"
    de "如果是我，在类似的情况下——当然绝不是跟我妹妹……喂！"

# game/scripts/episode4/ep4_derek_route.rpy:158
translate schinese ep4_night_talk2_derek_label_8248e043:

    # de "...I would try to turn it into a threesome."
    de "……我会试着把它变成三人行。"

# game/scripts/episode4/ep4_derek_route.rpy:159
translate schinese ep4_night_talk2_derek_label_008c64c2:

    # de "But your strategy of storming out...nah. Not for me."
    de "但你那种冲出去的做法……算了。不适合我。"

# game/scripts/episode4/ep4_derek_route.rpy:164
translate schinese ep4_night_talk2_derek_label_3ac08254:

    # mc "You're right... Maybe I overreacted..."
    mc "你说得对……也许我反应过度了……"

# game/scripts/episode4/ep4_derek_route.rpy:165
translate schinese ep4_night_talk2_derek_label_63e72a1e:

    # mc "...but they hurt me."
    mc "……但她们伤害了我。"

# game/scripts/episode4/ep4_derek_route.rpy:166
translate schinese ep4_night_talk2_derek_label_b940f5bc:

    # mc "They lied and they kept things from me..."
    mc "她们撒谎，瞒着我……"

# game/scripts/episode4/ep4_derek_route.rpy:170
translate schinese ep4_night_talk2_derek_label_b72a4dfa:

    # mc "I didn't overreact! I gave Maya several chances, but she didn't tell me the truth until she was forced to."
    mc "我没有反应过度！我给了 Maya 好几次机会，可她是被逼无奈才说出真相。"

# game/scripts/episode4/ep4_derek_route.rpy:171
translate schinese ep4_night_talk2_derek_label_26cc7f02:

    # mc "And Josy's not much better..."
    mc "Josy 也好不到哪儿去……"

# game/scripts/episode4/ep4_derek_route.rpy:172
translate schinese ep4_night_talk2_derek_label_f8bcf58e:

    # mc "She was more honest with me but still kept things from me."
    mc "她对我更坦诚一些，但还是瞒着我。"

# game/scripts/episode4/ep4_derek_route.rpy:174
translate schinese ep4_night_talk2_derek_label_9aff3558:

    # de "I know why that is..."
    de "我知道为什么会这样……"

# game/scripts/episode4/ep4_derek_route.rpy:175
translate schinese ep4_night_talk2_derek_label_421f31df:

    # de "...but it's not my story to tell."
    de "……但这不是该由我来讲的事。"

# game/scripts/episode4/ep4_derek_route.rpy:177
translate schinese ep4_night_talk2_derek_label_256d92c5:

    # mc "Why? I know their secret now."
    mc "为什么？我现在已经知道她们的秘密了。"

# game/scripts/episode4/ep4_derek_route.rpy:179
translate schinese ep4_night_talk2_derek_label_a4da41fe:

    # de "Yeah, and it was a secret for a reason, dude."
    de "是啊，兄弟，既然是秘密，那是有原因的。"

# game/scripts/episode4/ep4_derek_route.rpy:180
translate schinese ep4_night_talk2_derek_label_7a2bc29a:

    # de "Not everyone is cool with gay relationships."
    de "不是所有人都能坦然接受同性恋关系。"

# game/scripts/episode4/ep4_derek_route.rpy:182
translate schinese ep4_night_talk2_derek_label_f4d11690:

    # mc "*{i}Sigh{/i}*"
    mc "*{i}叹气{/i}*"

# game/scripts/episode4/ep4_derek_route.rpy:183
translate schinese ep4_night_talk2_derek_label_6924b829:

    # mc "What should I do?"
    mc "我该怎么办？"

# game/scripts/episode4/ep4_derek_route.rpy:185
translate schinese ep4_night_talk2_derek_label_fbb75323:

    # de "You're not gonna like it."
    de "你不会喜欢这个答案的。"

# game/scripts/episode4/ep4_derek_route.rpy:187
translate schinese ep4_night_talk2_derek_label_0932bce3:

    # mc "Tell me."
    mc "告诉我。"

# game/scripts/episode4/ep4_derek_route.rpy:189
translate schinese ep4_night_talk2_derek_label_c52f3114:

    # de "You will just call it a stupid idea."
    de "你只会说这是个馊主意。"

# game/scripts/episode4/ep4_derek_route.rpy:191
translate schinese ep4_night_talk2_derek_label_458ea70e:

    # mc "Probably...but tell me."
    mc "大概吧……但告诉我。"

# game/scripts/episode4/ep4_derek_route.rpy:193
translate schinese ep4_night_talk2_derek_label_1828f308:

    # de "Don't get attached to women this easily."
    de "别这么容易就陷进女人的感情里。"

