# game/scripts/episode4/ep4_sage_route.rpy:3
translate schinese ep4_night_talk_sage_label_ec8e5224:

    # sa "I'm not fully awake yet."
    sa "我还没完全醒呢。"

# game/scripts/episode4/ep4_sage_route.rpy:4
translate schinese ep4_night_talk_sage_label_50aaaafb:

    # sa "What happened?"
    sa "出什么事了？"

# game/scripts/episode4/ep4_sage_route.rpy:6
translate schinese ep4_night_talk_sage_label_2b35b6fe:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_sage_route.rpy:8
translate schinese ep4_night_talk_sage_label_3641a381:

    # sa "Look, if you expect me to let you stay in our sorority, you need to tell me what's up."
    sa "听着，你要是想让我同意你住进我们姐妹会，就得告诉我到底怎么回事。"

# game/scripts/episode4/ep4_sage_route.rpy:9
translate schinese ep4_night_talk_sage_label_7af505c7:

    # sa "Why did you come here?"
    sa "你为什么来这儿？"

# game/scripts/episode4/ep4_sage_route.rpy:11
translate schinese ep4_night_talk_sage_label_5c068793:

    # mc "I didn't know where else to go. You were the first one who came to mind."
    mc "我不知道还能去哪儿。我第一个想到的就是你。"

# game/scripts/episode4/ep4_sage_route.rpy:13
translate schinese ep4_night_talk_sage_label_349c2074:

    # sa "Ok? That doesn't explain anything. Why are you sad?"
    sa "然后呢？这什么也没解释。你为什么难过？"

# game/scripts/episode4/ep4_sage_route.rpy:15
translate schinese ep4_night_talk_sage_label_7874ef0e:

    # mc "I...feel betrayed."
    mc "我……感觉遭到了背叛。"

# game/scripts/episode4/ep4_sage_route.rpy:17
translate schinese ep4_night_talk_sage_label_c62b14ea:

    # sa "Betrayed? By who?"
    sa "背叛？被谁？"

# game/scripts/episode4/ep4_sage_route.rpy:19
translate schinese ep4_night_talk_sage_label_01f792af:

    # mc "My roommate...Maya. My former roommate, I should say."
    mc "我的室友……Maya。我该说，我以前的室友。"

# game/scripts/episode4/ep4_sage_route.rpy:20
translate schinese ep4_night_talk_sage_label_0219946c:

    # mc "I can't tell you any details...I promised."
    mc "细节我不能说……我答应过。"

# game/scripts/episode4/ep4_sage_route.rpy:22
translate schinese ep4_night_talk_sage_label_43ac3247:

    # sa "Keep it vague, then. You gotta give me something."
    sa "那说得含糊点总行。你总得给我点信息。"

# game/scripts/episode4/ep4_sage_route.rpy:24
translate schinese ep4_night_talk_sage_label_96608e5b:

    # mc "She lied to me...or kept something from me..."
    mc "她对我撒了谎……或者说，瞒了我一些事……"

# game/scripts/episode4/ep4_sage_route.rpy:25
translate schinese ep4_night_talk_sage_label_38c6b255:

    # mc "And I just can't stay with her anymore. Besides, me staying there with her wasn't really legal in the first place..."
    mc "我再也待不下去了。再说，我本来住在她那儿就不太合规矩……"

# game/scripts/episode4/ep4_sage_route.rpy:26
translate schinese ep4_night_talk_sage_label_d80610b8:

    # mc "I got into a fight with my first roommate and ended up staying at her place."
    mc "我跟第一任室友大吵一架，后来就住到她那儿去了。"

# game/scripts/episode4/ep4_sage_route.rpy:27
translate schinese ep4_night_talk_sage_label_887f75da:

    # mc "She got a new roommate now. So...I need a place to stay."
    mc "她现在有新室友了。所以……我需要个住的地方。"

# game/scripts/episode4/ep4_sage_route.rpy:29
translate schinese ep4_night_talk_sage_label_4db6aff0:

    # sa "What about the DIKs? Can't they cut you some slack?"
    sa "那 DIK 呢？他们不能通融一下吗？"

# game/scripts/episode4/ep4_sage_route.rpy:30
translate schinese ep4_night_talk_sage_label_753a3f90:

    # sa "I mean, you're a maggot. You're gonna be a DIK in like a week, right?"
    sa "我是说，你现在是菜鸟。再过一周左右就是 DIK 了，对吧？"

# game/scripts/episode4/ep4_sage_route.rpy:32
translate schinese ep4_night_talk_sage_label_7727460f:

    # mc "I've tried that before. It's not gonna work."
    mc "我试过了。行不通。"

# game/scripts/episode4/ep4_sage_route.rpy:34
translate schinese ep4_night_talk_sage_label_877813be:

    # sa "Ok... So...uh..."
    sa "好吧……那么……呃……"

# game/scripts/episode4/ep4_sage_route.rpy:35
translate schinese ep4_night_talk_sage_label_50acd888:

    # sa "Get comfortable. I'm gonna go find a mattress for you."
    sa "先随便坐。我去给你找张床垫。"

# game/scripts/episode4/ep4_sage_route.rpy:38
translate schinese ep4_night_talk_sage_label_f4d11690:

    # mc "*{i}Sigh{/i}*"
    mc "*{i}叹气{/i}*"

# game/scripts/episode4/ep4_sage_route.rpy:39
translate schinese ep4_night_talk_sage_label_e02acdaa:

    # mc "(I can't believe what happened back there...)"
    mc "（真不敢相信刚才发生了那种事……）"

# game/scripts/episode4/ep4_sage_route.rpy:45
translate schinese ep4_night_talk2_sage_label_0e862860:

    # sa "Here's your mattress."
    sa "你的床垫来了。"

# game/scripts/episode4/ep4_sage_route.rpy:47
translate schinese ep4_night_talk2_sage_label_48f3bc5e:

    # mc "Thanks... I could have helped you get it."
    mc "谢谢……我本来可以帮你拿的。"

# game/scripts/episode4/ep4_sage_route.rpy:48
translate schinese ep4_night_talk2_sage_label_e3244908:

    # sa "Really? I thought you were here because you need {b}my{/b} help."
    sa "真的吗？我以为你来这儿是因为需要{b}我{/b}帮忙。"

# game/scripts/episode4/ep4_sage_route.rpy:50
translate schinese ep4_night_talk2_sage_label_4e5fc3a9:

    # sa "Sorry... I'm dead tired right now."
    sa "抱歉……我现在累死了。"

# game/scripts/episode4/ep4_sage_route.rpy:51
translate schinese ep4_night_talk2_sage_label_18837f33:

    # sa "I'm a bit bitchy when I'm tired."
    sa "我累的时候脾气有点差。"

# game/scripts/episode4/ep4_sage_route.rpy:52
translate schinese ep4_night_talk2_sage_label_82f81412:

    # sa "We'll continue this in the morning, ok?"
    sa "我们早上再接着聊，好吗？"

# game/scripts/episode4/ep4_sage_route.rpy:53
translate schinese ep4_night_talk2_sage_label_26e0a540:

    # mc "Sure...."
    mc "好吧……"

# game/scripts/episode4/ep4_sage_route.rpy:56
translate schinese ep4_night_talk2_sage_label_d7a525ac:

    # sa "*{i}Yawns{/i}* Good night."
    sa "*{i}打哈欠{/i}* 晚安。"

# game/scripts/episode4/ep4_sage_route.rpy:57
translate schinese ep4_night_talk2_sage_label_706727a2:

    # mc "Good night, Sage."
    mc "晚安，Sage。"

# game/scripts/episode4/ep4_sage_route.rpy:59
translate schinese ep4_night_talk2_sage_label_45e7ec77:

    # mc "(...)"
    mc "（……）"

# game/scripts/episode4/ep4_sage_route.rpy:60
translate schinese ep4_night_talk2_sage_label_3f932c69:

    # mc "(I have no clue what I'm going to do now...)"
    mc "（我完全不知道接下来该怎么办……）"

# game/scripts/episode4/ep4_sage_route.rpy:61
translate schinese ep4_night_talk2_sage_label_5fab0861:

    # mc "(Thank you, Sage...)"
    mc "（谢谢你，Sage……）"

# game/scripts/episode4/ep4_sage_route.rpy:62
translate schinese ep4_night_talk2_sage_label_90b4b7ed:

    # mc "(I'm glad I have someone like you here.)"
    mc "（我很庆幸这儿有你这样的人。）"

# game/scripts/episode4/ep4_sage_route.rpy:65
translate schinese ep4_night_talk2_sage_label_b8204e55:

    # mc "Ouch! Hey..."
    mc "哎哟！嘿……"

# game/scripts/episode4/ep4_sage_route.rpy:67
translate schinese ep4_night_talk2_sage_label_0f42df88:

    # sa "*{i}Snores{/i}*"
    sa "*{i}打呼{/i}*"

# game/scripts/episode4/ep4_sage_route.rpy:68
translate schinese ep4_night_talk2_sage_label_08bed92c:

    # mc "(Haha...ok, that's pretty damn cute.)"
    mc "（哈哈……好吧，这还挺可爱的。）"

# game/scripts/episode4/ep4_sage_route.rpy:69
translate schinese ep4_night_talk2_sage_label_e3339b24:

    # mc "(Fuck... That would have counted as the third slap...)"
    mc "（操……这算下来是第三次被打脸了……）"

# game/scripts/episode4/ep4_sage_route.rpy:70
translate schinese ep4_night_talk2_sage_label_a339df4a:

    # mc "(Meh... I have other problems to worry about.)"
    mc "（算了……我还有别的事要操心。）"

# game/scripts/episode4/ep4_sage_route.rpy:81
translate schinese ep4_morning_talk_sage_label_2b35b6fe:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_sage_route.rpy:82
translate schinese ep4_morning_talk_sage_label_74fbff36:

    # mc "Morning..."
    mc "早上好……"

# game/scripts/episode4/ep4_sage_route.rpy:84
translate schinese ep4_morning_talk_sage_label_95059895:

    # sa "Hey. Good morning."
    sa "嘿。早上好。"

# game/scripts/episode4/ep4_sage_route.rpy:86
translate schinese ep4_morning_talk_sage_label_d99f856b:

    # mc "What time is it?"
    mc "现在几点了？"

# game/scripts/episode4/ep4_sage_route.rpy:88
translate schinese ep4_morning_talk_sage_label_c0f3b036:

    # sa "It's 6 a.m."
    sa "早上六点。"

# game/scripts/episode4/ep4_sage_route.rpy:90
translate schinese ep4_morning_talk_sage_label_7bee8bc1:

    # mc "Seriously? Are you always up this early?"
    mc "真的吗？你总是这么早起？"

# game/scripts/episode4/ep4_sage_route.rpy:92
translate schinese ep4_morning_talk_sage_label_020a46c9:

    # sa "No, just sometimes. I had some HOT business to plan for and I woke up an hour ago, restless."
    sa "不，只是偶尔。我有些 HOT 的事务要安排，一小时前就醒了，怎么也睡不着。"

# game/scripts/episode4/ep4_sage_route.rpy:93
translate schinese ep4_morning_talk_sage_label_5d5873bf:

    # sa "I couldn't sleep well."
    sa "我没睡好。"

# game/scripts/episode4/ep4_sage_route.rpy:95
translate schinese ep4_morning_talk_sage_label_a2ba3edb:

    # mc "Oh... Sorry if I ruined your beauty sleep."
    mc "哦……要是打扰了你的美容觉，我很抱歉。"

# game/scripts/episode4/ep4_sage_route.rpy:97
translate schinese ep4_morning_talk_sage_label_51a97fae:

    # sa "Don't worry. It's not because of you."
    sa "别担心。不是因为你。"

# game/scripts/episode4/ep4_sage_route.rpy:98
translate schinese ep4_morning_talk_sage_label_5fb6203e:

    # sa "I've had a lot on my plate lately."
    sa "我最近烦心事很多。"

# game/scripts/episode4/ep4_sage_route.rpy:100
translate schinese ep4_morning_talk_sage_label_8fd8afda:

    # mc "Being a president must mean a lot of work."
    mc "当主席一定很辛苦吧。"

# game/scripts/episode4/ep4_sage_route.rpy:102
translate schinese ep4_morning_talk_sage_label_e2cf02dc:

    # sa "Yeah, it is. Especially when it comes to the economy. You know, collecting fees from sisters, finding ways to earn money for the HOTs..."
    sa "是啊，确实。尤其是财务方面。你知道的，向姐妹们收会费，想办法给 HOT 挣钱……"

# game/scripts/episode4/ep4_sage_route.rpy:103
translate schinese ep4_morning_talk_sage_label_2d9a9111:

    # sa "I'm so fucking thankful to have Quinn to help me out."
    sa "有 Quinn 帮我，我真是感激不尽。"

# game/scripts/episode4/ep4_sage_route.rpy:105
translate schinese ep4_morning_talk_sage_label_51c91d11:

    # mc "Quinn?"
    mc "Quinn？"

# game/scripts/episode4/ep4_sage_route.rpy:106
translate schinese ep4_morning_talk_sage_label_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_sage_route.rpy:107
translate schinese ep4_morning_talk_sage_label_308b63c5:

    # mc "How is she helping you out?"
    mc "她是怎么帮你的？"

# game/scripts/episode4/ep4_sage_route.rpy:110
translate schinese ep4_morning_talk_sage_label_f00f93b0:

    # sa "She's amazing, really! I don't even have to ask her for most of the things."
    sa "她真的很厉害！大多数事情我根本不用开口，她就会去做。"

# game/scripts/episode4/ep4_sage_route.rpy:111
translate schinese ep4_morning_talk_sage_label_530f36b9:

    # sa "She just knows what needs to be done and then she does it."
    sa "她就是知道该做什么，然后直接去做。"

# game/scripts/episode4/ep4_sage_route.rpy:115
translate schinese ep4_morning_talk_sage_label_a725690a:

    # mc "Nice to have someone to help you run things, I guess."
    mc "有人帮你打理事务，感觉不错吧。"

# game/scripts/episode4/ep4_sage_route.rpy:116
translate schinese ep4_morning_talk_sage_label_cd13b5cc:

    # mc "It's kind of like what Tommy is to Rusty."
    mc "有点像 Tommy 对 Rusty 那样。"

# game/scripts/episode4/ep4_sage_route.rpy:118
translate schinese ep4_morning_talk_sage_label_06238133:

    # sa "Yeah, definitely. That's what a vice president should be like."
    sa "没错，就是这样。副主席就该是这个样子。"

# game/scripts/episode4/ep4_sage_route.rpy:119
translate schinese ep4_morning_talk_sage_label_9b935629:

    # sa "Not like Dawe. Well...his family gym's been sponsoring the tri-alphas for years, but other than that, he leaves everything to Chad."
    sa "可不像 Dawe。嗯……他家的健身房赞助三甲兄弟会好多年了，但除此之外，他把一切都丢给 Chad。"

# game/scripts/episode4/ep4_sage_route.rpy:120
translate schinese ep4_morning_talk_sage_label_03dab15c:

    # sa "Well...{i}left{/i} everything to Chad, I guess."
    sa "嗯……应该说，是{i}曾经{/i}都丢给 Chad，我想。"

# game/scripts/episode4/ep4_sage_route.rpy:122
translate schinese ep4_morning_talk_sage_label_91052656:

    # mc "She does your job without asking first? And you like that?"
    mc "她不问你就替你把事做了？你还喜欢这样？"

# game/scripts/episode4/ep4_sage_route.rpy:124
translate schinese ep4_morning_talk_sage_label_3794f0c3:

    # sa "It's not really my job, the HOTs are a team."
    sa "那其实不是我一个人的事，HOT 是一个团队。"

# game/scripts/episode4/ep4_sage_route.rpy:125
translate schinese ep4_morning_talk_sage_label_33eea6d0:

    # sa "And I like when she helps out...most of the time."
    sa "而且我喜欢她帮忙……大多数时候是。"

# game/scripts/episode4/ep4_sage_route.rpy:126
translate schinese ep4_morning_talk_sage_label_69f4cc98:

    # sa "I mean, there have been some questionable choices in the past."
    sa "我是说，过去也有过一些让人存疑的决定。"

# game/scripts/episode4/ep4_sage_route.rpy:127
translate schinese ep4_morning_talk_sage_label_8656fa85:

    # sa "But she's the vice president and I'd rather have her doing something than nothing, like Dawe..."
    sa "但她是副主席，我宁可她做点什么，也不要她什么都不做，像 Dawe 那样……"

# game/scripts/episode4/ep4_sage_route.rpy:128
translate schinese ep4_morning_talk_sage_label_ff2c211e:

    # sa "And we always talk it out in private if there's an issue."
    sa "而且出了问题，我们总是私下谈开。"

# game/scripts/episode4/ep4_sage_route.rpy:130
translate schinese ep4_morning_talk_sage_label_1b80c179:

    # mc "I didn't realize that you and Quinn were close."
    mc "我不知道你和 Quinn 关系这么好。"

# game/scripts/episode4/ep4_sage_route.rpy:132
translate schinese ep4_morning_talk_sage_label_e3119d73:

    # sa "I'm close with all sisters. But for Quinn..."
    sa "我跟所有姐妹都很亲近。但 Quinn 嘛……"

# game/scripts/episode4/ep4_sage_route.rpy:133
translate schinese ep4_morning_talk_sage_label_b5a0fc7a:

    # sa "What can I say? She was my daughter and she grew on me."
    sa "怎么说呢？她曾是我的「女儿」，我越来越喜欢她了。"

# game/scripts/episode4/ep4_sage_route.rpy:134
translate schinese ep4_morning_talk_sage_label_5cd4561a:

    # sa "Besides, after next year, the HOTs need someone to fill my shoes."
    sa "再说，明年之后，HOT 需要有人接我的班。"

# game/scripts/episode4/ep4_sage_route.rpy:136
translate schinese ep4_morning_talk_sage_label_025189cb:

    # mc "You're quitting?"
    mc "你要退出？"

# game/scripts/episode4/ep4_sage_route.rpy:138
translate schinese ep4_morning_talk_sage_label_d41b8b0d:

    # sa "It's called graduating and yes..."
    sa "那叫毕业，没错……"

# game/scripts/episode4/ep4_sage_route.rpy:139
translate schinese ep4_morning_talk_sage_label_f223cbc7:

    # sa "I'm graduating next year."
    sa "我明年毕业。"

# game/scripts/episode4/ep4_sage_route.rpy:141
translate schinese ep4_morning_talk_sage_label_054c5ee0:

    # mc "I see."
    mc "我明白了。"

# game/scripts/episode4/ep4_sage_route.rpy:143
translate schinese ep4_morning_talk_sage_label_71eb6c65:

    # sa "Now... What are we going to do about you?"
    sa "那么……我们该拿你怎么办？"

# game/scripts/episode4/ep4_sage_route.rpy:145
translate schinese ep4_morning_talk_sage_label_b2b9e19d:

    # mc "What do you mean?"
    mc "你什么意思？"

# game/scripts/episode4/ep4_sage_route.rpy:147
translate schinese ep4_morning_talk_sage_label_f02c23cf:

    # sa "Having a dude staying in a sorority...that's breaking all kinds of rules."
    sa "让一个男生住在姐妹会里……这违反了很多条规定。"

# game/scripts/episode4/ep4_sage_route.rpy:149
translate schinese ep4_morning_talk_sage_label_f1c2bfca:

    # mc "You can't do anything about that?"
    mc "这事你就没办法吗？"

# game/scripts/episode4/ep4_sage_route.rpy:151
translate schinese ep4_morning_talk_sage_label_4b69f78b:

    # sa "I...like you."
    sa "我……喜欢你。"

# game/scripts/episode4/ep4_sage_route.rpy:152
translate schinese ep4_morning_talk_sage_label_793e7d2c:

    # sa "And I know the feeling of looking for a place to belong."
    sa "而且我懂那种寻找归属感的心情。"

# game/scripts/episode4/ep4_sage_route.rpy:153
translate schinese ep4_morning_talk_sage_label_4376c7c5:

    # sa "Stay with me until you get your shit sorted, but get it sorted fast so us girls don't get into trouble."
    sa "在我这儿住到你把事情理顺为止，但要尽快，别让我们这些姑娘惹上麻烦。"

# game/scripts/episode4/ep4_sage_route.rpy:155
translate schinese ep4_morning_talk_sage_label_bb2c4c61:

    # mc "Thank you so much."
    mc "太感谢你了。"

# game/scripts/episode4/ep4_sage_route.rpy:156
translate schinese ep4_morning_talk_sage_label_7beef448:

    # mc "I'll find a way to repay you."
    mc "我会想办法报答你的。"

# game/scripts/episode4/ep4_sage_route.rpy:158
translate schinese ep4_morning_talk_sage_label_b2fb2b48:

    # sa "You teach me how to play guitar and we'll call it even. Sound good?"
    sa "你教我弹吉他，我们就算扯平了。听起来怎样？"

# game/scripts/episode4/ep4_sage_route.rpy:160
translate schinese ep4_morning_talk_sage_label_bec88a02:

    # mc "Yeah, absolutely!"
    mc "好，当然好！"

# game/scripts/episode4/ep4_sage_route.rpy:162
translate schinese ep4_morning_talk_sage_label_b1ef63c9:

    # sa "Hey..."
    sa "嘿……"

# game/scripts/episode4/ep4_sage_route.rpy:163
translate schinese ep4_morning_talk_sage_label_13d0d0ac:

    # sa "Join me for breakfast."
    sa "陪我吃早餐吧。"

# game/scripts/episode4/ep4_sage_route.rpy:171
translate schinese ep4_morning_talk_sage_label_dc71c8f0:

    # sa "Say, you're a freshman..."
    sa "话说，你是新生……"

# game/scripts/episode4/ep4_sage_route.rpy:172
translate schinese ep4_morning_talk_sage_label_8fea6bbc:

