translate schinese ep4_morning_talk_bella_label_149e336e:

    # isa "You just ate."
    isa "你刚吃完饭。"

# game/scripts/episode4/ep4_bella_route.rpy:247
translate schinese ep4_morning_talk_bella_label_a6be913e:

    # mc "So?"
    mc "那又怎样？"

