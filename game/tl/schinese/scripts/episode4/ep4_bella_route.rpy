# game/scripts/episode4/ep4_bella_route.rpy:231
translate schinese ep4_morning_talk_bella_label_2b35b6fe_2:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:232
translate schinese ep4_morning_talk_bella_label_c6776ebe:

    # mc "Would you?"
    mc "你会吗？"

# game/scripts/episode4/ep4_bella_route.rpy:234
translate schinese ep4_morning_talk_bella_label_01f324d7:

    # isa "And I thought it was the beer..."
    isa "我还以为是啤酒的缘故……"

# game/scripts/episode4/ep4_bella_route.rpy:236
translate schinese ep4_morning_talk_bella_label_11455b53:

    # mc "What?"
    mc "什么？"

# game/scripts/episode4/ep4_bella_route.rpy:238
translate schinese ep4_morning_talk_bella_label_7d471689:

