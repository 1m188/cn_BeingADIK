translate schinese ep4_morning_talk_bella_label_98619be0:

    # mc "Do you ever swim in the pool?"
    mc "你经常在泳池游泳吗？"

# game/scripts/episode4/ep4_bella_route.rpy:243
translate schinese ep4_morning_talk_bella_label_3fe7837e:

    # isa "I do."
    isa "会。"

# game/scripts/episode4/ep4_bella_route.rpy:245
translate schinese ep4_morning_talk_bella_label_51c5f03b:

    # mc "Can I?"
    mc "我能游吗？"

