translate schinese ep4_morning_talk_bella_label_850c70ae:

    # isa "You don't go swimming after you just ate."
    isa "刚吃完饭不能游泳。"

# game/scripts/episode4/ep4_bella_route.rpy:249
translate schinese ep4_morning_talk_bella_label_0e9013c7:

    # mc "Why is that?"
    mc "为什么？"

# game/scripts/episode4/ep4_bella_route.rpy:251
translate schinese ep4_morning_talk_bella_label_70a9e797:

    # isa "Supposedly, you can get cramps."
    isa "据说会抽筋。"

# game/scripts/episode4/ep4_bella_route.rpy:253
translate schinese ep4_morning_talk_bella_label_422c385d:

    # mc "Hah, really? Who would have known?"
    mc "哈，真的吗？谁知道呢？"

# game/scripts/episode4/ep4_bella_route.rpy:254
translate schinese ep4_morning_talk_bella_label_9a6b59ee:

    # isa "You can swim after school."
    isa "放学后再游吧。"

# game/scripts/episode4/ep4_bella_route.rpy:255
translate schinese ep4_morning_talk_bella_label_eab3ea51:

    # mc "Cool! Will you join me?"
    mc "酷！你一起来吗？"

# game/scripts/episode4/ep4_bella_route.rpy:256
translate schinese ep4_morning_talk_bella_label_8fcd003b:

    # isa "Perhaps."
    isa "也许吧。"

# game/scripts/episode4/ep4_bella_route.rpy:258
translate schinese ep4_morning_talk_bella_label_3329a58b:

    # isa "Finish your breakfast. I don't want to be late."
    isa "把早餐吃完。我不想迟到。"

# game/scripts/episode4/ep4_bella_route.rpy:264
translate schinese ep4_afternoon_bella_label_c698c1a1:

    # mc "Honey! I'm home!"
    mc "亲爱的！我回来了！"

# game/scripts/episode4/ep4_bella_route.rpy:266
translate schinese ep4_afternoon_bella_label_d20276c1:

    # mc "Hey! Where are you going?"
    mc "嘿！你要去哪儿？"

# game/scripts/episode4/ep4_bella_route.rpy:270
translate schinese ep4_afternoon_bella_label_2be3d26e:

    # mc "(Wow!)"
    mc "（哇！）"

# game/scripts/episode4/ep4_bella_route.rpy:273
translate schinese ep4_afternoon_bella_label_dac2d191:

    # mc "(Holy hell!)"
    mc "（我的天！）"

# game/scripts/episode4/ep4_bella_route.rpy:279
translate schinese ep4_afternoon_bella_label_939b3307:

    # mc "You look so fucking hot, Bella."
    mc "你看起来真他妈辣，Bella。"

# game/scripts/episode4/ep4_bella_route.rpy:281
translate schinese ep4_afternoon_bella_label_73c9962d:

    # isa "Careful!"
    isa "小心！"

# game/scripts/episode4/ep4_bella_route.rpy:283
translate schinese ep4_afternoon_bella_label_e73e125b:

    # mc "You look breathtaking."
    mc "你美得令人窒息。"

# game/scripts/episode4/ep4_bella_route.rpy:285
translate schinese ep4_afternoon_bella_label_7cd4e70f:

    # isa "Breathtaking? What the hell is wrong with you?"
    isa "令人窒息？你到底怎么了？"

# game/scripts/episode4/ep4_bella_route.rpy:289
translate schinese ep4_afternoon_bella_label_d3642964:

    # mc "Is it pool time?"
    mc "到游泳时间了吗？"

# game/scripts/episode4/ep4_bella_route.rpy:291
translate schinese ep4_afternoon_bella_label_dee64ec8:

    # isa "I thought you weren't going to drink those beers."
    isa "我以为你不打算喝那些啤酒了。"

# game/scripts/episode4/ep4_bella_route.rpy:293
translate schinese ep4_afternoon_bella_label_e3a31e7e:

    # mc "I haven't."
    mc "我没喝。"

# game/scripts/episode4/ep4_bella_route.rpy:295
translate schinese ep4_afternoon_bella_label_23aa7b81:

    # isa "But you will."
    isa "但你会喝。"

# game/scripts/episode4/ep4_bella_route.rpy:297
translate schinese ep4_afternoon_bella_label_e00bcce8:

    # mc "It's just such a shame to let them go to waste."
    mc "只是让它们浪费掉太可惜了。"

# game/scripts/episode4/ep4_bella_route.rpy:299
translate schinese ep4_afternoon_bella_label_258f31cb:

    # isa "Pass me one."
    isa "递我一瓶。"

# game/scripts/episode4/ep4_bella_route.rpy:301
translate schinese ep4_afternoon_bella_label_3155797d:

    # mc "For real?"
    mc "真的？"

# game/scripts/episode4/ep4_bella_route.rpy:303
translate schinese ep4_afternoon_bella_label_5d0485d0:

    # isa "If you don't mind."
    isa "如果你不介意。"

# game/scripts/episode4/ep4_bella_route.rpy:305
translate schinese ep4_afternoon_bella_label_2f4ba47f:

    # mc "Of course not!"
    mc "当然不介意！"

# game/scripts/episode4/ep4_bella_route.rpy:310
translate schinese ep4_afternoon_bella_label_bdf92249:

    # mc "Nice..."
    mc "不错……"

# game/scripts/episode4/ep4_bella_route.rpy:313
translate schinese ep4_afternoon_bella_label_73bf9ded:

    # mc "Cheers!"
    mc "干杯！"

# game/scripts/episode4/ep4_bella_route.rpy:315
translate schinese ep4_afternoon_bella_label_e7fbc0bb:

    # isa "If you throw up in the pool, you're cleaning it."
    isa "你要是吐在泳池里，就由你来清理。"

# game/scripts/episode4/ep4_bella_route.rpy:316
translate schinese ep4_afternoon_bella_label_be30cb7b:

    # mc "Deal! Let me go and get changed."
    mc "成交！我去换衣服。"

# game/scripts/episode4/ep4_bella_route.rpy:322
translate schinese ep4_bella_pool_label_7d859c86:

    # mc "Hey! I'm back."
    mc "嘿！我回来了。"

# game/scripts/episode4/ep4_bella_route.rpy:324
translate schinese ep4_bella_pool_label_b75b2f5f:

    # isa "What are you waiting for? Go ahead and jump in the pool."
    isa "还等什么？跳进泳池吧。"

# game/scripts/episode4/ep4_bella_route.rpy:326
translate schinese ep4_bella_pool_label_7416303a:

    # mc "Will you join me?"
    mc "你一起来吗？"

# game/scripts/episode4/ep4_bella_route.rpy:328
translate schinese ep4_bella_pool_label_021917f8:

    # isa "Not at the moment."
    isa "现在不行。"

# game/scripts/episode4/ep4_bella_route.rpy:330
translate schinese ep4_bella_pool_label_5ef42ef6:

    # mc "Then I can wait."
    mc "那我可以等。"

# game/scripts/episode4/ep4_bella_route.rpy:332
translate schinese ep4_bella_pool_label_5cb71a55:

    # mc "Sunbathing, huh?"
    mc "在晒日光浴啊？"

# game/scripts/episode4/ep4_bella_route.rpy:334
translate schinese ep4_bella_pool_label_0ef67b51:

    # isa "There aren't many more chances to get a tan before fall."
    isa "入秋前能晒黑的机会不多了。"

# game/scripts/episode4/ep4_bella_route.rpy:336
translate schinese ep4_bella_pool_label_9aec73fd:

    # mc "Is that sunblock I see over there?"
    mc "那边那个是防晒霜吗？"

# game/scripts/episode4/ep4_bella_route.rpy:339
translate schinese ep4_bella_pool_label_fcb81cac:

    # isa "Yes. And I already put it on, so keep it in your pants."
    isa "对。而且我已经涂好了，所以收起你的心思。"

# game/scripts/episode4/ep4_bella_route.rpy:343
translate schinese ep4_bella_pool_label_058e6b98:

    # mc "But you missed a spot..."
    mc "但你漏了一块……"

# game/scripts/episode4/ep4_bella_route.rpy:345
translate schinese ep4_bella_pool_label_5c67f31e:

    # isa "I don't think so."
    isa "我不觉得。"

# game/scripts/episode4/ep4_bella_route.rpy:347
translate schinese ep4_bella_pool_label_ec561fdb:

    # mc "I was really asking for me."
    mc "其实我是替我自己要的。"

# game/scripts/episode4/ep4_bella_route.rpy:349
translate schinese ep4_bella_pool_label_1dc887eb:

    # isa "Oh... Do you want some?"
    isa "哦……你想要吗？"

# game/scripts/episode4/ep4_bella_route.rpy:350
translate schinese ep4_bella_pool_label_253ce317:

    # mc "No, I'm good."
    mc "不，我不用。"

# game/scripts/episode4/ep4_bella_route.rpy:352
translate schinese ep4_bella_pool_label_fb623a7e:

    # isa "..."
    isa "……"

# game/scripts/episode4/ep4_bella_route.rpy:354
translate schinese ep4_bella_pool_label_24a94b8e:

    # mc "I never got why people like to sunbathe..."
    mc "我一直不明白人们为什么喜欢晒日光浴……"

# game/scripts/episode4/ep4_bella_route.rpy:356
translate schinese ep4_bella_pool_label_877593c4:

    # isa "Do you understand the concept of a tan?"
    isa "你懂「晒黑」这个概念吗？"

# game/scripts/episode4/ep4_bella_route.rpy:361
translate schinese ep4_bella_pool_label_c6291a1d:

    # mc "I understand it perfectly."
    mc "我完全懂。"

# game/scripts/episode4/ep4_bella_route.rpy:362
translate schinese ep4_bella_pool_label_a9ec1f8f:

    # mc "Do you understand that the sun irreversibly destroys collagen and gives you wrinkles?"
    mc "你知道阳光会不可逆地破坏胶原蛋白、让你长皱纹吗？"

# game/scripts/episode4/ep4_bella_route.rpy:364
translate schinese ep4_bella_pool_label_cba55315:

    # isa "You're such a charmer."
    isa "你可真会讨人欢心。"

# game/scripts/episode4/ep4_bella_route.rpy:368
translate schinese ep4_bella_pool_label_1bf60051:

    # mc "Of course."
    mc "当然。"

# game/scripts/episode4/ep4_bella_route.rpy:369
translate schinese ep4_bella_pool_label_ce4cffee:

    # mc "I just don't understand why you have to lie still while doing it."
    mc "我只是不明白，为什么晒的时候非得躺着不动。"

# game/scripts/episode4/ep4_bella_route.rpy:370
translate schinese ep4_bella_pool_label_f1bc8382:

    # mc "You could be up and about, kick a ball around or you know...swim in the pool."
    mc "你可以起来活动活动，踢踢球，或者……你知道的……在泳池里游两圈。"

# game/scripts/episode4/ep4_bella_route.rpy:372
translate schinese ep4_bella_pool_label_7c598f5a:

    # isa "I'll tell you what. Let me just get 10 minutes on my back, and I'll join you for a swim."
    isa "这样吧。让我趴着晒十分钟，然后我就陪你游。"

# game/scripts/episode4/ep4_bella_route.rpy:395
