# game/scripts/episode4/ep4_bella_route.rpy:6
translate schinese ep4_night_talk_bella_label_6695eb1d:

    # isa "Here you go."
    isa "给你。"

# game/scripts/episode4/ep4_bella_route.rpy:7
translate schinese ep4_night_talk_bella_label_bb0eeaf4:

    # mc "Thank you."
    mc "谢谢你。"

# game/scripts/episode4/ep4_bella_route.rpy:11
translate schinese ep4_night_talk_bella_label_d258f2d5:

    # isa "Do you want to tell me what happened?"
    isa "你想告诉我发生了什么吗？"

# game/scripts/episode4/ep4_bella_route.rpy:13
translate schinese ep4_night_talk_bella_label_fca52711:

    # mc "No."
    mc "不。"

# game/scripts/episode4/ep4_bella_route.rpy:15
translate schinese ep4_night_talk_bella_label_685dea29:

    # isa "You look very upset."
    isa "你看起来很沮丧。"

# game/scripts/episode4/ep4_bella_route.rpy:17
translate schinese ep4_night_talk_bella_label_2b35b6fe:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:19
translate schinese ep4_night_talk_bella_label_02c4d736:

    # isa "You're usually much more..."
    isa "你平时可要……"

# game/scripts/episode4/ep4_bella_route.rpy:20
translate schinese ep4_night_talk_bella_label_cb2bcc3b:

    # isa "...annoying."
    isa "……烦人得多。"

# game/scripts/episode4/ep4_bella_route.rpy:22
translate schinese ep4_night_talk_bella_label_fa45f281:

    # mc "Thanks..."
    mc "谢谢……"

# game/scripts/episode4/ep4_bella_route.rpy:24
translate schinese ep4_night_talk_bella_label_10db7c3a:

    # isa "It was a joke."
    isa "开个玩笑。"

# game/scripts/episode4/ep4_bella_route.rpy:26
translate schinese ep4_night_talk_bella_label_b7957aa4:

    # mc "Sorry, I'm not in a joking mood."
    mc "抱歉，我没心情开玩笑。"

# game/scripts/episode4/ep4_bella_route.rpy:27
translate schinese ep4_night_talk_bella_label_fb623a7e:

    # isa "..."
    isa "……"

# game/scripts/episode4/ep4_bella_route.rpy:29
translate schinese ep4_night_talk_bella_label_b48e7b06:

    # isa "We can just sit in silence if you want?"
    isa "你要是愿意，我们就这么安静坐着？"

# game/scripts/episode4/ep4_bella_route.rpy:31
translate schinese ep4_night_talk_bella_label_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:33
translate schinese ep4_night_talk_bella_label_707ef0f3:

    # isa "Come with me."
    isa "跟我来。"

# game/scripts/episode4/ep4_bella_route.rpy:35
translate schinese ep4_night_talk_bella_label_dc5723fc:

    # isa "If we're going to sit in silence, we might as well be comfortable."
    isa "既然要安静坐着，不如坐得舒服点。"

# game/scripts/episode4/ep4_bella_route.rpy:37
translate schinese ep4_night_talk_bella_label_04c88689:

    # isa "That doesn't look comfortable."
    isa "那看起来可不太舒服。"

# game/scripts/episode4/ep4_bella_route.rpy:39
translate schinese ep4_night_talk_bella_label_28f6829a:

    # isa "Come here. Lie down."
    isa "过来。躺下。"

# game/scripts/episode4/ep4_bella_route.rpy:43
translate schinese ep4_night_talk_bella_label_b7a72587:

    # isa "You've been drinking."
    isa "你喝酒了。"

# game/scripts/episode4/ep4_bella_route.rpy:45
translate schinese ep4_night_talk_bella_label_d74cf112:

    # mc "Yes, but not a lot."
    mc "嗯，但没喝多少。"

# game/scripts/episode4/ep4_bella_route.rpy:49
translate schinese ep4_night_talk_bella_label_47b6109d:

    # isa "Don't you think talking about it will make you feel better?"
    isa "你不觉得说出来会好受些吗？"

# game/scripts/episode4/ep4_bella_route.rpy:51
translate schinese ep4_night_talk_bella_label_dd051d66:

    # mc "It will just make me feel angry again."
    mc "那只会让我再次生气。"

# game/scripts/episode4/ep4_bella_route.rpy:53
translate schinese ep4_night_talk_bella_label_cb8690ab:

    # isa "Those feelings fade with time."
    isa "那些情绪会随时间消退。"

# game/scripts/episode4/ep4_bella_route.rpy:54
translate schinese ep4_night_talk_bella_label_e95c19b8:

    # isa "Sometimes you need an ear to vent to."
    isa "有时候你需要一个倾听的对象。"

# game/scripts/episode4/ep4_bella_route.rpy:55
translate schinese ep4_night_talk_bella_label_11feb651:

    # isa "Surely there's a reason you came to my place instead of a friend?"
    isa "你来找我而不是找朋友，肯定有原因吧？"

# game/scripts/episode4/ep4_bella_route.rpy:57
translate schinese ep4_night_talk_bella_label_70837e1f:

    # mc "You've helped me a lot. I think that's why."
    mc "你帮了我很多。我想这就是原因。"

# game/scripts/episode4/ep4_bella_route.rpy:58
translate schinese ep4_night_talk_bella_label_d1789e99:

    # mc "And you're genuine. Harsh...but genuine."
    mc "而且你很真诚。说话直……但真诚。"

# game/scripts/episode4/ep4_bella_route.rpy:59
translate schinese ep4_night_talk_bella_label_1c1aa8c5:

    # mc "I need that. Someone who doesn't lie and keep secrets from me."
    mc "我需要这样的人。一个不对我撒谎、不瞒我秘密的人。"

# game/scripts/episode4/ep4_bella_route.rpy:61
translate schinese ep4_night_talk_bella_label_fb623a7e_1:

    # isa "..."
    isa "……"

# game/scripts/episode4/ep4_bella_route.rpy:63
translate schinese ep4_night_talk_bella_label_067afe92:

    # isa "What is it you need help with?"
    isa "你需要什么帮助？"

# game/scripts/episode4/ep4_bella_route.rpy:64
translate schinese ep4_night_talk_bella_label_65bcbf84:

    # isa "Is there another problem with your roommate?"
    isa "又跟室友出问题了？"

# game/scripts/episode4/ep4_bella_route.rpy:66
translate schinese ep4_night_talk_bella_label_94e29005:

    # mc "I changed dorms...but yeah...another roommate problem."
    mc "我换宿舍了……不过……算是又一个室友问题。"

# game/scripts/episode4/ep4_bella_route.rpy:68
translate schinese ep4_night_talk_bella_label_fedf4882:

    # isa "Did you get into another fight, like two nights before?"
    isa "你又打架了，像前两天那样？"

# game/scripts/episode4/ep4_bella_route.rpy:70
translate schinese ep4_night_talk_bella_label_277a8ce6:

    # mc "How did you know about that?"
    mc "你怎么知道的？"

# game/scripts/episode4/ep4_bella_route.rpy:71
translate schinese ep4_night_talk_bella_label_c1dff962:

    # mc "Oh..."
    mc "哦……"

# game/scripts/episode4/ep4_bella_route.rpy:72
translate schinese ep4_night_talk_bella_label_ecbee836:

    # mc "Jill..."
    mc "Jill……"

# game/scripts/episode4/ep4_bella_route.rpy:73
translate schinese ep4_night_talk_bella_label_1a0c68e5:

    # mc "No, it's nothing like that."
    mc "不，不是那种事。"

# game/scripts/episode4/ep4_bella_route.rpy:75
translate schinese ep4_night_talk_bella_label_70598cfc:

    # mc "Can you promise not to tell anyone about this? Even Jill...?"
    mc "你能保证不告诉任何人吗？包括 Jill……？"

# game/scripts/episode4/ep4_bella_route.rpy:77
translate schinese ep4_night_talk_bella_label_61a76343:

    # isa "I promise."
    isa "我保证。"

# game/scripts/episode4/ep4_bella_route.rpy:79
translate schinese ep4_night_talk_bella_label_b63ef50f:

    # mc "Remember that girl I told you about over lunch?"
    mc "还记得午餐时我跟你提过的那个女孩吗？"

# game/scripts/episode4/ep4_bella_route.rpy:81
translate schinese ep4_night_talk_bella_label_132afaf6:

    # isa "Which one? The ex or the crush?"
    isa "哪一个？前任还是暗恋的那个？"

# game/scripts/episode4/ep4_bella_route.rpy:83
translate schinese ep4_night_talk_bella_label_bd517272:

    # mc "The crush..."
    mc "暗恋的那个……"

# game/scripts/episode4/ep4_bella_route.rpy:84
translate schinese ep4_night_talk_bella_label_06d765d9:

    # mc "It turns out she's my roommate's girlfriend."
    mc "原来她是我室友的女朋友。"

# game/scripts/episode4/ep4_bella_route.rpy:86
translate schinese ep4_night_talk_bella_label_223d5f44:

    # isa "And your roommate, is he your friend?"
    isa "你的室友，是你的朋友吗？"

# game/scripts/episode4/ep4_bella_route.rpy:88
translate schinese ep4_night_talk_bella_label_a5b54ccb:

    # mc "She."
    mc "是「她」。"

# game/scripts/episode4/ep4_bella_route.rpy:90
translate schinese ep4_night_talk_bella_label_c2b02bd2:

    # isa "Oh..."
    isa "哦……"

# game/scripts/episode4/ep4_bella_route.rpy:92
translate schinese ep4_night_talk_bella_label_024a31ee:

    # mc "And yeah. She is my friend...and maybe something more...or...was something more."
    mc "而且是的。她是我的朋友……也许不止朋友……或者……曾经不止朋友。"

# game/scripts/episode4/ep4_bella_route.rpy:93
translate schinese ep4_night_talk_bella_label_70a444bd:

    # mc "I don't know."
    mc "我不知道。"

# game/scripts/episode4/ep4_bella_route.rpy:96
translate schinese ep4_night_talk_bella_label_f3c672b8:

    # isa "Start from the beginning. You know you want to."
    isa "从头说起吧。你知道你想说的。"

# game/scripts/episode4/ep4_bella_route.rpy:102
translate schinese ep4_night_talk2_bella_label_fb623a7e:

    # isa "..."
    isa "……"

# game/scripts/episode4/ep4_bella_route.rpy:103
translate schinese ep4_night_talk2_bella_label_2b35b6fe:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:106
translate schinese ep4_night_talk2_bella_label_7542a892:

    # mc "Did I overreact?"
    mc "我是不是反应过度了？"

# game/scripts/episode4/ep4_bella_route.rpy:108
translate schinese ep4_night_talk2_bella_label_034e30f5:

    # isa "Do you feel like you overreacted?"
    isa "你觉得你反应过度了吗？"

# game/scripts/episode4/ep4_bella_route.rpy:114
translate schinese ep4_night_talk2_bella_label_0920e421:

    # mc "Yeah, kinda..."
    mc "嗯，有一点……"

# game/scripts/episode4/ep4_bella_route.rpy:118
translate schinese ep4_night_talk2_bella_label_8866fd30:

    # mc "No. It didn't feel good, but I feel like I did the right thing."
    mc "不。感觉是不好受，但我觉得我做得对。"

# game/scripts/episode4/ep4_bella_route.rpy:120
translate schinese ep4_night_talk2_bella_label_72c9b2ca:

    # isa "Then there's your answer."
    isa "那这就是你的答案。"

# game/scripts/episode4/ep4_bella_route.rpy:122
translate schinese ep4_night_talk2_bella_label_026edb37:

    # mc "What would you have done?"
    mc "你会怎么做？"

# game/scripts/episode4/ep4_bella_route.rpy:124
translate schinese ep4_night_talk2_bella_label_0c60b9ba:

    # isa "When you get older, you don't act the same way as you do at your age."
    isa "等你再大些，就不会像你这个年纪这样行事了。"

# game/scripts/episode4/ep4_bella_route.rpy:125
translate schinese ep4_night_talk2_bella_label_04333cad:

    # isa "If you asked me now, I wouldn't be stupid enough to put myself into a position where I dated multiple girls at once."
    isa "现在你问我，我可不会蠢到让自己同时跟好几个女孩交往。"

# game/scripts/episode4/ep4_bella_route.rpy:126
translate schinese ep4_night_talk2_bella_label_de4dd1a1:

    # isa "Who do you think you are? Casanova?"
    isa "你以为你是谁？卡萨诺瓦吗？"

# game/scripts/episode4/ep4_bella_route.rpy:128
translate schinese ep4_night_talk2_bella_label_c808fe24:

    # mc "Who's that?"
    mc "那是谁？"

# game/scripts/episode4/ep4_bella_route.rpy:130
translate schinese ep4_night_talk2_bella_label_345addb2:

    # isa "Never mind..."
    isa "没什么……"

# game/scripts/episode4/ep4_bella_route.rpy:132
translate schinese ep4_night_talk2_bella_label_32b58e1d:

    # mc "What about teenage you? What would she have done?"
    mc "那十几岁的你呢？她会怎么做？"

# game/scripts/episode4/ep4_bella_route.rpy:134
translate schinese ep4_night_talk2_bella_label_f284dc9f:

    # isa "I can't deny that she might have been in that situation if she ever had found two guys to fall for."
    isa "我不能否认，如果她真遇到两个让她心动的男人，她可能也会陷入那种处境。"

# game/scripts/episode4/ep4_bella_route.rpy:138
translate schinese ep4_night_talk2_bella_label_79c3da41:

    # mc "She didn't?"
    mc "她没有？"

# game/scripts/episode4/ep4_bella_route.rpy:140
translate schinese ep4_night_talk2_bella_label_ea4b944e:

    # isa "No. Just one."
    isa "没有。只有一个。"

# game/scripts/episode4/ep4_bella_route.rpy:142
translate schinese ep4_night_talk2_bella_label_284f82ae:

    # mc "I get it. Thanks."
    mc "我明白了。谢谢。"

# game/scripts/episode4/ep4_bella_route.rpy:144
translate schinese ep4_night_talk2_bella_label_db21b511:

    # isa "Give it a rest and when it's not so fresh, find a way to forgive your friends and move on."
    isa "先放一放，等这件事不再那么鲜活时，找个方式原谅你的朋友，继续往前走。"

# game/scripts/episode4/ep4_bella_route.rpy:145
translate schinese ep4_night_talk2_bella_label_5d6d43be:

    # isa "It's the healthy thing to do."
    isa "这是对自己好的做法。"

# game/scripts/episode4/ep4_bella_route.rpy:146
translate schinese ep4_night_talk2_bella_label_8371df2c:

    # isa "It's time to get some rest."
    isa "该休息了。"

# game/scripts/episode4/ep4_bella_route.rpy:148
translate schinese ep4_night_talk2_bella_label_af698f75:

    # mc "Please..."
    mc "拜托……"

# game/scripts/episode4/ep4_bella_route.rpy:149
translate schinese ep4_night_talk2_bella_label_2afadf18:

    # mc "A little while longer."
    mc "再待一会儿。"

# game/scripts/episode4/ep4_bella_route.rpy:153
translate schinese ep4_night_talk2_bella_label_8174f344:

    # isa "*{i}Smack{/i}*"
    isa "*{i}啪{/i}*"

# game/scripts/episode4/ep4_bella_route.rpy:167
translate schinese ep4_morning_talk_bella_label_2b35b6fe:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:168
translate schinese ep4_morning_talk_bella_label_732574dd:

    # mc "(Oh...?)"
    mc "（哦……？）"

# game/scripts/episode4/ep4_bella_route.rpy:173
translate schinese ep4_morning_talk_bella_label_0266f53c:

    # mc "(Wow...)"
    mc "（哇……）"

# game/scripts/episode4/ep4_bella_route.rpy:181
translate schinese ep4_morning_talk_bella_label_3417a5d0:

    # isa "What are you doing?"
    isa "你在干什么？"

# game/scripts/episode4/ep4_bella_route.rpy:183
translate schinese ep4_morning_talk_bella_label_cb9a1fbd:

    # mc "Oh... Good morning!"
    mc "哦……早上好！"

# game/scripts/episode4/ep4_bella_route.rpy:185
translate schinese ep4_morning_talk_bella_label_e04f0aa5:

    # isa "Answer my question."
    isa "回答我的问题。"

# game/scripts/episode4/ep4_bella_route.rpy:187
translate schinese ep4_morning_talk_bella_label_8d081c7a:

    # mc "I...don't know. I felt like doing this."
    mc "我……不知道。我就是想这么做。"

# game/scripts/episode4/ep4_bella_route.rpy:189
translate schinese ep4_morning_talk_bella_label_0b58344c:

    # isa "Get up."
    isa "起来。"

# game/scripts/episode4/ep4_bella_route.rpy:191
translate schinese ep4_morning_talk_bella_label_efca21ae:

    # mc "Good morning, Bella."
    mc "早上好，Bella。"

# game/scripts/episode4/ep4_bella_route.rpy:193
translate schinese ep4_morning_talk_bella_label_adbd96d4:

    # isa "Morning."
    isa "早上好。"

# game/scripts/episode4/ep4_bella_route.rpy:195
translate schinese ep4_morning_talk_bella_label_f1ccf042:

    # isa "Oh... Get up."
    isa "哦……起来。"

# game/scripts/episode4/ep4_bella_route.rpy:198
translate schinese ep4_morning_talk_bella_label_2260d17c:

    # mc "I never saw that you had such a nice pool!"
    mc "我从不知道你家有个这么棒的泳池！"

# game/scripts/episode4/ep4_bella_route.rpy:200
translate schinese ep4_morning_talk_bella_label_33dd7bad:

    # isa "You miss a lot when you're drunk."
    isa "喝醉了会错过很多东西。"

# game/scripts/episode4/ep4_bella_route.rpy:202
translate schinese ep4_morning_talk_bella_label_5d616421:

    # mc "Shit! That reminds me..."
    mc "该死！这提醒了我……"

# game/scripts/episode4/ep4_bella_route.rpy:203
translate schinese ep4_morning_talk_bella_label_7aec641c:

    # mc "My beer! I'm supposed to drink ten per day!"
    mc "我的啤酒！我每天得喝十瓶！"

# game/scripts/episode4/ep4_bella_route.rpy:204
translate schinese ep4_morning_talk_bella_label_e86ff715:

    # mc "I need to get it from Maya's dorm..."
    mc "我得去 Maya 宿舍拿……"

# game/scripts/episode4/ep4_bella_route.rpy:205
translate schinese ep4_morning_talk_bella_label_5f634a34:

    # mc "...or have Derek pick it up, maybe."
    mc "……或者让 Derek 帮我取。"

# game/scripts/episode4/ep4_bella_route.rpy:206
translate schinese ep4_morning_talk_bella_label_fb623a7e:

    # isa "..."
    isa "……"

# game/scripts/episode4/ep4_bella_route.rpy:207
translate schinese ep4_morning_talk_bella_label_afd74152:

    # mc "What do you think?"
    mc "你觉得呢？"

# game/scripts/episode4/ep4_bella_route.rpy:209
translate schinese ep4_morning_talk_bella_label_668ff106:

    # isa "I think that the combination of you and alcohol isn't going to work out if you want to stay under my roof."
    isa "如果你想住在我这儿，我觉得你和酒精的组合行不通。"

# game/scripts/episode4/ep4_bella_route.rpy:211
translate schinese ep4_morning_talk_bella_label_ff725212:

    # mc "But...but..."
    mc "可……可……"

# game/scripts/episode4/ep4_bella_route.rpy:213
translate schinese ep4_morning_talk_bella_label_91fc2a51:

    # isa "But, but."
    isa "可什么可。"

# game/scripts/episode4/ep4_bella_route.rpy:215
translate schinese ep4_morning_talk_bella_label_9cd409e9:

    # mc "I have to!"
    mc "我必须喝！"

# game/scripts/episode4/ep4_bella_route.rpy:217
translate schinese ep4_morning_talk_bella_label_29477546:

    # isa "How are they monitoring your alcohol consumption?"
    isa "他们怎么监督你喝酒？"

# game/scripts/episode4/ep4_bella_route.rpy:219
translate schinese ep4_morning_talk_bella_label_6a974d65:

    # mc "Hm...they don't really bother to check it. They expect me to drink the beers in the cooler...that's about it."
    mc "嗯……他们其实不怎么检查。就是指望我把冷藏箱里的啤酒喝完……大概就这样。"

# game/scripts/episode4/ep4_bella_route.rpy:221
translate schinese ep4_morning_talk_bella_label_c4fe53a3:

    # isa "Then how about pouring out the beer and saving the empty bottles?"
    isa "那把啤酒倒掉，留下空瓶子怎么样？"

# game/scripts/episode4/ep4_bella_route.rpy:223
translate schinese ep4_morning_talk_bella_label_fb5f6ca8:

    # mc "I can't do that... That's cheating."
    mc "我不能那样……那是作弊。"

# game/scripts/episode4/ep4_bella_route.rpy:224
translate schinese ep4_morning_talk_bella_label_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:225
translate schinese ep4_morning_talk_bella_label_3e565d04:

    # mc "They wouldn't know that."
    mc "他们不会知道的。"

# game/scripts/episode4/ep4_bella_route.rpy:227
translate schinese ep4_morning_talk_bella_label_24973739:

    # isa "Right. You know..."
    isa "是啊。不过你知道……"

# game/scripts/episode4/ep4_bella_route.rpy:228
translate schinese ep4_morning_talk_bella_label_f54c8b27:

    # isa "...unless I told them."
    isa "……除非我告诉他们。"

# game/scripts/episode4/ep4_bella_route.rpy:230
translate schinese ep4_morning_talk_bella_label_ae2a3343:

    # mc "You wouldn't!"
