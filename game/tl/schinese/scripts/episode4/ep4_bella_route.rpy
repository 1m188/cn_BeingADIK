translate schinese ep4_dinner_bella_label2_1e407836:

    # isa "No one is born a cook. Like everything in life, it takes practice."
    isa "没有人天生就是厨师。就像人生中的一切，都需要练习。"

# game/scripts/episode4/ep4_bella_route.rpy:800
translate schinese ep4_dinner_bella_label2_6b92ccc9:

    # mc "And interest..."
    mc "还有兴趣……"

# game/scripts/episode4/ep4_bella_route.rpy:802
translate schinese ep4_dinner_bella_label2_438f636e:

    # isa "That's true. Wouldn't you like to get better at it?"
    isa "说得对。你不想把它练好吗？"

# game/scripts/episode4/ep4_bella_route.rpy:804
translate schinese ep4_dinner_bella_label2_a3b1a71e:

    # mc "I guess."
    mc "也许吧。"

# game/scripts/episode4/ep4_bella_route.rpy:805
translate schinese ep4_dinner_bella_label2_2b35b6fe:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:806
translate schinese ep4_dinner_bella_label2_6c743c85:

    # mc "Could you teach me?"
    mc "你能教我吗？"

# game/scripts/episode4/ep4_bella_route.rpy:808
translate schinese ep4_dinner_bella_label2_d7c110a2:

    # isa "I suppose."
    isa "可以。"

# game/scripts/episode4/ep4_bella_route.rpy:813
translate schinese ep4_dinner_bella_label2_ceb3a739:

    # isa "By the way, I would like to thank you for watering my plants."
    isa "顺便说一句，谢谢你帮我浇花。"

# game/scripts/episode4/ep4_bella_route.rpy:814
translate schinese ep4_dinner_bella_label2_8e4eab50:

    # isa "I was pleasantly surprised. You did a great job."
    isa "我很惊喜。你做得很好。"

# game/scripts/episode4/ep4_bella_route.rpy:817
translate schinese ep4_dinner_bella_label2_749ede86:

    # isa "Also, thanks for the help with the dishes."
    isa "还有，谢谢你帮忙洗碗。"

# game/scripts/episode4/ep4_bella_route.rpy:822
translate schinese ep4_dinner_bella_label2_ecf5755a:

    # isa "Thank you."
    isa "谢谢。"

# game/scripts/episode4/ep4_bella_route.rpy:837
translate schinese ep4_dinner_bella_label2_b115feae:

    # mc "You're welcome. I figured I would do a better job helping you in a semi-sober state."
    mc "不客气。我想着半醉状态下帮你，应该能做得更好。"

# game/scripts/episode4/ep4_bella_route.rpy:839
translate schinese ep4_dinner_bella_label2_57184c13:

    # mc "You're welcome."
    mc "不客气。"

# game/scripts/episode4/ep4_bella_route.rpy:844
translate schinese ep4_dinner_bella_label2_ceb3a739_1:

    # isa "By the way, I would like to thank you for watering my plants."
    isa "顺便说一句，谢谢你帮我浇花。"

# game/scripts/episode4/ep4_bella_route.rpy:845
translate schinese ep4_dinner_bella_label2_70f45735:

    # isa "You did a good job."
    isa "你做得很好。"

# game/scripts/episode4/ep4_bella_route.rpy:848
translate schinese ep4_dinner_bella_label2_749ede86_1:

    # isa "Also, thanks for the help with the dishes."
    isa "还有，谢谢你帮忙洗碗。"

# game/scripts/episode4/ep4_bella_route.rpy:850
translate schinese ep4_dinner_bella_label2_ecf5755a_1:

    # isa "Thank you."
    isa "谢谢。"

# game/scripts/episode4/ep4_bella_route.rpy:853
translate schinese ep4_dinner_bella_label2_b115feae_1:

    # mc "You're welcome. I figured I would do a better job helping you in a semi-sober state."
    mc "不客气。我想着半醉状态下帮你，应该能做得更好。"

# game/scripts/episode4/ep4_bella_route.rpy:855
translate schinese ep4_dinner_bella_label2_57184c13_1:

    # mc "You're welcome."
    mc "不客气。"

# game/scripts/episode4/ep4_bella_route.rpy:862
translate schinese ep4_dinner_bella_label2_c4c9c50d:

    # isa "And while we're at it, I might as well show you how to water plants..."
    isa "既然说到这个，我顺便教教你怎么浇花……"

# game/scripts/episode4/ep4_bella_route.rpy:863
translate schinese ep4_dinner_bella_label2_18e18109:

    # isa "...because I will have to replace several of them."
    isa "……因为我得换掉好几盆。"

# game/scripts/episode4/ep4_bella_route.rpy:864
translate schinese ep4_dinner_bella_label2_aa3aa0b1:

    # isa "You watered them way too much."
    isa "你浇得太多了。"

# game/scripts/episode4/ep4_bella_route.rpy:866
translate schinese ep4_dinner_bella_label2_1c29af48:

    # mc "Whoops... I'm sorry."
    mc "哎呀……对不起。"

# game/scripts/episode4/ep4_bella_route.rpy:868
translate schinese ep4_dinner_bella_label2_69a39a8f:

    # mc "I thought I would do a better job helping you in a semi-sober state."
    mc "我以为半醉状态下帮你，会做得更好。"

# game/scripts/episode4/ep4_bella_route.rpy:869
translate schinese ep4_dinner_bella_label2_365d91cd:

    # mc "Apparently not."
    mc "显然不是。"

# game/scripts/episode4/ep4_bella_route.rpy:873
translate schinese ep4_dinner_bella_label2_ea489513:

    # isa "But thanks for the help with the dishes."
    isa "不过还是要谢谢你的碗。"

# game/scripts/episode4/ep4_bella_route.rpy:883
translate schinese ep4_dinner_bella_label2_274f2793:

    # mc "Hey... I just remembered something..."
    mc "嘿……我刚想起一件事……"

# game/scripts/episode4/ep4_bella_route.rpy:884
translate schinese ep4_dinner_bella_label2_f81ae2e2:

    # mc "You never told me about Derek's reputation."
    mc "你从没跟我说过 Derek 的名声。"

# game/scripts/episode4/ep4_bella_route.rpy:886
translate schinese ep4_dinner_bella_label2_64510527:

    # isa "You really want to hear it?"
    isa "你真想听？"

# game/scripts/episode4/ep4_bella_route.rpy:888
translate schinese ep4_dinner_bella_label2_b92fb6df:

    # mc "Yeah, of course!"
    mc "嗯，当然！"

# game/scripts/episode4/ep4_bella_route.rpy:890
translate schinese ep4_dinner_bella_label2_084bde86:

    # isa "Ok..."
    isa "好吧……"

# game/scripts/episode4/ep4_bella_route.rpy:891
translate schinese ep4_dinner_bella_label2_4af0b12f:

    # isa "They say that he's somewhat of a genius."
    isa "据说他有点天才。"

# game/scripts/episode4/ep4_bella_route.rpy:893
translate schinese ep4_dinner_bella_label2_2b35b6fe_1:

    # mc "..."
    mc "……"

# game/scripts/episode4/ep4_bella_route.rpy:894
translate schinese ep4_dinner_bella_label2_c42d4a99:

    # mc "Derek?"
    mc "Derek？"

# game/scripts/episode4/ep4_bella_route.rpy:896
translate schinese ep4_dinner_bella_label2_4a225dce:

    # isa "Yes."
    isa "对。"

# game/scripts/episode4/ep4_bella_route.rpy:898
translate schinese ep4_dinner_bella_label2_17e39ae7:

    # mc "Shirtless Derek..."
    mc "不穿上衣的 Derek……"

# game/scripts/episode4/ep4_bella_route.rpy:899
translate schinese ep4_dinner_bella_label2_c452d991:

    # mc "...with the dildo helmet?"
    mc "……戴着假阳具头盔的那个？"

# game/scripts/episode4/ep4_bella_route.rpy:901
translate schinese ep4_dinner_bella_label2_d37ee8e6:

    # isa "That's Derek, all right."
    isa "那就是 Derek，没错。"

# game/scripts/episode4/ep4_bella_route.rpy:903
translate schinese ep4_dinner_bella_label2_63894a33:

    # mc "He's not a genius."
    mc "他不是天才。"

# game/scripts/episode4/ep4_bella_route.rpy:905
translate schinese ep4_dinner_bella_label2_e5828667:

    # isa "Cathy was surprised, too."
    isa "Cathy 也很惊讶。"

# game/scripts/episode4/ep4_bella_route.rpy:906
translate schinese ep4_dinner_bella_label2_9bb31aff:

    # isa "But he is passing her classes with flying colors."
    isa "但他确实以优异的成绩通过了她的课。"

# game/scripts/episode4/ep4_bella_route.rpy:908
translate schinese ep4_dinner_bella_label2_edc2c8a4:

    # mc "(Derek's cheating and they think he's a genius...)"
    mc "（Derek 在作弊，而他们以为他是天才……）"

# game/scripts/episode4/ep4_bella_route.rpy:909
translate schinese ep4_dinner_bella_label2_59bdf3b1:

    # mc "(He really managed to fool them.)"
    mc "（他真把他们都骗过去了。）"

# game/scripts/episode4/ep4_bella_route.rpy:910
translate schinese ep4_dinner_bella_label2_9e315106:

    # mc "Oh, good for him, then."
    mc "哦，那他可真厉害。"

# game/scripts/episode4/ep4_bella_route.rpy:912
translate schinese ep4_dinner_bella_label2_7cead2e7:

    # isa "Cathy cuts him some slack because of it."
    isa "Cathy 因此对他格外宽容。"

# game/scripts/episode4/ep4_bella_route.rpy:914
translate schinese ep4_dinner_bella_label2_1caddde0:

    # mc "Jade doesn't."
    mc "Jade 可不会。"

# game/scripts/episode4/ep4_bella_route.rpy:916
translate schinese ep4_dinner_bella_label2_21dbf1f8:

    # isa "Well, she's a bit..."
    isa "嗯，她有点……"

# game/scripts/episode4/ep4_bella_route.rpy:917
translate schinese ep4_dinner_bella_label2_79d94bd8:

    # isa "Never mind."
    isa "算了。"

# game/scripts/episode4/ep4_bella_route.rpy:919
translate schinese ep4_dinner_bella_label2_a81bede7:

    # mc "Finish your sentence."
    mc "把话说完。"

# game/scripts/episode4/ep4_bella_route.rpy:921
translate schinese ep4_dinner_bella_label2_09013411:

    # isa "\"Finish your sentence\"?"
    isa "「把话说完」？"

# game/scripts/episode4/ep4_bella_route.rpy:923
translate schinese ep4_dinner_bella_label2_ddb1f21b:

    # mc "It sounds like something you would say to me."
    mc "听起来像是你会对我说的话。"

# game/scripts/episode4/ep4_bella_route.rpy:925
translate schinese ep4_dinner_bella_label2_0f8a9916:

    # mc "I think you're starting to rub me off."
    mc "我觉得你开始把我带偏了。"

# game/scripts/episode4/ep4_bella_route.rpy:927
translate schinese ep4_dinner_bella_label2_e042468e:

    # isa "What?"
    isa "什么？"

# game/scripts/episode4/ep4_bella_route.rpy:928
translate schinese ep4_dinner_bella_label2_9c0aaabe:

    # mc "...r-rub off on me."
    mc "……开始影响我了。"

# game/scripts/episode4/ep4_bella_route.rpy:930
translate schinese ep4_dinner_bella_label2_06a5d420:

    # mc "I think you're starting to rub off on me."
    mc "我觉得你开始影响我了。"

# game/scripts/episode4/ep4_bella_route.rpy:932
translate schinese ep4_dinner_bella_label2_90b5a641:

    # isa "Fine."
    isa "行吧。"

# game/scripts/episode4/ep4_bella_route.rpy:933
translate schinese ep4_dinner_bella_label2_60cfc2d2:

    # isa "Jade's a bit uptight."
    isa "Jade 有点死板。"

# game/scripts/episode4/ep4_bella_route.rpy:934
translate schinese ep4_dinner_bella_label2_cc7990b0:

    # isa "She's not as nice as Cathy..."
    isa "她不像 Cathy 那么亲切……"

# game/scripts/episode4/ep4_bella_route.rpy:935
translate schinese ep4_dinner_bella_label2_7ed35766:

    # isa "...when it comes to students."
    isa "……对学生来说。"

# game/scripts/episode4/ep4_bella_route.rpy:939
translate schinese ep4_dinner_bella_label2_566c91dc:

    # mc "She's been nothing but nice to me."
    mc "她对我一直很好。"

# game/scripts/episode4/ep4_bella_route.rpy:941
translate schinese ep4_dinner_bella_label2_7137db6c:

    # isa "Well, you're no Derek."
    isa "嗯，你毕竟不是 Derek。"

# game/scripts/episode4/ep4_bella_route.rpy:943
translate schinese ep4_dinner_bella_label2_3313e913:

    # mc "Do you like Jade? I picked up on something in your tone."
    mc "你喜欢 Jade 吗？我从你的语气里听出了点什么。"

# game/scripts/episode4/ep4_bella_route.rpy:945
translate schinese ep4_dinner_bella_label2_a6d712d4:

    # isa "Let's not get into it."
    isa "我们别谈这个。"

# game/scripts/episode4/ep4_bella_route.rpy:947
translate schinese ep4_dinner_bella_label2_cb86119d:

    # mc "That sounded like a no to me."
    mc "在我听来这像是「不喜欢」。"

# game/scripts/episode4/ep4_bella_route.rpy:950
translate schinese ep4_dinner_bella_label2_0aa64e39:

    # isa "Once again, eat your dinner."
    isa "再说一次，吃你的晚饭。"

# game/scripts/episode4/ep4_bella_route.rpy:952
translate schinese ep4_dinner_bella_label2_cf75be19:

    # isa "Eat your dinner."
    isa "吃你的晚饭。"

# game/scripts/episode4/ep4_bella_route.rpy:958
translate schinese ep4_dinner_bella_label2_97fbe86a:

    # isa "I spoke to Jill over lunch."
    isa "我午餐时跟 Jill 聊过了。"

# game/scripts/episode4/ep4_bella_route.rpy:959
translate schinese ep4_dinner_bella_label2_5dd3be78:

    # isa "I heard you're going out on a date tomorrow."
    isa "我听说你明天要出去约会。"

# game/scripts/episode4/ep4_bella_route.rpy:961
translate schinese ep4_dinner_bella_label2_9e0bdd18:

    # mc "Yeah, that's right. We are."
    mc "嗯，没错。我们要约会。"

# game/scripts/episode4/ep4_bella_route.rpy:962
translate schinese ep4_dinner_bella_label2_e76dec82:

    # mc "Are you ok with that?"
    mc "你不在意吗？"

# game/scripts/episode4/ep4_bella_route.rpy:964
translate schinese ep4_dinner_bella_label2_428cc17e:

    # isa "Of course. I wouldn't have said so to her otherwise."
    isa "当然。不然我也不会跟她那么说。"

# game/scripts/episode4/ep4_bella_route.rpy:967
translate schinese ep4_dinner_bella_label2_1e20bf40:

    # mc "Yeah, but...after what happened today, between us..."
    mc "嗯，但是……今天在我们之间发生的事……"

# game/scripts/episode4/ep4_bella_route.rpy:968
translate schinese ep4_dinner_bella_label2_22f4dc68:

    # mc "Doesn't that make you change your mind?"
    mc "这不会让你改变主意吗？"

# game/scripts/episode4/ep4_bella_route.rpy:969
translate schinese ep4_dinner_bella_label2_fb623a7e:

    # isa "..."
    isa "……"

# game/scripts/episode4/ep4_bella_route.rpy:971
translate schinese ep4_dinner_bella_label2_169c877c:

    # mc "It's just that she's your best friend."
    mc "只是她是你最好的朋友。"

# game/scripts/episode4/ep4_bella_route.rpy:972
translate schinese ep4_dinner_bella_label2_70ebd93a:

    # mc "Doesn't that make you feel weird? It makes me feel weird."
    mc "你不觉得奇怪吗？我都觉得奇怪。"

# game/scripts/episode4/ep4_bella_route.rpy:974
translate schinese ep4_dinner_bella_label2_5ca874c5:

    # isa "Go out on a date with her."
    isa "去跟她约会吧。"

# game/scripts/episode4/ep4_bella_route.rpy:975
translate schinese ep4_dinner_bella_label2_feb440e1:

    # isa "What happened this afternoon...it was a one-time thing."
    isa "今天下午的事……只是一次性的。"

# game/scripts/episode4/ep4_bella_route.rpy:977
translate schinese ep4_dinner_bella_label2_4c4380c6:

    # mc "Was it really?"
    mc "真的吗？"

# game/scripts/episode4/ep4_bella_route.rpy:979
translate schinese ep4_dinner_bella_label2_4397e066:

    # isa "It's not something Jill should know about or prevent you two from dating."
    isa "这不是 Jill 该知道的事，也不该阻止你们俩约会。"

# game/scripts/episode4/ep4_bella_route.rpy:984
translate schinese ep4_dinner_bella_label2_4b21a703:

    # mc "Ok...but for what it's worth, it wasn't a one-time thing for me."
    mc "好吧……不过不管怎样，对我来说那不是一次性的。"

# game/scripts/episode4/ep4_bella_route.rpy:985
translate schinese ep4_dinner_bella_label2_3e45d669:

    # mc "I think I want more..."
    mc "我觉得我想要更多……"

# game/scripts/episode4/ep4_bella_route.rpy:987
translate schinese ep4_dinner_bella_label2_fb623a7e_1:

    # isa "..."
    isa "……"

# game/scripts/episode4/ep4_bella_route.rpy:989
translate schinese ep4_dinner_bella_label2_0f240219:

    # mc "If you say so..."
    mc "既然你这么说……"

# game/scripts/episode4/ep4_bella_route.rpy:994
translate schinese ep4_dinner_bella_label2_1068ca45:

    # isa "How about tonight? Any plans?"
    isa "那今晚呢？有什么安排吗？"

# game/scripts/episode4/ep4_bella_route.rpy:995
translate schinese ep4_dinner_bella_label2_dca0fb67:

    # isa "I'm assuming that you're not going to stay home and study during your Hell Week."
    isa "我猜你地狱周期间不会待在家里学习吧。"

# game/scripts/episode4/ep4_bella_route.rpy:998
translate schinese ep4_dinner_bella_label2_3fea1db8:

    # mc "I was invited to a movie night, but I'm gonna study a bit before that."
    mc "有人邀我去电影之夜，不过去之前我想先复习一会儿。"

# game/scripts/episode4/ep4_bella_route.rpy:1000
translate schinese ep4_dinner_bella_label2_2c00729d:

    # isa "I see."
    isa "我明白了。"

# game/scripts/episode4/ep4_bella_route.rpy:1001
translate schinese ep4_dinner_bella_label2_28eec1ca:

    # isa "I'll lend you a spare key if you promise not to lose it."
    isa "如果你保证不弄丢，我可以借你一把备用钥匙。"

# game/scripts/episode4/ep4_bella_route.rpy:1004
translate schinese ep4_dinner_bella_label2_b66adaf9:

    # mc "It's tough to promise such a thing, but I'll try."
    mc "这种事很难保证，但我会小心。"

# game/scripts/episode4/ep4_bella_route.rpy:1006
translate schinese ep4_dinner_bella_label2_0ce15b6c:

    # mc "That was actually my plan."
    mc "那其实正是我的计划。"

# game/scripts/episode4/ep4_bella_route.rpy:1007
translate schinese ep4_dinner_bella_label2_42e19121:

    # mc "We don't have any Hell Week activities planned for tonight."
    mc "今晚我们没有安排任何地狱周活动。"

# game/scripts/episode4/ep4_bella_route.rpy:1008
translate schinese ep4_dinner_bella_label2_d2db26cd:

    # mc "So, I figured I could have a date with my books over some beer."
    mc "所以，我打算边喝啤酒边跟书本约个会。"

# game/scripts/episode4/ep4_bella_route.rpy:1011
translate schinese ep4_dinner_bella_label2_ce0ec5e3:

    # isa "All right. I'll do the same..."
    isa "好吧。我也一样……"

# game/scripts/episode4/ep4_bella_route.rpy:1020
translate schinese ep4_bella_study_label_7dc20311:

    # "+10%% score on your next English test.\nYour total bonus for the next test is [bonusPercentageEnglish]%%."
    "下次英语测验加成 10%%。\n下次测验的总加成为 [bonusPercentageEnglish]%%。"

# game/scripts/episode4/ep4_bella_route.rpy:1023
translate schinese ep4_bella_study_label_f3f698d4:

    # "+10%% score on your next Math test.\nYour total bonus for the next test is [bonusPercentageMath]%%."
    "下次数学测验加成 10%%。\n下次测验的总加成为 [bonusPercentageMath]%%。"

# game/scripts/episode4/ep4_bella_route.rpy:1026
translate schinese ep4_bella_study_label_7b599f32:

    # "+10%% score on your next Gender Studies test.\nYour total bonus for the next test is [bonusPercentageGender]%%."
    "下次性别研究测验加成 10%%。\n下次测验的总加成为 [bonusPercentageGender]%%。"

# game/scripts/episode4/ep4_bella_route.rpy:1027
translate schinese ep4_bella_study_label_19b90726:

    # mc "(This is boring...)"
    mc "（真无聊……）"

# game/scripts/episode4/ep4_bella_route.rpy:1028
translate schinese ep4_bella_study_label_e243091e:

    # mc "(The only thing I get from this is that I know I don't wanna work with any of these subjects in the future...)"
    mc "（我唯一学到的，就是知道自己以后绝不想跟这些科目打交道……）"

# game/scripts/episode4/ep4_bella_route.rpy:1030
translate schinese ep4_bella_study_label_db3a0c26:

    # mc "(I have no clue if Bella is enjoying herself...)"
    mc "（我完全不知道 Bella 是否乐在其中……）"

# game/scripts/episode4/ep4_bella_route.rpy:1031
translate schinese ep4_bella_study_label_1e86af4f:

    # mc "(Haha! She could probably be reading a comedy or a thriller and still look the same.)"
    mc "（哈哈！她大概不管读喜剧还是惊悚小说，都是这副表情。）"

# game/scripts/episode4/ep4_bella_route.rpy:1037
translate schinese ep4_bella_study_label_7dc20311_1:

    # "+10%% score on your next English test.\nYour total bonus for the next test is [bonusPercentageEnglish]%%."
    "下次英语测验加成 10%%。\n下次测验的总加成为 [bonusPercentageEnglish]%%。"

# game/scripts/episode4/ep4_bella_route.rpy:1040
translate schinese ep4_bella_study_label_f3f698d4_1:

    # "+10%% score on your next Math test.\nYour total bonus for the next test is [bonusPercentageMath]%%."
    "下次数学测验加成 10%%。\n下次测验的总加成为 [bonusPercentageMath]%%。"

# game/scripts/episode4/ep4_bella_route.rpy:1043
translate schinese ep4_bella_study_label_7b599f32_1:

    # "+10%% score on your next Gender Studies test.\nYour total bonus for the next test is [bonusPercentageGender]%%."
    "下次性别研究测验加成 10%%。\n下次测验的总加成为 [bonusPercentageGender]%%。"

# game/scripts/episode4/ep4_bella_route.rpy:1044
translate schinese ep4_bella_study_label_73d56a79:

    # mc "(Study...study...study...)"
    mc "（学习……学习……学习……）"

# game/scripts/episode4/ep4_bella_route.rpy:1045
translate schinese ep4_bella_study_label_dff23297:

    # mc "(I wonder when the fun classes will start.)"
    mc "（不知道有趣的课什么时候才开始。）"

# game/scripts/episode4/ep4_bella_route.rpy:1046
translate schinese ep4_bella_study_label_f4c9010d:

    # mc "(Probably next semester...)"
    mc "（大概要下学期吧……）"

# game/scripts/episode4/ep4_bella_route.rpy:1048
translate schinese ep4_bella_study_label_1909bb73:

    # mc "(It would be cool to take a science class!)"
    mc "（要是能选门理科课就好了！）"

# game/scripts/episode4/ep4_bella_route.rpy:1049
translate schinese ep4_bella_study_label_91582c4c:

    # mc "(Oh, and what Jill recommended me...economics.)"
    mc "（哦，还有 Jill 推荐我的……经济学。）"

# game/scripts/episode4/ep4_bella_route.rpy:1050
translate schinese ep4_bella_study_label_ad5552b8:

    # mc "(Although that doesn't sound much fun.)"
    mc "（虽然听起来不怎么有趣。）"

# game/scripts/episode4/ep4_bella_route.rpy:1051
translate schinese ep4_bella_study_label_0b6da0a0:

    # mc "(The last time I took advice from someone with choosing a class I ended up listening to girls ranting...)"
    mc "（上次我听别人建议选课，结果落得听一群女生发牢骚……）"

# game/scripts/episode4/ep4_bella_route.rpy:1053
translate schinese ep4_bella_study_label_229f26ba:

    # mc "(Hm...shouldn't she have more books than this?)"
    mc "（嗯……她的书不应该更多吗？）"

# game/scripts/episode4/ep4_bella_route.rpy:1054
translate schinese ep4_bella_study_label_7472fcfb:

    # isa "Something the matter?"
    isa "有什么问题吗？"

# game/scripts/episode4/ep4_bella_route.rpy:1056
translate schinese ep4_bella_study_label_91d81a80:

    # mc "Huh? No."
    mc "啊？没有。"

# game/scripts/episode4/ep4_bella_route.rpy:1058
translate schinese ep4_bella_study_label_bed9caf0:

    # isa "You've been studying for a while now; it seems like your head's not in it anymore."
    isa "你已经学了好一会儿了；看起来心思已经不在学习上了。"

# game/scripts/episode4/ep4_bella_route.rpy:1060
translate schinese ep4_bella_study_label_a82a727e:

    # mc "I was just looking at your bookshelf and I find it weird that you don't have more books."
    mc "我只是在看你的书架，觉得你书不多挺奇怪的。"

# game/scripts/episode4/ep4_bella_route.rpy:1061
translate schinese ep4_bella_study_label_47a565a9:

    # mc "I know you have more upstairs, but still... I was expecting there to be a lot more."
    mc "我知道楼上还有，但还是……我原以为会多得多。"

# game/scripts/episode4/ep4_bella_route.rpy:1063
translate schinese ep4_bella_study_label_27584f20:

    # isa "Because I'm a librarian?"
    isa "就因为我是图书管理员？"

# game/scripts/episode4/ep4_bella_route.rpy:1065
translate schinese ep4_bella_study_label_e9a28e46:

    # mc "Yeah!"
    mc "好！"

# game/scripts/episode4/ep4_bella_route.rpy:1067
translate schinese ep4_bella_study_label_34a16cf8:

    # isa "I don't bring the library home with me."
    isa "我不会把图书馆搬回家。"

# game/scripts/episode4/ep4_bella_route.rpy:1068
translate schinese ep4_bella_study_label_a25139da:

    # isa "I keep the books I love and get rid of the ones I know I won't read again."
    isa "我留下我爱的书，丢掉那些我知道不会再读的。"

# game/scripts/episode4/ep4_bella_route.rpy:1069
translate schinese ep4_bella_study_label_59cf02d3:

    # isa "And I have some space for new ones that I haven't had the time to enjoy."
    isa "还要留些空间，给那些我还没来得及享受的新书。"

# game/scripts/episode4/ep4_bella_route.rpy:1071
translate schinese ep4_bella_study_label_27ca3267:

    # mc "You read a book more than once?"
    mc "你会把一本书读一遍以上？"

# game/scripts/episode4/ep4_bella_route.rpy:1073
translate schinese ep4_bella_study_label_b22a42a6:

    # isa "Do you find it weird that people watch the same movies or listen to the same songs over and over, too?"
    isa "人们反复看同一部电影、听同一首歌，你也会觉得奇怪吗？"

# game/scripts/episode4/ep4_bella_route.rpy:1075
translate schinese ep4_bella_study_label_989f51f6:

    # mc "No, but reading just seems like a bigger chore to me."
    mc "不，但读书对我来说更像是件苦差事。"

# game/scripts/episode4/ep4_bella_route.rpy:1077
translate schinese ep4_bella_study_label_72de0f83:

    # isa "It depends on what you read."
    isa "那要看读的是什么。"

# game/scripts/episode4/ep4_bella_route.rpy:1078
translate schinese ep4_bella_study_label_bb2774bd:

    # isa "There are a lot of boring books..."
    isa "世上有很多无聊的书……"

# game/scripts/episode4/ep4_bella_route.rpy:1079
translate schinese ep4_bella_study_label_51c330b9:

    # isa "Poorly written books..."
    isa "写得很差的书……"

# game/scripts/episode4/ep4_bella_route.rpy:1080
translate schinese ep4_bella_study_label_98d8f118:

    # isa "Self-indulgent drivel."
    isa "还有自恋的胡言乱语。"

# game/scripts/episode4/ep4_bella_route.rpy:1082
translate schinese ep4_bella_study_label_d47e3675:

    # isa "You have to sift through a lot to find what you like."
    isa "你得翻过很多书，才能找到你喜欢的。"

# game/scripts/episode4/ep4_bella_route.rpy:1083
translate schinese ep4_bella_study_label_f32472c7:

    # isa "Once you find a certain genre or author that speaks to you..."
    isa "一旦你找到某个打动你的类型或作者……"

# game/scripts/episode4/ep4_bella_route.rpy:1084
translate schinese ep4_bella_study_label_0cc43d7f:

    # isa "...you'll notice that there are so many you want to read that you didn't see before."
    isa "……你会发现，有那么多你以前没留意、却想读的书。"

# game/scripts/episode4/ep4_bella_route.rpy:1086
translate schinese ep4_bella_study_label_1f83b5b4:

    # mc "All we do in school is reading."
    mc "在学校我们整天就是读书。"

# game/scripts/episode4/ep4_bella_route.rpy:1087
translate schinese ep4_bella_study_label_9ba7a8cc:

    # mc "It gets tiresome, and my head always feels full afterward."
    mc "这很累人，而且读完后脑子总是满满的。"

# game/scripts/episode4/ep4_bella_route.rpy:1089
translate schinese ep4_bella_study_label_d1e78a23:

    # isa "When you read to learn, it's the learning part that takes its toll on you."
    isa "当你为了学习而读，真正消耗你的是「学习」本身。"

# game/scripts/episode4/ep4_bella_route.rpy:1090
translate schinese ep4_bella_study_label_619781d1:

    # isa "Reading for enjoyment is different, but I understand where you're coming from."
    isa "为乐趣而读就不一样了，不过我理解你的感受。"

# game/scripts/episode4/ep4_bella_route.rpy:1091
translate schinese ep4_bella_study_label_4ff8c18d:

    # isa "I rarely read novels when I went to college. It was mostly just class literature."
    isa "我上大学时很少读小说。基本只读课堂教材。"

# game/scripts/episode4/ep4_bella_route.rpy:1092
translate schinese ep4_bella_study_label_7c3b586a:

    # isa "The real passion for reading came to me later on in life."
    isa "对阅读真正的热爱，是后来才来到我身边的。"

# game/scripts/episode4/ep4_bella_route.rpy:1094
translate schinese ep4_bella_study_label_a266cdfd:

    # mc "That's interesting. I have one passion in my life..."
    mc "真有意思。我这一生有一个热爱……"

# game/scripts/episode4/ep4_bella_route.rpy:1095
translate schinese ep4_bella_study_label_54be34f0:

    # mc "Music...and that's a big one."
    mc "音乐……而且是个很大的热爱。"

# game/scripts/episode4/ep4_bella_route.rpy:1099
translate schinese ep4_bella_study_label_f85497b6:

    # isa "I heard you play before."
    isa "我之前听你弹过。"

# game/scripts/episode4/ep4_bella_route.rpy:1101
translate schinese ep4_bella_study_label_d174945d:

    # mc "You did? I thought you were outside."
    mc "你听过？我以为你在外面。"

# game/scripts/episode4/ep4_bella_route.rpy:1103
translate schinese ep4_bella_study_label_afe195c1:

    # isa "I went inside for a glass of water and heard you play."
    isa "我进屋倒了杯水，听到了你弹琴。"

# game/scripts/episode4/ep4_bella_route.rpy:1104
translate schinese ep4_bella_study_label_645451c7:

    # isa "It was beautiful. I wouldn't mind hearing more of it."
    isa "很美。我不介意多听一些。"

# game/scripts/episode4/ep4_bella_route.rpy:1106
translate schinese ep4_bella_study_label_68d4bba2:

    # mc "(That was a real compliment...)"
    mc "（那是真心实意的赞美……）"

# game/scripts/episode4/ep4_bella_route.rpy:1107
translate schinese ep4_bella_study_label_fec9c490:

    # mc "(Funny how it means a lot to hear that from her.)"
    mc "（真有意思，她这句话对我来说分量很重。）"

# game/scripts/episode4/ep4_bella_route.rpy:1108
translate schinese ep4_bella_study_label_bb0eeaf4:

    # mc "Thank you."
    mc "谢谢你。"

# game/scripts/episode4/ep4_bella_route.rpy:1113
translate schinese ep4_bella_study_label_79394ebd:

    # mc "I should go get ready for the movie night."
    mc "我该去准备电影之夜了。"

# game/scripts/episode4/ep4_bella_route.rpy:1115
translate schinese ep4_bella_study_label_109f9626:

    # isa "All right, I'll go get that spare key for you."
    isa "好，我去给你拿那把备用钥匙。"

# game/scripts/episode4/ep4_bella_route.rpy:1122
translate schinese ep4_bella_study_label_9720f127:

    # isa "Are you feeling tired?"
    isa "你累了吗？"

# game/scripts/episode4/ep4_bella_route.rpy:1124
translate schinese ep4_bella_study_label_8ee7a52e:

    # mc "Yeah, I'm starting to."
    mc "嗯，开始有点了。"

# game/scripts/episode4/ep4_bella_route.rpy:1126
translate schinese ep4_bella_study_label_a234cc9f:

    # isa "Let's go then. I'll help you turn the sofa into a bed."
    isa "那我们走吧。我帮你把沙发铺成床。"

