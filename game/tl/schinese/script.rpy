    # js "I'm number 14 in line..."
    js "我排在候补第 14 位……"

# game/script.rpy:338
translate schinese getPlayerName_4b0feb91:

    # mc "That sucks... It must be a popular degree."
    mc "真够糟的……这专业一定很热门。"

# game/script.rpy:340
translate schinese getPlayerName_52c0a091:

    # js "Yeah, it's for a business degree. My dad really wanted me to go, since he went there too."
    js "嗯，是商科学位。我爸特别想让我去，因为他当年也读的这所学校。"

# game/script.rpy:342
translate schinese getPlayerName_6fdb98d4:

    # js "He was so happy when my stepbrother got accepted."
    js "我继兄被录取的时候，他高兴坏了。"

# game/script.rpy:343
translate schinese getPlayerName_33dfb4fc:

    # js "And he's not going there to study..."
    js "可他去那儿根本不是去读书的……"

# game/script.rpy:344
translate schinese getPlayerName_7fec0023:

    # js "He's just there for the frat life and parties."
    js "他就是冲着兄弟会和派对去的。"

# game/script.rpy:345
translate schinese getPlayerName_22975334:

    # js "I'm pretty sure that he cheated his way through high school..."
    js "我敢肯定他高中一路都是作弊过来的……"

# game/script.rpy:347
translate schinese getPlayerName_e3f57fdc:

    # js "What about you?"
    js "你呢？"

# game/script.rpy:349
translate schinese getPlayerName_7aef99f5:

    # mc "I guess I'm going for a little bit of both."
    mc "我大概是两者都有吧。"

# game/script.rpy:350
translate schinese getPlayerName_221c1141:

    # mc "I don't really know what I want to be...but science is pretty cool, so I think I'm going for a bachelor's degree."
    mc "我也不太清楚自己想做什么……不过理科挺酷的，所以我打算读个学士学位。"

# game/script.rpy:352
translate schinese getPlayerName_0e812622:

    # js "You think?"
    js "你打算？"

# game/script.rpy:354
translate schinese getPlayerName_27fb7b5e:

    # mc "Well...I haven't really figured it out yet, but I will eventually."
    mc "嗯……我还没完全想好，不过总会想明白的。"

# game/script.rpy:355
translate schinese getPlayerName_dd44407e:

    # mc "In the first couple of years, the classes are more or less the same for most students, with the general education classes and all."
    mc "头两年的课程对大多数学生来说都差不多，都是些通识课之类的。"

# game/script.rpy:356
translate schinese getPlayerName_1c2a7b8b:

    # mc "It probably doesn't matter, though..."
    mc "不过大概也没什么关系……"

# game/script.rpy:357
translate schinese getPlayerName_87de1bb0:

    # mc "With my luck, I'll have to stay at this place until I retire."
    mc "照我这运气，怕是要在这儿干到退休。"

# game/script.rpy:359
translate schinese getPlayerName_c8161ef0:

    # js "That makes two of us, then."
    js "那我们还真是同病相怜。"

# game/script.rpy:360
translate schinese getPlayerName_bd34ec2b:

    # js "Hey..."
    js "嘿……"

# game/script.rpy:361
translate schinese getPlayerName_5e0a8ec9:

    # js "When do you quit work today?"
    js "你今天几点下班？"

# game/script.rpy:363
translate schinese getPlayerName_8da50037:

    # mc "At 4 p.m."
    mc "下午四点。"

# game/script.rpy:365
translate schinese getPlayerName_59a1ffe1:

    # js "Sweet! Me too!"
    js "太好了！我也是！"

# game/script.rpy:366
translate schinese getPlayerName_fd46440c:

    # js "My dad was going to pick me up but he texted me saying he has to work overtime."
    js "我爸本来要来接我，但他发短信说要加班。"

# game/script.rpy:367
translate schinese getPlayerName_b39ade38:

    # js "He has some big client meeting or something..."
    js "好像有个什么大客户会议……"

# game/script.rpy:368
translate schinese getPlayerName_3cfc885c:

    # js "Can you give me a ride home?"
    js "你能载我回家吗？"

# game/script.rpy:370
translate schinese getPlayerName_cb1521c4:

    # mc "Sure...but I ride a bike."
    mc "当然……不过我骑自行车。"

# game/script.rpy:372
translate schinese getPlayerName_b3e6b217:

    # js "Oh, that will be awesome!"
    js "哦，那一定很有意思！"

# game/script.rpy:375
translate schinese getPlayerName_5ceb2de2:

    # js "My break is over."
    js "我休息结束了。"

# game/script.rpy:376
translate schinese getPlayerName_1a8d6579:

    # js "Talk to you later, [name]."
    js "回头聊，[name]。"

# game/script.rpy:380
translate schinese getPlayerName_d4b66480:

    # js "There you are!"
    js "你终于来了！"

# game/script.rpy:381
translate schinese getPlayerName_4f47df58:

    # js "I've been waiting for you."
    js "我一直在等你。"

# game/script.rpy:383
translate schinese getPlayerName_48a9e30b:

    # mc "Sorry for being late."
    mc "抱歉来晚了。"

# game/script.rpy:384
translate schinese getPlayerName_347720cd:

    # mc "Steve forced me to clean the grill."
    mc "Steve 硬逼着我去清洗烤架。"

# game/script.rpy:386
translate schinese getPlayerName_28a20c6a:

    # js "No problemo."
    js "没关系啦。"

# game/script.rpy:387
translate schinese getPlayerName_87b571fc:

    # js "Where's your ride?"
    js "你的坐骑呢？"

# game/script.rpy:389
translate schinese getPlayerName_778a66aa:

    # mc "You're standing next to it."
    mc "你正站在它旁边。"

# game/script.rpy:391
translate schinese getPlayerName_4e824d72:

    # js "Hahaha!"
    js "哈哈哈！"

# game/script.rpy:392
translate schinese getPlayerName_f3b3d28f:

    # mc "What's wrong?"
    mc "怎么了？"

# game/script.rpy:394
translate schinese getPlayerName_515bc071:

    # js "Sorry, [name]!"
    js "抱歉，[name]！"

# game/script.rpy:395
translate schinese getPlayerName_6c520063:

    # js "When you said bike, I thought you meant a motorcycle."
    js "你说 bike 的时候，我还以为是摩托车。"

# game/script.rpy:397
translate schinese getPlayerName_c1dff962_1:

    # mc "Oh..."
    mc "哦……"

# game/script.rpy:398
translate schinese getPlayerName_a31ac9b5:

    # mc "Well, this is what I ride."
    mc "嗯，我骑的就是这个。"

# game/script.rpy:400
translate schinese getPlayerName_f2e0a968:

    # js "Well, hop on and give me a lift, then."
    js "那好吧，上车，载我一程。"

# game/script.rpy:402
translate schinese getPlayerName_13f3c3ef:

    # mc "Are you ready?"
    mc "准备好了吗？"

# game/script.rpy:404
translate schinese getPlayerName_5572ce22:

    # js "Yeah. Don't do a wheelie now."
    js "好了。可别玩什么翘前轮。"

# game/script.rpy:405
translate schinese getPlayerName_0de8430e:

    # mc "Don't worry; I won't."
    mc "放心，我不会的。"

# game/script.rpy:407
translate schinese getPlayerName_53e0f3a6:

    # js "Ok, that was a joke, but sure."
    js "好吧，那是开玩笑的，不过你答应就好。"

# game/script.rpy:412
translate schinese getPlayerName_3920ded3:

    # mc "(The way she's holding her arms around me...)"
    mc "（她双手环着我的样子……）"

# game/script.rpy:413
translate schinese getPlayerName_db729333:

    # mc "(...it feels like the warmest hug.)"
    mc "（……感觉就像最温暖的拥抱。）"

# game/script.rpy:415
translate schinese getPlayerName_93c6110f:

    # mc "(She smells so good.)"
    mc "（她身上的味道真好闻。）"

# game/script.rpy:416
translate schinese getPlayerName_bcfa4b9e:

    # mc "(Just like strawberries.)"
    mc "（就像草莓的味道。）"

# game/script.rpy:417
translate schinese getPlayerName_aa1f7345:

    # mc "Are you comfortable back there?"
    mc "你在后面坐得舒服吗？"

# game/script.rpy:419
translate schinese getPlayerName_b4c24ba2:

    # js "Yes, I'm fine, thanks."
    js "嗯，我很好，谢谢。"

# game/script.rpy:420
translate schinese getPlayerName_5d13013b:

    # js "We can switch if it's too tiresome for you."
    js "你要是太累，我们可以换换。"

# game/script.rpy:422
translate schinese getPlayerName_253ce317:

    # mc "No, I'm good."
    mc "不用，我没事。"

# game/script.rpy:424
translate schinese getPlayerName_b576e6f8:

    # js "I bet you give chicks rides home all the time on this thing."
    js "我猜你经常用这车载女生回家吧。"

# game/script.rpy:426
translate schinese getPlayerName_86d1a940:

    # mc "No, not really."
    mc "不，真没有。"

# game/script.rpy:428
translate schinese getPlayerName_67d80968:

    # js "So, [name]. We haven't really talked much to each other before."
    js "话说回来，[name]。我们之前其实没怎么聊过。"

# game/script.rpy:429
translate schinese getPlayerName_9ee7e2cf:

    # js "Besides work stuff, I mean."
    js "我是说，除了工作上的事。"

# game/script.rpy:431
translate schinese getPlayerName_73877f90:

    # mc "Yeah, I've meant to talk more to you but never found the right opportunity for it."
    mc "嗯，我一直想多跟你聊聊，但总也找不到合适的机会。"

# game/script.rpy:433
translate schinese getPlayerName_9303b7d8:

    # js "What are you saying? We've been working together for almost two months now!"
    js "你在说什么呀？我们一起工作都快两个月了！"

# game/script.rpy:434
translate schinese getPlayerName_999ab630:

    # js "Are you a shy guy or something?"
    js "你该不会是个害羞的人吧？"

# game/script.rpy:436
translate schinese getPlayerName_843a1479:

    # mc "No, not really. But you're always talking to others at work."
    mc "不，不是。可你在上班时总是在跟别人说话。"

# game/script.rpy:437
translate schinese getPlayerName_72f0d021:

    # mc "I don't want to interrupt..."
    mc "我不想打断你们……"

# game/script.rpy:438
translate schinese getPlayerName_5d77479e:

    # mc "...besides, I generally like to listen more than I like to talk."
    mc "……再说，我本来就更喜欢听，不太爱说。"

# game/script.rpy:441
translate schinese getPlayerName_e97c884b:

    # js "Haha, yeah, I tend to talk a lot."
    js "哈哈，是啊，我话是挺多的。"

# game/script.rpy:442
translate schinese getPlayerName_c4ad4c58:

    # js "Some people find it annoying."
    js "有些人觉得我烦。"

# game/script.rpy:446
translate schinese getPlayerName_b8449070:

    # mc "I don't mind it. Talk all you want."
    mc "我不觉得。你想说多少就说多少。"

# game/script.rpy:449
translate schinese getPlayerName_a3449dea:

    # mc "Well, I really like that about you."
    mc "其实我挺喜欢你这一点的。"

# game/script.rpy:450
translate schinese getPlayerName_8e84854e:

    # mc "You're very easy-going; I guess that's why people are drawn to you."
    mc "你很随和，我想这就是为什么大家都愿意亲近你。"

# game/script.rpy:452
translate schinese getPlayerName_806bcfc2:

    # js "(He's really sweet.)"
    js "（他真的很贴心。）"

# game/script.rpy:454
translate schinese getPlayerName_f47fead6:

    # js "Thanks."
    js "谢谢。"

# game/script.rpy:457
translate schinese getPlayerName_e8fedaeb:

    # js "This is me."
    js "我到了。"

# game/script.rpy:458
translate schinese getPlayerName_08b5df7f:

    # mc "Ok."
    mc "好。"

# game/script.rpy:460
translate schinese getPlayerName_345699b4:

    # js "So...thanks for the ride, [name]."
    js "那……谢谢你载我，[name]。"

# game/script.rpy:462
translate schinese getPlayerName_57184c13:

    # mc "You're welcome."
    mc "不客气。"

# game/script.rpy:463
translate schinese getPlayerName_9dcd3bc6:

    # js "..."
    js "……"

# game/script.rpy:464
translate schinese getPlayerName_2b35b6fe:

    # mc "..."
    mc "……"

# game/script.rpy:465
translate schinese getPlayerName_cb70afb1:

    # mc "So..."
    mc "那……"

# game/script.rpy:466
translate schinese getPlayerName_11a4ed79:

    # mc "See you tomorrow?"
    mc "明天见？"

# game/script.rpy:468
translate schinese getPlayerName_6eaf67ee:

    # js "All right..."
    js "好……"

# game/script.rpy:469
translate schinese getPlayerName_2a2dc147:

    # js "Bye."
    js "再见。"

# game/script.rpy:486
translate schinese getPlayerName_45e7ec77:

    # mc "(...)"
    mc "（……）"

# game/script.rpy:487
translate schinese getPlayerName_1ba280d9:

    # mc "(Oh no...)"
    mc "（哦不……）"

# game/script.rpy:488
translate schinese getPlayerName_c98eab26:

    # mc "(Was that a cue for me to kiss her?)"
    mc "（她是在暗示我吻她吗？）"

# game/script.rpy:489
translate schinese getPlayerName_2d15af96:

    # mc "(I'm such a loser!)"
    mc "（我真是太怂了！）"

# game/script.rpy:501
translate schinese getPlayerName_0a5eed14:

    # mc "Dad! I'm home."
    mc "爸！我回来了。"

# game/script.rpy:504
translate schinese getPlayerName_ad76c3bd:

    # dad "Hey, son."
    dad "嘿，儿子。"

# game/script.rpy:505
translate schinese getPlayerName_0997b792:

    # dad "You're home later than usual."
    dad "今天回来得比平时晚。"

# game/script.rpy:507
translate schinese getPlayerName_1e41dbc5:

    # mc "Yeah, I was giving Josy a ride home on my bike."
    mc "嗯，我骑车载 Josy 回家了。"

# game/script.rpy:509
translate schinese getPlayerName_7d7485f3:

    # dad "I didn't realize I raised such a charmer."
    dad "没想到我儿子这么会讨女孩子欢心。"

# game/script.rpy:514
translate schinese getPlayerName_22986ece:

    # mc "Stop it, dad..."
    mc "爸，别说了……"

# game/script.rpy:517
translate schinese getPlayerName_3a7ba2fe:

    # mc "The apple doesn't fall far from the tree."
    mc "有其父必有其子嘛。"

# game/script.rpy:519
translate schinese getPlayerName_8f83dcd1:

    # dad "I'm proud of you, son, and I know your mother would have been, too."
    dad "我为你骄傲，儿子。我知道你妈妈也会的。"

# game/script.rpy:521
translate schinese getPlayerName_ccf6e401:

    # mc "Thanks, dad."
    mc "谢谢爸。"

# game/script.rpy:523
translate schinese getPlayerName_876fda9d:

    # mc "What's this?"
    mc "这是什么？"

# game/script.rpy:524
translate schinese getPlayerName_7865fadd:

    # dad "Open it."
    dad "打开看看。"

# game/script.rpy:526
translate schinese getPlayerName_9b4d9707:

    # mc "Dear [name]...your application was..."
    mc "亲爱的 [name]……你的申请……"

# game/script.rpy:527
translate schinese getPlayerName_59be84c4:

    # mc "...you are hereby accepted..."
    mc "……你已被录取……"

# game/script.rpy:528
translate schinese getPlayerName_9a972e9c:

    # mc "I GOT IN!"
    mc "我被录取了！"

# game/script.rpy:530
translate schinese getPlayerName_a8806f48:

    # dad "You did!?"
    dad "真的吗！？"

# game/script.rpy:531
translate schinese getPlayerName_9823d162:

    # mc "Dad, I got accepted to college!!!"
    mc "爸，我考上大学了！！！"

# game/script.rpy:533
translate schinese getPlayerName_d081fd0b:

    # dad "This calls for a celebration!"
    dad "这可得好好庆祝一下！"

# game/script.rpy:535
translate schinese getPlayerName_04d0857b:

    # dad "My son...a college freshman."
    dad "我儿子……是个大学生了。"

# game/script.rpy:536
translate schinese getPlayerName_f1b958fc:

    # dad "How does that feel?"
    dad "感觉怎么样？"

# game/script.rpy:537
translate schinese getPlayerName_6154af71:

    # mc "It's just unimaginable!"
    mc "简直难以想象！"

# game/script.rpy:539
translate schinese getPlayerName_c47b6ab8:

    # dad "Son, I want you to take the jar from the closet."
    dad "儿子，去把柜子里那个罐子拿来。"

# game/script.rpy:540
translate schinese getPlayerName_02105614:

    # dad "It's yours."
    dad "那是你的了。"

# game/script.rpy:542
translate schinese getPlayerName_23f97926:

    # mc "No, dad. That's not my money."
    mc "不行，爸。那不是我的钱。"

# game/script.rpy:544
translate schinese getPlayerName_b1bf3aca:

    # dad "Stop it! I know that I can't afford to pay for your tuition, but at least let me help you with as much as I can."
    dad "别废话！我知道我付不起你的学费，但至少让我尽我所能帮你一把。"

# game/script.rpy:565
translate schinese getPlayerName_c2fd5f40:

    # "{i}Received {color=#36ca2b}${/color}{/i}"
    "{i}获得 {color=#36ca2b}${/color}{/i}"

# game/script.rpy:566
translate schinese getPlayerName_1143e8c5:

    # mc "Thank you, dad!"
    mc "谢谢你，爸！"

# game/script.rpy:567
translate schinese getPlayerName_83078e78:

    # mc "I love you."
    mc "我爱你。"

# game/script.rpy:570
translate schinese getPlayerName_40024dc4:

    # dad "I love you too, son."
    dad "我也爱你，儿子。"

# game/script.rpy:576
translate schinese getPlayerName_c8eda060:

    # mc "Didn't you get your paycheck today?"
    mc "你今天不是刚发了工资吗？"

# game/script.rpy:578
translate schinese getPlayerName_18bbcd73:

    # dad "Oh, yeah. I did..."
    dad "哦，对，是发了……"

# game/script.rpy:579
translate schinese getPlayerName_2e7c0ef3:

    # dad "I think I can throw in a little bit extra for you."
    dad "我想我还能再给你添一点。"

# game/script.rpy:581
translate schinese getPlayerName_92e11b05:

    # "{i}Received {color=#36ca2b}$${/color}{/i}"
    "{i}获得 {color=#36ca2b}$${/color}{/i}"

# game/script.rpy:583
translate schinese getPlayerName_7c5ed869:

    # dad "I love you, son."
    dad "我爱你，儿子。"

# game/script.rpy:590
translate schinese getPlayerName_cec6ead5:

    # mc "I'm sorry, dad, but no."
    mc "抱歉，爸，这不行。"

# game/script.rpy:592
translate schinese getPlayerName_edec6567:

    # mc "I can't accept this. I'll take a student loan and will find a way to earn some extra pocket money."
    mc "我不能收。我可以申请助学贷款，再想办法挣点零花钱。"

# game/script.rpy:594
translate schinese getPlayerName_7c5ed869_1:

    # dad "I love you, son."
    dad "我爱你，儿子。"

# game/script.rpy:595
translate schinese getPlayerName_d144ef60:

    # dad "You make me so proud."
    dad "你让我太骄傲了。"

# game/script.rpy:597
translate schinese getPlayerName_0d36ecf7:

    # mc "I love you too, dad."
    mc "我也爱你，爸。"

# game/script.rpy:599
translate schinese getPlayerName_6389edc4:

    # mc "It will feel great to tell my boss I'm quitting tomorrow."
    mc "明天去跟老板说辞职，那感觉一定很爽。"

# game/script.rpy:601
translate schinese getPlayerName_28653d4a:

    # dad "I bet he will miss having you as an employee, son."
    dad "我敢说他肯定会舍不得你这个员工，儿子。"

# game/script.rpy:606
translate schinese getPlayerName_53ff31d9:

    # bs "Great! That saves me the trouble of firing you."
    bs "太好了！省得我麻烦开除你。"

# game/script.rpy:608
translate schinese getPlayerName_c1dff962_2:

    # mc "Oh..."
    mc "哦……"

# game/script.rpy:611
translate schinese getPlayerName_43953815:

    # bs "College, huh?"
    bs "上大学，是吧？"

# game/script.rpy:613
translate schinese getPlayerName_244ecf75:

    # mc "Yeah, I start on Monday."
    mc "嗯，周一开学。"

# game/script.rpy:615
translate schinese getPlayerName_eb6bff4d:

    # bs "What!? Already? You're supposed to give me two weeks' notice."
    bs "什么！？这么快？你该提前两周通知我的。"

# game/script.rpy:617
translate schinese getPlayerName_7930a61f:

    # mc "Yeah...I know. But I didn't think I would be accepted and I got the letter of acceptance yesterday."
    mc "嗯……我知道。但我没想到会被录取，录取通知书昨天才到。"

# game/script.rpy:619
translate schinese getPlayerName_242578b4:

    # bs "Mhm..."
    bs "嗯哼……"

# game/script.rpy:621
translate schinese getPlayerName_b653283f:

    # mc "So, what about my pay slip?"
    mc "那我的工资单呢？"

# game/script.rpy:623
translate schinese getPlayerName_cb639490:

    # bs "Well, the way I see it..."
    bs "嗯，在我看来……"

# game/script.rpy:624
translate schinese getPlayerName_b55e1688:

    # bs "I think it's only fair that you get less than agreed upon."
    bs "我觉得少给你一些才公平。"

# game/script.rpy:629
translate schinese getPlayerName_48a4d940:

    # mc "That's not fair at all. I'm pretty sure it's illegal, too."
    mc "这一点都不公平。而且我很确定这是违法的。"

# game/script.rpy:632
translate schinese getPlayerName_aec60476:

    # bs "Vandalizing company property is also illegal, buddy. I saw what you did to Steve's photo on the security cam."
    bs "破坏公司财物也是违法的，小子。我在监控里看到你对 Steve 的照片做了什么。"

# game/script.rpy:633
translate schinese getPlayerName_4e3e26a5:

    # bs "You know what? I changed my mind. I'm keeping your pay as compensation for the damages."
    bs "这么着吧，我改主意了——我要扣下你的工资，作为损失赔偿。"

# game/script.rpy:635
translate schinese getPlayerName_36e70e92:

    # bs "Fine, I'll meet you halfway. That's me being generous, ok?"
    bs "行吧，我各让一步。我已经很大方了，明白吗？"

# game/script.rpy:638
translate schinese getPlayerName_92e11b05_1:

    # "{i}Received {color=#36ca2b}$${/color}{/i}"
    "{i}获得 {color=#36ca2b}$${/color}{/i}"

# game/script.rpy:643
translate schinese getPlayerName_9b7e4516:

    # mc "Ok, that's fair."
    mc "好吧，这样才算公平。"

# game/script.rpy:646
translate schinese getPlayerName_c2fd5f40_1:

    # "{i}Received {color=#36ca2b}${/color}{/i}"
    "{i}获得 {color=#36ca2b}${/color}{/i}"

# game/script.rpy:647
translate schinese getPlayerName_bc074eb0:

    # bs "That's only because I'm generous. Make sure you remember that."
    bs "那只是因为我大方。你最好记清楚。"

# game/script.rpy:650
translate schinese getPlayerName_816ba2da:

    # bs "Wash your clothes and return them to me by the end of the week."
    bs "把你那身工作服洗干净，周末之前还给我。"

# game/script.rpy:654
translate schinese getPlayerName_b29efc09:

    # mc "Hi, Josy."
    mc "嗨，Josy。"

# game/script.rpy:655
translate schinese getPlayerName_564b48ea:

    # js "Hey, [name]!"
    js "嘿，[name]！"

# game/script.rpy:656
translate schinese getPlayerName_5b81da88:

    # js "Everything good?"
    js "一切都好吗？"

# game/script.rpy:658
translate schinese getPlayerName_f4c42c11:

    # mc "It's better than good, actually."
    mc "说实话，比好还要好。"

# game/script.rpy:659
translate schinese getPlayerName_de2ef585:

    # mc "I got my letter of acceptance yesterday!"
    mc "我昨天拿到录取通知书了！"

# game/script.rpy:661
translate schinese getPlayerName_a649062e:

    # js "You did!? Wow, that's awesome!"
    js "真的吗！？哇，太棒了！"

# game/script.rpy:663
translate schinese getPlayerName_c1bce3ed:

    # js "Congratulations!!!"
    js "恭喜你！！！"

# game/script.rpy:664
translate schinese getPlayerName_072118a4:

    # js "I'm so jealous!"
    js "我太羡慕了！"

# game/script.rpy:666
translate schinese getPlayerName_eec142cd:

    # js "So, you're leaving me here, huh?"
    js "这么说，你要把我一个人扔在这儿了？"

# game/script.rpy:670
translate schinese getPlayerName_d5067749:

    # mc "Yeah... I'm sorry for that..."
    mc "嗯……对此我很抱歉……"

# game/script.rpy:672
translate schinese getPlayerName_ba08071a:

    # js "Hey, don't feel sorry for me."
    js "嘿，别为我难过。"

# game/script.rpy:673
translate schinese getPlayerName_aa5d2013:

    # js "I only need 13 people to decline, and I'm golden."
    js "只要有 13 个人放弃，我就稳了。"

# game/script.rpy:675
translate schinese getPlayerName_f4e64c66:

    # mc "Haha! I'm glad that you're staying positive."
    mc "哈哈！真高兴你还能这么乐观。"

# game/script.rpy:678
translate schinese getPlayerName_4f4348c6:

    # mc "I can stay if you want..."
    mc "如果你希望，我可以留下来……"

# game/script.rpy:680
translate schinese getPlayerName_de81a216:

    # js "Are you crazy? You got in!"
    js "你疯了吗？你可是考上了！"

# game/script.rpy:681
translate schinese getPlayerName_aca466b1:

    # js "Go chase your dream!"
    js "去追逐你的梦想吧！"

# game/script.rpy:683
translate schinese getPlayerName_f422f5ed:

    # js "But I will miss you."
    js "但我会想你的。"

# game/script.rpy:686
translate schinese getPlayerName_3cbd7601:

    # "*{i}Smack{/i}*"
    "*{i}吧唧{/i}*"

# game/script.rpy:688
translate schinese getPlayerName_b3ccf8b1:

    # mc "I'll come back and visit once in a while, you know."
    mc "我会时不时回来看看你的，你知道的。"

# game/script.rpy:689
translate schinese getPlayerName_6e77642f:

    # mc "I mean, it's not far from here, and my dad still lives here."
    mc "我是说，这儿离得又不远，我爸也还住在这儿。"

# game/script.rpy:691
translate schinese getPlayerName_37425025:

    # js "I'd love that..."
    js "那我可太开心了……"

# game/script.rpy:692
translate schinese getPlayerName_9547f5bd:

    # js "When are you leaving?"
    js "你什么时候走？"

# game/script.rpy:694
translate schinese getPlayerName_6a9fe320:

    # mc "I start on Monday."
    mc "周一开学。"

# game/script.rpy:696
translate schinese getPlayerName_665b89b4:

    # js "No way! This Monday?"
    js "不会吧！就这周一？"

# game/script.rpy:698
translate schinese getPlayerName_0978f2cc:

    # mc "Yeah, afraid so."
    mc "嗯，恐怕是的。"

# game/script.rpy:700
translate schinese getPlayerName_79831822:

    # js "Hey, I know!"
    js "嘿，我有主意了！"

# game/script.rpy:701
translate schinese getPlayerName_d371412c:

    # js "We should do something fun this weekend!"
    js "这周末我们应该做点好玩的事！"

# game/script.rpy:702
translate schinese getPlayerName_ef012e1e:

    # js "You know, to celebrate!"
    js "就当是庆祝一下！"

# game/script.rpy:704
translate schinese getPlayerName_0bd97183:

    # mc "Well, all right. What do you have in mind?"
    mc "嗯，好啊。你有什么打算？"

# game/script.rpy:706
translate schinese getPlayerName_d6da1eed:

    # js "Pick me up tomorrow night on that {i}sweet ride{/i} of yours, and I'll show you!"
    js "明天晚上骑你那辆{i}帅气的坐骑{/i}来接我，到时候你就知道了！"

# game/script.rpy:710
translate schinese getPlayerName_98d788d6:

    # mc "Ok. I will."
    mc "好，我会的。"

# game/script.rpy:713
translate schinese getPlayerName_97503a94:

    # mc "It's a date!"
    mc "就这么说定了！"

# game/script.rpy:715
translate schinese getPlayerName_9c62fe59:

    # js "Haha..."
    js "哈哈……"

# game/script.rpy:718
translate schinese getPlayerName_368337ea:

    # st "Back to work, Josy."
    st "回去干活，Josy。"

# game/script.rpy:722
translate schinese getPlayerName_8b1dc9ad:

    # st "So, you think you're pretty funny, huh?"
    st "怎么，你觉得自己很幽默是吧？"

# game/script.rpy:727
translate schinese getPlayerName_a44647c3:

    # mc "I've been known to tell a joke or two."
    mc "我向来是能讲上一两个笑话的。"

# game/script.rpy:728
translate schinese getPlayerName_309a3fc9:

    # mc "Knock knock."
    mc "咚咚咚。"

# game/script.rpy:730
translate schinese getPlayerName_6f646cd4:

    # st "Fuck you!"
    st "去你的！"

# game/script.rpy:732
translate schinese getPlayerName_3eeabe60:

    # mc "You're supposed to say \"Who's there?\", Steve. Didn't your imaginary friends teach you that one?"
    mc "你应该说「谁呀？」，Steve。你那些想象中的朋友没教过你吗？"

# game/script.rpy:735
translate schinese getPlayerName_b2b9e19d:

    # mc "What do you mean?"
    mc "你什么意思？"

# game/script.rpy:738
translate schinese getPlayerName_c6ffd957:

    # st "Drawing dicks on my face is not funny, you asshole!"
    st "在我脸上画鸡巴一点都不好笑，你这混蛋！"

# game/script.rpy:740
translate schinese getPlayerName_afb7de86:

    # mc "I strongly disagree."
    mc "我强烈反对。"

# game/script.rpy:743
translate schinese getPlayerName_ce9bcc3e:

    # st "Why the fuck did you draw on my picture!?"
    st "你他妈为什么在我的照片上乱画！？"

# game/script.rpy:744
translate schinese getPlayerName_66737a5c:

    # st "I earned that award!"
    st "那个奖是我挣来的！"

# game/script.rpy:746
translate schinese getPlayerName_b83822fb:

    # st "Dad just told me that you're quitting."
    st "我爸刚跟我说你要辞职了。"

# game/script.rpy:747
translate schinese getPlayerName_ba6805fa:

    # st "Thank fuck for that. I knew this job was too hard for you."
    st "谢天谢地。我知道这活儿对你来说太难了。"

# game/script.rpy:749
translate schinese getPlayerName_8472f0d7:

    # mc "Not really. I can't work here and go to B&R."
    mc "那倒不是。我不能一边在这儿打工一边上 B&R。"

# game/script.rpy:752
translate schinese getPlayerName_b83822fb_1:

    # st "Dad just told me that you're quitting."
    st "我爸刚跟我说你要辞职了。"

# game/script.rpy:753
translate schinese getPlayerName_5d1c4846:

    # st "That was the best news I've heard in a long time."
    st "这是我这阵子听到的最好的消息。"

# game/script.rpy:755
translate schinese getPlayerName_35a63980:

    # mc "Well, I can't work here and go to B&R."
    mc "嗯，我不能一边在这儿打工一边上 B&R。"

# game/script.rpy:757
translate schinese getPlayerName_5836de2e:

    # st "*{i}Snorts{/i}* B&R, the poor man's college."
    st "*{i}嗤笑{/i}* B&R，穷人的大学。"

# game/script.rpy:759
translate schinese getPlayerName_64d1aa9e:

    # mc "What are you talking about? It's not a bad college."
    mc "你在说什么？那所学校又不差。"

# game/script.rpy:761
translate schinese getPlayerName_43c01b04:

    # st "Aside from that preppy, silver spoon in their asses frat house..."
    st "除了那帮含着金汤匙出生的预科生兄弟会……"

# game/script.rpy:762
translate schinese getPlayerName_2391d4a2:

    # st "...yeah, people who go there are trash."
    st "……是啊，去那儿念书的人都是垃圾。"

# game/script.rpy:767
translate schinese getPlayerName_5f92b626:

    # mc "You're one to talk!"
    mc "你有什么资格说这个！"

# game/script.rpy:768
translate schinese getPlayerName_87508128:

    # mc "If it wasn't for your dad, you and your 50's haircut would be picking up litter in the park for a living."
    mc "要不是靠你爸，就凭你那五十年代的老土发型，你早该在公园里捡垃圾为生了。"

# game/script.rpy:770
translate schinese getPlayerName_1934708f:

    # st "Watch your mouth!"
    st "说话给我注意点！"

# game/script.rpy:772
translate schinese getPlayerName_e209d4a6:

    # mc "Or what? Will you have your dad fire me?"
    mc "不然怎样？让你爸开除我吗？"

# game/script.rpy:773
translate schinese getPlayerName_af9e6bf9:

    # mc "Oh, wait... That's right, I already quit."
    mc "哦，等等……对了，我已经辞职了。"

# game/script.rpy:775
translate schinese getPlayerName_f887df3c:

    # st "I'll be the owner of this place one day, you know!"
    st "总有一天这地方会是我的，你给我记住！"

# game/script.rpy:777
translate schinese getPlayerName_fa871d00:

    # st "Remember that when you come crawling back."
    st "等你回来求我的时候，可别忘了这话。"

# game/script.rpy:779
translate schinese getPlayerName_b0207965:

    # mc "Good luck with the family business, Steve. Call me when you do something without daddy's help."
    mc "祝你家生意兴隆，Steve。等你哪天不靠你爸做成点什么，再来找我。"

# game/script.rpy:782
translate schinese getPlayerName_1c52f67c:

    # mc "Whatever, Steve. Enjoy working here."
    mc "随便你吧，Steve。好好在这儿干。"

# game/script.rpy:785
translate schinese getPlayerName_f887df3c_1:

    # st "I'll be the owner of this place one day, you know!"
    st "总有一天这地方会是我的，你给我记住！"

# game/script.rpy:786
translate schinese getPlayerName_fa871d00_1:

    # st "Remember that when you come crawling back."
    st "等你回来求我的时候，可别忘了这话。"

# game/script.rpy:799
translate schinese getPlayerName_2755c1ff:

    # dad "Great! Don't stop now!"
    dad "很好！别停下来！"

# game/script.rpy:800
translate schinese getPlayerName_1011f06c:

    # dad "High kick!"
    dad "高踢！"

# game/script.rpy:804
translate schinese getPlayerName_ab63d2c1:

    # dad "Perfect!"
    dad "完美！"

# game/script.rpy:806
translate schinese getPlayerName_e44e9a1f:

    # dad "Flurry!"
    dad "连击！"

# game/script.rpy:818
translate schinese getPlayerName_cf0f0378:

    # dad "Great, son! That will do for today."
    dad "好样的，儿子！今天就练到这儿吧。"

# game/script.rpy:820
translate schinese getPlayerName_35b98e56:

    # dad "So, how did it go with your boss?"
    dad "那么，你跟老板谈得怎么样？"

# game/script.rpy:823
translate schinese getPlayerName_5db3a55d:

    # mc "It went ok. It could've gone better, but I'm done with that place now."
    mc "还行。本来可以更好，不过我跟那儿已经没关系了。"

# game/script.rpy:825
translate schinese getPlayerName_7b902b17:

    # dad "The next step in your life is a big one, son."
    dad "儿子，你人生的下一步可是一大步。"

# game/script.rpy:826
translate schinese getPlayerName_a62d2006:

    # dad "As I never went to college, I can't imagine how exciting this must feel for you."
    dad "我从没上过大学，想象不出这对你来说有多让人激动。"

# game/script.rpy:828
translate schinese getPlayerName_69c25b65:

    # mc "Yeah..."
    mc "嗯……"

# game/script.rpy:829
translate schinese getPlayerName_0c7cc9ee:

    # dad "Something the matter?"
    dad "有什么心事？"

# game/script.rpy:831
translate schinese getPlayerName_b6f87a32:

    # mc "Well, there's this girl...Josy."
    mc "嗯，有个女孩……Josy。"

# game/script.rpy:832
translate schinese getPlayerName_f183123f:

    # mc "I have a crush on her, and now I'm moving away from here."
    mc "我喜欢上她了，可现在我就要离开这儿。"

# game/script.rpy:833
translate schinese getPlayerName_415425f6:

    # mc "I feel pretty bad about it."
    mc "我心里挺难受的。"

# game/script.rpy:835
translate schinese getPlayerName_8573bb12:

    # dad "Uh-huh. I see."
    dad "嗯哼。我明白了。"

# game/script.rpy:836
translate schinese getPlayerName_c97685f3:

    # dad "Let me tell you something I've learned."
    dad "让我跟你说一件我学到的事。"

# game/script.rpy:838
translate schinese getPlayerName_3967a274:

    # dad "As you know, I already worked in construction when I met your mom."
    dad "你知道，我遇到你妈的时候就已经在建筑工地上干活了。"

# game/script.rpy:839
translate schinese getPlayerName_827f19b1:

    # dad "Her dad, who was filthy rich, hired me to help him build a hotel."
    dad "她爸富得流油，雇我帮他建一家酒店。"

# game/script.rpy:841
translate schinese getPlayerName_364cd799:

    # dad "Your mom was a very beautiful woman. I was 24, and she had just turned 18."
    dad "你妈是个非常美丽的女人。我当时 24 岁，她刚满 18 岁。"

# game/script.rpy:842
translate schinese getPlayerName_59919285:

    # dad "Her dad disapproved of me being with his daughter. In his eyes, I was of a lower class."
    dad "她爸反对我和他女儿在一起。在他眼里，我是下等人。"

# game/script.rpy:844
translate schinese getPlayerName_0927c2d8:

    # dad "Your mother didn't see it that way. She looked past all that, and we fell in love."
    dad "你妈却不这么看。她不在乎这些，我们相爱了。"

# game/script.rpy:846
translate schinese getPlayerName_a8fd3fe5:

    # dad "To her father's dismay, he couldn't get her to stop seeing me."
    dad "令她父亲沮丧的是，他没法让她不再见我。"

# game/script.rpy:847
translate schinese getPlayerName_c35e9799:

    # dad "But he knew that once the hotel was built, there was no reason for me to stay and work in that town."
    dad "但他知道，等酒店一建成，我就没有理由继续留在那个镇上干活了。"

# game/script.rpy:849
translate schinese getPlayerName_7930b37d:

    # dad "And when that day came, I left. I had to make a living after all."
    dad "那一天到来时，我离开了。毕竟我得谋生。"

# game/script.rpy:850
translate schinese getPlayerName_c4cedde4:

    # dad "So, with a heavy heart, I left Lynette."
    dad "于是，我怀着沉重的心情离开了 Lynette。"

# game/script.rpy:852
translate schinese getPlayerName_8424caaf:

    # dad "But before doing so, I gave her the best kiss I ever could have given her."
    dad "但在离开之前，我给了她我这辈子最用心的一个吻。"

# game/script.rpy:854
translate schinese getPlayerName_72735295:

    # dad "To me...that was it."
    dad "对我来说……那就是终点。"

# game/script.rpy:855
translate schinese getPlayerName_d0ebbc53:

    # dad "The last time I would ever gaze upon her."
    dad "我以为那是最后一次凝视她。"

# game/script.rpy:857
translate schinese getPlayerName_247b8c56:

    # dad "But your mom, stubborn as a mule, didn't give up that easily."
    dad "可你妈犟得像头驴，没那么容易放弃。"

# game/script.rpy:859
translate schinese getPlayerName_501590a8:

    # dad "It took her three days to run away from home and track me down."
    dad "她花了三天离家出走，一路找到了我。"

# game/script.rpy:860
translate schinese getPlayerName_8accb8f4:

    # dad "No...wait...five days?"
    dad "不……等等……五天？"

# game/script.rpy:861
translate schinese getPlayerName_64a6c338:

    # dad "Hm...maybe it was something along the lines of a week?"
    dad "嗯……也许差不多有一个星期？"

# game/script.rpy:862
translate schinese getPlayerName_071acfbc:

    # mc "Are you seriously asking {b}me{/b} that?"
    mc "你当真在问{b}我{/b}这个？"

# game/script.rpy:863
translate schinese getPlayerName_fb2f178c:

    # dad "No, well, it was something like that."
    dad "不，呃，差不多就是那样。"

# game/script.rpy:864
translate schinese getPlayerName_1efba245:

    # dad "Either way...where was I?"
    dad "不管怎样……我说到哪儿了？"

# game/script.rpy:865
translate schinese getPlayerName_90bfebc7:

    # dad "Oh yeah!"
    dad "哦对了！"

# game/script.rpy:866
translate schinese getPlayerName_82352898:

    # dad "She didn't want her dad's life or his money..."
    dad "她不想要她爸给的生活，也不要他的钱……"

# game/script.rpy:867
translate schinese getPlayerName_ebd3e117:

    # dad "She wanted me."
    dad "她要的是我。"

# game/script.rpy:869
translate schinese getPlayerName_6000ff0b:

    # dad "If something's meant to be, it will happen, son."
    dad "儿子，如果一件事命中注定，它就一定会发生。"

# game/script.rpy:870
translate schinese getPlayerName_16ced9d7:

    # dad "But make sure that you give it your best try and that you leave without regrets."
    dad "但你要确保自己尽了最大的努力，走的时候不留遗憾。"

# game/script.rpy:871
translate schinese getPlayerName_50414ad4:

    # dad "Because regrets can come back to haunt you later in life."
    dad "因为遗憾会在往后的日子里回来纠缠你。"

# game/script.rpy:873
translate schinese getPlayerName_2e327224:

    # mc "I regret never meeting mom."
    mc "我很遗憾从没见过妈妈。"

# game/script.rpy:875
translate schinese getPlayerName_efcbd30f:

    # dad "Hey now, you can't regret things out of your control."
    dad "嘿，你不能为那些你无法控制的事后悔。"

# game/script.rpy:876
translate schinese getPlayerName_053f627d:

    # dad "And you did meet her briefly before she passed away."
    dad "而且她去世前，你确实短暂地见过她。"

# game/script.rpy:878
translate schinese getPlayerName_82751599:

    # dad "She said \"He's so beautiful\". Those were her exact words about you."
    dad "她说「他真漂亮」。这是她对你的原话。"

# game/script.rpy:880
translate schinese getPlayerName_82b4616d:

    # dad "Tell Josy how you feel, son. That's my advice."
    dad "儿子，把你的心意告诉 Josy。这是我的建议。"

# game/script.rpy:881
translate schinese getPlayerName_d7237954:

    # dad "Don't keep your emotions locked up."
    dad "别把自己的感情闷在心里。"

# game/script.rpy:891
